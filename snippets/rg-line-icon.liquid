{%- comment -%}
  RAW GRAVITY · cyan outline icons (96 x 96 grid) from the product page design.
  Color follows currentColor.

  Accepts:
  - name {String}: focus | stress | resilience | immune | gmp | lab | metals | batch
  - size {Number}: rendered width/height in px (default 34)

  Usage:
  {% render 'rg-line-icon', name: 'focus', size: 34 %}
{%- endcomment -%}
{%- assign icon_size = size | default: 34 -%}
<svg
  class="rg-line-icon"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 96 96"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'focus' -%}
      <path d="M49 10 A38 38 0 0 0 10.7 40.5 C24 31.5 39 31 55.5 42"/>
      <path d="M49 10 A38 38 0 0 0 10.7 40.5 C24 31.5 39 31 55.5 42" transform="rotate(90 48 48)"/>
      <path d="M49 10 A38 38 0 0 0 10.7 40.5 C24 31.5 39 31 55.5 42" transform="rotate(180 48 48)"/>
      <path d="M49 10 A38 38 0 0 0 10.7 40.5 C24 31.5 39 31 55.5 42" transform="rotate(270 48 48)"/>
      <circle cx="48" cy="48" r="3.4" fill="currentColor" stroke="none"/>
    {%- when 'stress' -%}
      <path d="M12 28 C25 19 35 19 48 27 S71 35 84 27"/>
      <path d="M12 48 H84"/>
      <path d="M12 69 C25 60 35 60 48 68 S71 76 84 68"/>
      <circle cx="12" cy="28" r="3.1" fill="currentColor" stroke="none"/>
      <circle cx="84" cy="27" r="3.1" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="48" r="3.1" fill="currentColor" stroke="none"/>
      <circle cx="84" cy="48" r="3.1" fill="currentColor" stroke="none"/>
      <circle cx="12" cy="69" r="3.1" fill="currentColor" stroke="none"/>
      <circle cx="84" cy="68" r="3.1" fill="currentColor" stroke="none"/>
    {%- when 'resilience' -%}
      <path d="M57.317 13.227 A36 36 0 1 0 80.627 32.786"/>
      <path d="M75.978 22.816 L86.337 30.123 L74.917 35.448 Z"/>
      <path d="M27 59 C39 63 45 53 52 46 S66 36 72 38"/>
    {%- when 'immune' -%}
      <path d="M48 10 C57 17 66 21 78 23 V45 C78 64 64 77 48 86 C32 77 18 64 18 45 V23 C30 21 39 17 48 10 Z"/>
      <path d="M48 34 V59 M35.5 46.5 H60.5"/>
    {%- when 'gmp' -%}
      <path d="M17 12 V84 M17 18 H82 V62 H17 M17 18 H45 V42 H17"/>
      <path d="M45 27 H82 M45 36 H82 M17 45 H82 M17 54 H82"/>
      <circle cx="25" cy="26" r="1.45" fill="currentColor" stroke="none"/>
      <circle cx="36" cy="26" r="1.45" fill="currentColor" stroke="none"/>
      <circle cx="25" cy="35" r="1.45" fill="currentColor" stroke="none"/>
      <circle cx="36" cy="35" r="1.45" fill="currentColor" stroke="none"/>
    {%- when 'lab' -%}
      <path d="M34 12 H62 M39 12 V37 L18.5 73.5 Q14 83 25 83 H71 Q82 83 77.5 73.5 L57 37 V12"/>
      <path d="M34 61 L44 71 L63 50"/>
    {%- when 'metals' -%}
      <path d="M16 16 H49 L83 50 L49 84 L16 51 Z"/>
      <circle cx="29" cy="29" r="4"/>
      <path d="M35 52 L45 62 L65 42"/>
    {%- when 'batch' -%}
      <path d="M27 11 H60 L77 28 V78 Q77 84 71 84 H27 Q21 84 21 78 V17 Q21 11 27 11 Z M60 11 V28 H77"/>
      <path d="M38 39 H62 M38 50 H54 M35 66 L44 75 L64 55"/>
      <circle cx="30" cy="39" r="1.8" fill="currentColor" stroke="none"/>
      <circle cx="30" cy="50" r="1.8" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
