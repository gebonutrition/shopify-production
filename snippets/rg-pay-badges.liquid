{%- doc -%}
  RAW GRAVITY · payment badges as drawn in the Claude Design references
  (Visa, Mastercard, PayPal, Shop Pay, Apple Pay, Google Pay). Styles: assets/rg-base.css.

  @param {string} [modifier] - Extra class on the list, e.g. 'rg-pay--fill' or 'rg-pay--wrap'.
{%- enddoc -%}
<ul class="rg-pay {{ modifier }}" role="list" aria-label="Payment methods">
  <li class="rg-pay__item"><span class="rg-pay__visa">VISA</span></li>
  <li class="rg-pay__item">
    <span class="rg-pay__mc" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="rg-visually-hidden">Mastercard</span>
  </li>
  <li class="rg-pay__item"><span class="rg-pay__paypal"><span>Pay</span><span>Pal</span></span></li>
  <li class="rg-pay__item rg-pay__item--shop"><span class="rg-pay__shop">shop<span>Pay</span></span></li>
  <li class="rg-pay__item rg-pay__item--apple">
    <svg class="rg-pay__apple" viewBox="0 0 17 20" aria-hidden="true"><path fill="#fff" d="M14.1 10.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.5 0 2 .8 3.3.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1-2.8-4.2zM11.6 3.2c.7-.8 1.2-2 1-3.2-1 0-2.3.7-3 1.5-.7.7-1.2 1.9-1.1 3.1 1.2.1 2.3-.6 3.1-1.4z"/></svg>
    <span class="rg-visually-hidden">Apple</span><span class="rg-pay__word rg-pay__word--light">Pay</span>
  </li>
  <li class="rg-pay__item">
    <span class="rg-pay__g">G</span><span class="rg-visually-hidden">oogle</span><span class="rg-pay__word">Pay</span>
  </li>
</ul>
