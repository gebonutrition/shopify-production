{%- comment -%}
  RAW GRAVITY line icons (stroke uses currentColor).

  Accepts:
  - name {string}: heart | leaf | star | shield | target | check | zap | flask | spark | dollar | gift
  - size {number}: optional, pixel size (default 24)
  - stroke {number}: optional, stroke width (default 2)
  - class {string}: optional, extra class names

  Usage:
  {% render 'rg-icon', name: 'leaf', size: 20 %}
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 24
  assign icon_stroke = stroke | default: 2
  case name
    when 'heart'
      assign d = 'M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.5 12 21 12 21z'
    when 'leaf'
      assign d = 'M5 19c0-8 6-14 15-14 0 9-6 15-14 15M5 19l7-7'
    when 'star'
      assign d = 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z'
    when 'shield'
      assign d = 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'
    when 'target'
      assign d = 'M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z'
    when 'check'
      assign d = 'M5 12l5 5 9-10'
    when 'zap'
      assign d = 'M13 2L4 14h7l-1 8 9-12h-7z'
    when 'flask'
      assign d = 'M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3'
    when 'spark'
      assign d = 'M12 2l2 8 8 2-8 2-2 8-2-8-8-2 8-2z'
    when 'dollar'
      assign d = 'M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'
    when 'gift'
      assign d = 'M3 9h18v4H3zM5 13v8h14v-8M12 9v12M12 9c-2-4-6-4-6-1.5S9 9 12 9c3 0 6 0 6-1.5S14 5 12 9'
    else
      assign d = ''
  endcase
-%}
{%- if d != blank -%}
  <svg
    class="rg-icon{% if class != blank %} {{ class }}{% endif %}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="{{ icon_stroke }}"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="{{ d }}"/>
  </svg>
{%- endif -%}
