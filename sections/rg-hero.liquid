{%- comment -%}
  RAW GRAVITY · Hero (main landing, first screen), dark v2.
  Desktop: copy on the left (42%), product photo on the right (58%), one screen tall.
  Mobile: rating, heading, photo strip, copy, button.
  The photo is one <img>: on desktop it moves to the right column (grid row span).
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#top (2026-11 update).
  Copy block (2026-11-18, client screenshot "The last coffee you'll switch to"): on desktop the copy is centred
  vertically and every size is a ratio of the heading size (--rg-hero-h), measured on the screenshot;
  flat button, guarantee + shipping row. Line breaks typed in Heading are kept.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign button_link = s.button_link | default: routes.all_products_collection_url
  assign image_alt = s.image.alt | default: s.heading | newline_to_br | replace: '<br />', ' ' | strip_newlines | escape

  assign heading = s.heading | escape | newline_to_br
  if s.heading_nowrap != blank
    assign nowrap = s.heading_nowrap | escape
    assign nowrap_span = '<span class="rg-hero__nowrap">' | append: nowrap | append: '</span>'
    assign heading = heading | replace: nowrap, nowrap_span
  endif
-%}

<section
  class="rg rg-z rg-hero"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <span class="rg-hero__glow" aria-hidden="true"></span>
  <div class="rg-hero__inner">
    {%- if s.rating_value != blank or s.rating_text != blank -%}
      <p class="rg-hero__rating rg-hero__rise">
        <span class="rg-hero__stars" aria-hidden="true">★★★★★</span>
        <span>
          {%- if s.rating_value != blank -%}<b>{{ s.rating_value | escape }}</b>{%- endif -%}
          {%- if s.rating_text != blank %}<span class="rg-hero__rating-text"> {{ s.rating_text | escape }}</span>{%- endif -%}
        </span>
      </p>
    {%- endif -%}

    <h1 class="rg-hero__title rg-hero__rise">{{ heading }}</h1>

    <div class="rg-hero__media">
      <span class="rg-hero__media-glow" aria-hidden="true"></span>
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 990px) 62vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt,
            class: 'rg-hero__image'
        }}
      {%- endif -%}
    </div>

    <div class="rg-hero__copy">
      {%- if s.lead != blank -%}
        <p class="rg-hero__lead rg-hero__rise">{{ s.lead | escape }}</p>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="rg-hero__text rg-hero__rise">{{ s.text | escape }}</p>
      {%- endif -%}
      {%- if s.tagline != blank -%}
        <p class="rg-hero__tagline rg-hero__rise">
          {%- if s.tagline_line -%}
            <span class="rg-hero__tagline-line" aria-hidden="true"></span>
          {%- endif -%}
          {{- s.tagline | escape -}}
        </p>
      {%- endif -%}
    </div>

    <div class="rg-hero__actions rg-hero__rise">
      {%- if s.button_label != blank -%}
        <a class="rg-hero__button" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
      {%- if s.note_title != blank or s.note_text != blank or s.note_text_2 != blank -%}
        <div class="rg-hero__note">
          {%- if s.note_title != blank -%}
            <p class="rg-hero__note-title">{{ s.note_title | escape }}</p>
          {%- endif -%}
          {%- if s.note_text != blank or s.note_text_2 != blank -%}
            <ul class="rg-hero__note-list" role="list">
              {%- if s.note_text != blank -%}
                <li class="rg-hero__note-text">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg>
                  {{- s.note_text | escape -}}
                </li>
              {%- endif -%}
              {%- if s.note_text_2 != blank -%}
                <li class="rg-hero__note-text">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                  {{- s.note_text_2 | escape -}}
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile, section#top) ---------- */
  .rg-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 40% at 0% 0%, rgba(38, 70, 79, 0.75) 0%, rgba(38, 70, 79, 0) 100%), #121213;
    color: var(--rg-on-dark);
  }

  .rg-hero p {
    margin: 0;
  }

  .rg-hero__glow {
    display: none;
  }

  .rg-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 20px 24px;
  }

  .rg-hero__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 12px/1 var(--rg-font-body);
    white-space: nowrap;
  }

  .rg-hero__stars {
    letter-spacing: 0.08em;
    color: #ff8a1f;
  }

  .rg-hero__rating b {
    font-weight: 700;
  }

  .rg-hero .rg-hero__title {
    margin: 0;
    font: 900 clamp(26px, 3.5svh, 32px) / 0.96 var(--rg-font-body);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-hero__nowrap {
    white-space: nowrap;
  }

  .rg-hero__media {
    position: relative;
    height: clamp(200px, 28svh, 260px);
    margin: -4px -20px;
    overflow: hidden;
    pointer-events: none;
  }

  .rg-hero__media-glow {
    position: absolute;
    top: 50%;
    right: 10%;
    left: 10%;
    aspect-ratio: 1 / 1;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(28, 203, 245, 0.16) 0%, rgba(28, 203, 245, 0.05) 40%, rgba(28, 203, 245, 0) 68%);
  }

  .rg-hero .rg-hero__image {
    position: relative;
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    margin: 0 auto;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-composite: intersect;
  }

  .rg-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rg-hero .rg-hero__lead {
    font: 600 clamp(15px, 2svh, 17px) / 1.35 var(--rg-font-body);
    color: var(--rg-on-dark);
    text-wrap: balance;
  }

  .rg-hero .rg-hero__text {
    font: 400 clamp(13px, 1.75svh, 15px) / 1.45 var(--rg-font-body);
    color: #bdbdbd;
    text-wrap: pretty;
  }

  .rg-hero .rg-hero__tagline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
    font: 700 12px/1 var(--rg-font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rg-accent);
  }

  .rg-hero__tagline-line {
    flex: none;
    width: 20px;
    height: 1px;
    background: var(--rg-accent);
  }

  .rg-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .rg-hero__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 8px;
    background: var(--rg-accent);
    color: #111111;
    font: 600 16px/1 var(--rg-font-body);
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rg-hero__button:hover {
    color: #111111;
  }

  .rg-hero__button:focus-visible {
    outline: 2px solid var(--rg-on-dark);
    outline-offset: 3px;
  }

  .rg-hero__note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .rg-hero .rg-hero__note-title {
    font: 700 13px/1 var(--rg-font-body);
    color: var(--rg-on-dark);
  }

  .rg-hero__note-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 1.55em;
    margin: 0;
    padding: 0;
    font: 700 12px/1.2 var(--rg-font-body);
    list-style: none;
  }

  .rg-hero .rg-hero__note-text {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    font: inherit;
    color: var(--rg-on-dark);
    white-space: nowrap;
  }

  .rg-hero__note-text svg {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    color: var(--rg-accent);
  }

  @keyframes rg-hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rg-hero__rise {
      animation: rg-hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .rg-hero__title {
      animation-delay: 0.12s;
    }

    .rg-hero__lead {
      animation-delay: 0.3s;
    }

    .rg-hero__text {
      animation-delay: 0.45s;
    }

    .rg-hero__tagline {
      animation-delay: 0.6s;
    }

    .rg-hero__actions {
      animation-delay: 0.75s;
    }
  }

  /* ---------- Desktop (Raw Gravity Landing, section#top; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-hero {
      --rg-hero-vh: calc(100vh / var(--rg-z, 1));
      container-type: inline-size;
      height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
      min-height: 560px;
      background: #121213;
    }

    .rg-hero__glow {
      position: absolute;
      inset: 0;
      display: block;
      background: radial-gradient(ellipse 55% 60% at 0% 0%, rgba(38, 70, 79, 0.75) 0%, rgba(38, 70, 79, 0) 100%);
      pointer-events: none;
    }

    /* The content column's children and the photo share one grid: copy in column 1 (rows 2-5, centred
       vertically by the two 1fr rows), photo spans column 2. --rg-hero-h = heading size; the copy block's
       sizes are ratios of it, measured on the client screenshot (heading 59.7px there). */
    .rg-hero__inner {
      --rg-hero-h: clamp(32px, min(4.7cqw, calc(var(--rg-hero-vh) * 0.074)), 124px);
      display: grid;
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
      grid-template-rows: minmax(0, 1fr) auto auto auto auto minmax(0, 1fr);
      column-gap: clamp(16px, 2cqw, 40px);
      align-items: start;
      max-width: 2200px;
      height: 100%;
      margin: 0 auto;
      padding: 0 clamp(24px, 3.8cqw, 100px);
    }

    .rg-hero__inner > :not(.rg-hero__media) {
      position: relative;
      z-index: 2;
      grid-column: 1;
      min-width: 0;
    }

    .rg-hero__rating {
      grid-row: 2;
    }

    .rg-hero__title {
      grid-row: 3;
    }

    .rg-hero__copy {
      grid-row: 4;
    }

    .rg-hero__actions {
      grid-row: 5;
    }

    /* .rg-hero prefix: must beat `.rg-hero p { margin: 0 }` */
    .rg-hero .rg-hero__rating {
      gap: calc(var(--rg-hero-h) * 0.143);
      margin-top: 0;
      font-size: max(13px, calc(var(--rg-hero-h) * 0.218));
    }

    .rg-hero__stars {
      font-size: 0.85em;
      letter-spacing: 0.05em;
    }

    .rg-hero .rg-hero__title {
      margin-top: calc(var(--rg-hero-h) * 0.074);
      font-size: var(--rg-hero-h);
      line-height: 0.94;
      letter-spacing: -0.035em;
      text-wrap: wrap;
    }

    .rg-hero__media {
      position: relative;
      z-index: 0;
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      height: auto;
      min-width: 0;
      margin: 0 calc(-1 * clamp(24px, 4.5cqw, 72px)) 0 0;
      overflow: visible;
      container-type: size;
    }

    .rg-hero__media-glow {
      right: 0;
      left: 10%;
    }

    .rg-hero .rg-hero__image {
      position: absolute;
      top: 50%;
      right: 0;
      width: min(calc(100cqw / 0.72), 154.5cqh);
      height: auto;
      margin: 0;
      transform: translateY(-50%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 20%, #000 94%, transparent 100%),
        linear-gradient(180deg, transparent 0%, #000 26%, #000 84%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 20%, #000 94%, transparent 100%),
        linear-gradient(180deg, transparent 0%, #000 26%, #000 84%, transparent 100%);
    }

    .rg-hero__copy {
      gap: calc(var(--rg-hero-h) * 0.226);
      width: min(100%, calc(var(--rg-hero-h) * 7.64));
      max-width: none;
      margin-top: calc(var(--rg-hero-h) * 0.139);
    }

    .rg-hero .rg-hero__lead {
      font-size: max(16px, calc(var(--rg-hero-h) * 0.335));
      line-height: 1.3;
      text-wrap: wrap;
    }

    .rg-hero .rg-hero__text {
      max-width: 42em;
      font-size: clamp(14px, min(1cqw, calc(var(--rg-hero-vh) * 0.018)), 26px);
    }

    .rg-hero .rg-hero__tagline {
      font-size: max(12px, calc(var(--rg-hero-h) * 0.254));
    }

    .rg-hero__tagline-line {
      width: 24px;
    }

    .rg-hero__actions {
      gap: calc(var(--rg-hero-h) * 0.246);
      width: min(100%, calc(var(--rg-hero-h) * 7.64));
      margin-top: calc(var(--rg-hero-h) * 0.276);
      margin-bottom: 0;
    }

    .rg-hero__button {
      gap: 0.5em;
      min-height: max(46px, calc(var(--rg-hero-h) * 0.77));
      padding: 0 24px;
      border-radius: max(6px, calc(var(--rg-hero-h) * 0.1));
      font-size: max(14px, calc(var(--rg-hero-h) * 0.251));
    }

    .rg-hero__button:hover {
      transform: translateY(-2px);
    }

    .rg-hero__note {
      align-items: flex-start;
      gap: 7px;
    }

    .rg-hero .rg-hero__note-title {
      font-size: max(13px, calc(var(--rg-hero-h) * 0.218));
    }

    .rg-hero__note-list {
      justify-content: flex-start;
      font-size: max(12px, calc(var(--rg-hero-h) * 0.218));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-hero__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Hero",
  "class": "rg-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "top"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product photo",
      "info": "Dark background, products on the right half (reference: hero-dark-v2.png, 1559 × 1009)."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "on Amazon"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept.",
      "default": "The last\ncoffee you’ll\nswitch to"
    },
    {
      "type": "text",
      "id": "heading_nowrap",
      "label": "Phrase kept on one line",
      "info": "Part of the heading that must not break, e.g. jitter-free."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Lion’s Mane for focus. Creatine for strength. Adaptogens for stress support."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Black Friday sale up to 50% off"
    },
    {
      "type": "checkbox",
      "id": "tagline_line",
      "label": "Line before the tagline",
      "default": false
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET 50% OFF →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Note under the button"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Guarantee line (shield icon)",
      "default": "30-day money-back guarantee."
    },
    {
      "type": "text",
      "id": "note_text_2",
      "label": "Shipping line (truck icon)",
      "default": "Free US shipping."
    }
  ],
  "presets": [
    {
      "name": "RG · Hero"
    }
  ]
}
{% endschema %}
