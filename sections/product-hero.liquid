<script>
document.addEventListener('DOMContentLoaded', function() {
  // Carousel logic
  const mainSlides = document.querySelectorAll('.rg-carousel-slide');
  const thumbs = document.querySelectorAll('.rg-carousel-thumb');
  const dots = document.querySelectorAll('.rg-carousel__dot');
  const prevBtn = document.querySelector('.rg-carousel-prev');
  const nextBtn = document.querySelector('.rg-carousel-next');
  let currentIndex = 0;

  function updateCarousel(index) {
    mainSlides.forEach(s => s.classList.remove('active'));
    thumbs.forEach(t => t.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));

    mainSlides[index].classList.add('active');
    thumbs[index].classList.add('active');
    if (dots[index]) dots[index].classList.add('active');
    currentIndex = index;
  }

  thumbs.forEach((thumb, idx) => {
    thumb.addEventListener('click', () => updateCarousel(idx));
  });

  if(prevBtn) {
    prevBtn.addEventListener('click', () => {
      let next = currentIndex - 1;
      if(next < 0) next = mainSlides.length - 1;
      updateCarousel(next);
    });
  }

  if(nextBtn) {
    nextBtn.addEventListener('click', () => {
      let next = currentIndex + 1;
      if(next >= mainSlides.length) next = 0;
      updateCarousel(next);
    });
  }

  // Reviews carousel — sliding track with cloned buffer cards (infinite loop)
  (function () {
    const track = document.getElementById('rg-rev-track');
    if (!track) return;

    const origCards = Array.from(track.querySelectorAll('.rg-rev-card'));
    const N = origCards.length;
    const BUFFER = 2;

    const clonesBefore = origCards.slice(-BUFFER).map(c => c.cloneNode(true));
    const clonesAfter = origCards.slice(0, BUFFER).map(c => c.cloneNode(true));
    track.innerHTML = '';
    [...clonesBefore, ...origCards, ...clonesAfter].forEach(c => track.appendChild(c));

    let centerIdx = BUFFER;
    let isAnimating = false;

    function getLayout() {
      const vp = track.parentElement;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
      const cardW = Math.max(300, (vp.offsetWidth - 2 * gap) / 3);
      Array.from(track.children).forEach(c => { c.style.width = cardW + 'px'; });
      return { cardW, gap, step: cardW + gap, viewW: vp.offsetWidth };
    }

    function trackOffset() {
      const { cardW, step, viewW } = getLayout();
      return -(centerIdx * step) + (viewW - cardW) / 2;
    }

    function applyDepth(animate) {
      const tr = animate ? 'transform 0.6s cubic-bezier(0.4,0,0.2,1), opacity 0.6s cubic-bezier(0.4,0,0.2,1)' : 'none';
      Array.from(track.children).forEach((card, i) => {
        const d = Math.abs(i - centerIdx);
        card.style.transition = tr;
        const scale = d === 0 ? 1 : d === 1 ? 0.9 : 0.8;
        card.style.transform = `scale(${scale})`;
        card.style.opacity = d === 0 ? '1' : d === 1 ? '0.75' : '0';
        card.style.borderColor = d === 0 ? 'var(--rg-accent)' : 'transparent';
      });
    }

    function snapTo() {
      track.style.transition = 'none';
      Array.from(track.children).forEach(c => { c.style.transition = 'none'; });
      void track.offsetWidth;
      track.style.transform = `translateX(${trackOffset()}px)`;
      applyDepth(false);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        track.style.transition = '';
      }));
    }

    function slideTo() {
      track.style.transition = 'transform 0.6s cubic-bezier(0.4,0,0.2,1)';
      track.style.transform = `translateX(${trackOffset()}px)`;
      applyDepth(true);
    }

    track.addEventListener('transitionend', e => {
      if (e.target !== track || e.propertyName !== 'transform') return;
      let jumped = false;
      if (centerIdx >= BUFFER + N) { centerIdx -= N; jumped = true; }
      else if (centerIdx < BUFFER) { centerIdx += N; jumped = true; }
      if (jumped) snapTo();
      isAnimating = false;
    });

    function goNext() {
      if (isAnimating) return;
      isAnimating = true;
      centerIdx++;
      slideTo();
    }
    function goPrev() {
      if (isAnimating) return;
      isAnimating = true;
      centerIdx--;
      slideTo();
    }

    const prevBtnEl = document.getElementById('rg-rev-prev');
    const nextBtnEl = document.getElementById('rg-rev-next');
    if (prevBtnEl) prevBtnEl.addEventListener('click', goPrev);
    if (nextBtnEl) nextBtnEl.addEventListener('click', goNext);

    window.addEventListener('resize', snapTo);
    snapTo();
  })();

  // FAQ accordion logic
  const faqItems = document.querySelectorAll('.rg-faq-item');
  faqItems.forEach(item => {
    const header = item.querySelector('.rg-faq-q');
    const answer = item.querySelector('.rg-faq-a');
    header.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      faqItems.forEach(other => {
        if (other !== item && other.classList.contains('open')) {
          other.classList.remove('open');
          other.querySelector('.rg-faq-a').style.maxHeight = '';
        }
      });

      if (isOpen) {
        item.classList.remove('open');
        answer.style.maxHeight = '';
      } else {
        item.classList.add('open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });

  // Comparison table — hover the whole RAW COFFEE + column together
  const cmpHighlightCells = document.querySelectorAll('.rg-cmp-highlight');
  cmpHighlightCells.forEach(cell => {
    cell.addEventListener('mouseenter', () => {
      cmpHighlightCells.forEach(c => c.classList.add('rg-cmp-hover'));
    });
    cell.addEventListener('mouseleave', () => {
      cmpHighlightCells.forEach(c => c.classList.remove('rg-cmp-hover'));
    });
  });
});
</script>

