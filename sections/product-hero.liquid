<section class="rg-product-hero">
  <div class="rg-container">
    <div class="rg-product-hero__grid">

      <!-- Left Column: Images -->
      <div class="rg-product-hero__media">
        <div class="rg-carousel">
          <div class="rg-carousel__main" style="border-radius: 24px; box-shadow: 0 8px 0 0 #e2e2e5; border: 2px solid #e2e2e5; box-sizing: border-box; overflow: hidden;">
            {%- assign first = true -%}
            {%- for image in product.images -%}
              <div class="rg-carousel-slide {% if first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                <img
                  src="{{ image | image_url: width: 900 }}"
                  alt="{{ image.alt | default: product.title }}"
                  width="900"
                  height="900"
                  {%- if first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              </div>
              {%- assign first = false -%}
            {%- else -%}
              {%- for i in (1..6) -%}
                <div class="rg-carousel-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img src="{{ 'product-mushrooms.jpg' | asset_url }}" alt="Product Image {{ i }}" width="900" height="900">
                </div>
              {%- endfor -%}
            {%- endfor -%}

            <div class="rg-carousel__dots">
              {%- assign first_dot = true -%}
              {%- for image in product.images -%}
                <span class="rg-carousel__dot {% if first_dot %}active{% endif %}"></span>
                {%- assign first_dot = false -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  <span class="rg-carousel__dot {% if forloop.first %}active{% endif %}"></span>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="rg-carousel__thumbs-wrap" style="margin-top: 20px;">
             <button class="rg-carousel-prev" aria-label="Previous image">‹</button>
             <div class="rg-carousel__thumbs">
                {%- for image in product.images -%}
                  <div class="rg-carousel-thumb {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                    <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | default: product.title }}" width="150" height="150" loading="lazy">
                  </div>
                {%- else -%}
                   {%- for i in (1..6) -%}
                    <div class="rg-carousel-thumb {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                      <img src="{{ 'product-mushrooms.jpg' | asset_url }}" alt="Thumb {{ i }}" width="150" height="150">
                    </div>
                  {%- endfor -%}
                {%- endfor -%}
             </div>
             <button class="rg-carousel-next" aria-label="Next image">›</button>
          </div>
        </div>

        <!-- Benefit Tags -->
        <div class="rg-product-hero__tags" style="justify-content: center;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit_pill' -%}
              <div class="rg-product-hero__tag" {{ block.shopify_attributes }}>
                <span class="rg-product-hero__tag-check">✓</span>
                {{ block.settings.label }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Right Column: Info -->
      <div class="rg-product-info">
        
        <h1 class="rg-product-info__title-serif" style="margin-bottom: -6px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800;">RAW COFFEE +</h1>
        <p class="rg-product-info__subtitle" style="margin-top: 0; margin-bottom: 8px;">
          Your functional coffee-blend that helps boost energy, improve mental clarity &amp; supports gut health without the crash.
        </p>

