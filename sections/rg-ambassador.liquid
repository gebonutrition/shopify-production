{%- comment -%}
  RAW GRAVITY · Ambassador program, light v2.
  Desktop: photo (left half, full height) + copy with perks.
  Mobile: heading, photo card, text, perk rows, button (the content wrapper becomes display: contents).
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#ambassador (2026-11 update).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign button_link = s.button_link | default: '/pages/contact'
-%}

<section
  class="rg rg-z rg-amb"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-amb__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 1400
        | image_tag:
          widths: '450, 700, 1000, 1400',
          sizes: '(min-width: 990px) 50vw, 72vw',
          loading: 'lazy',
          alt: s.image.alt,
          class: 'rg-amb__image'
      }}
    {%- endif -%}
    {%- if s.label_title != blank -%}
      <div class="rg-amb__label" aria-hidden="true">
        {%- if s.label_eyebrow != blank -%}
          <span class="rg-amb__label-eyebrow">{{ s.label_eyebrow | escape }}</span>
        {%- endif -%}
        <span class="rg-amb__label-title">{{ s.label_title | escape }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="rg-amb__content">
    <div class="rg-amb__inner">
      <div class="rg-amb__head">
        {%- if s.eyebrow != blank -%}
          <p class="rg-amb__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="rg-amb__title">
          {{- s.heading_start | escape }}
          {% if s.heading_accent != blank -%}
            <span class="rg-amb__accent">{{ s.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
      </div>

      {%- if s.text != blank -%}
        <p class="rg-amb__text">{{ s.text | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="rg-amb__perks" role="list">
          {%- for block in section.blocks -%}
            <li class="rg-amb__perk" {{ block.shopify_attributes }}>
              <span class="rg-amb__perk-icon" aria-hidden="true">
                {%- render 'rg-icon', name: block.settings.icon, size: 24, stroke: 1.8 -%}
              </span>
              <span class="rg-amb__perk-copy">
                <span class="rg-amb__perk-title">{{ block.settings.title | escape }}</span>
                <span class="rg-amb__perk-text">{{ block.settings.text | escape }}</span>
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a class="rg-amb__button" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile, section#ambassador) ---------- */
  .rg-amb {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 40px 20px;
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .rg-amb p,
  .rg-amb h2,
  .rg-amb ul {
    margin: 0;
  }

  .rg-amb__content,
  .rg-amb__inner {
    display: contents;
  }

  .rg-amb__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    order: 1;
  }

  .rg-amb__media {
    position: relative;
    order: 2;
    width: 72%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 20px;
    aspect-ratio: 1100 / 1377;
    box-shadow: 0 24px 50px -30px rgba(26, 26, 26, 0.45);
  }

  .rg-amb .rg-amb__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .rg-amb__label {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 7px 10px;
    border-radius: 10px;
    background: rgba(26, 26, 26, 0.72);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .rg-amb__label-eyebrow {
    font: 700 8px/1 var(--rg-font-body);
    letter-spacing: 0.26em;
    color: var(--rg-accent);
  }

  .rg-amb__label-title {
    font: 700 13px/1.2 var(--rg-font-body);
    color: var(--rg-white);
  }

  .rg-amb .rg-amb__eyebrow {
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-amb .rg-amb__title {
    font: 900 clamp(26px, 3.436svh, 33px) / 1.04 var(--rg-font-body);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-ink);
  }

  .rg-amb__accent {
    color: var(--rg-accent);
  }

  .rg-amb .rg-amb__text {
    order: 3;
    font: 400 clamp(13px, 1.777svh, 16px) / 1.55 var(--rg-font-body);
    color: #555555;
    text-wrap: pretty;
  }

  .rg-amb .rg-amb__perks {
    display: flex;
    flex-direction: column;
    gap: 8px;
    order: 4;
    padding: 0;
    list-style: none;
  }

  .rg-amb__perk {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--rg-white);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 14px 30px -22px rgba(26, 26, 26, 0.22);
  }

  .rg-amb__perk-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(28, 203, 245, 0.2) 0%, rgba(28, 203, 245, 0.06) 70%);
    box-shadow: 0 0 12px rgba(28, 203, 245, 0.25);
    color: var(--rg-accent);
  }

  .rg-amb__perk-icon svg {
    width: 20px;
    height: 20px;
  }

  .rg-amb__perk-copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .rg-amb__perk-title {
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.24em;
    color: var(--rg-accent);
  }

  .rg-amb__perk-text {
    font: 600 15px/1.3 var(--rg-font-body);
    color: var(--rg-ink);
  }

  .rg-amb__button {
    display: flex;
    order: 5;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: 50%;
    min-height: 50px;
    margin: 2px auto 0;
    padding: 0 12px;
    border-radius: 12px;
    background: var(--rg-accent);
    box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
    color: var(--rg-ink);
    font: 800 15px/1 var(--rg-font-body);
    letter-spacing: 0.1em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.2s;
  }

  .rg-amb__button:hover {
    color: var(--rg-ink);
    filter: brightness(1.05);
  }

  .rg-amb__button:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 3px;
  }

  /* ---------- Desktop (Raw Gravity Landing, section#ambassador; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-amb {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }

    .rg-amb__media {
      order: 0;
      width: auto;
      min-height: 1000px;
      margin: 0;
      border-radius: 0;
      aspect-ratio: auto;
      box-shadow: none;
    }

    .rg-amb .rg-amb__image {
      object-position: 50% 12%;
    }

    .rg-amb__label {
      right: 32px;
      bottom: 32px;
      gap: 6px;
      padding: 14px 20px;
      border-radius: 14px;
    }

    .rg-amb__label-eyebrow {
      font-size: 11px;
      letter-spacing: 0.32em;
    }

    .rg-amb__label-title {
      font-size: 16px;
    }

    .rg-amb__content {
      display: flex;
      align-items: center;
      padding: 72px 64px 72px 72px;
    }

    .rg-amb__inner {
      display: flex;
      flex-direction: column;
      gap: 22px;
      max-width: 600px;
    }

    .rg-amb__head {
      gap: 22px;
    }

    .rg-amb .rg-amb__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-amb .rg-amb__title {
      font-size: clamp(37px, calc(100vh / var(--rg-z, 1) * 0.0511), 55px);
    }

    .rg-amb .rg-amb__text {
      font-size: 17px;
      line-height: 1.6;
    }

    .rg-amb .rg-amb__perks {
      gap: 10px;
      margin-top: 4px;
    }

    .rg-amb__perk {
      gap: 18px;
      padding: 16px 22px;
      border-radius: 18px;
      box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 18px 40px -26px rgba(26, 26, 26, 0.18);
      transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
    }

    .rg-amb__perk:hover {
      transform: translateX(6px);
      box-shadow: 0 0 0 1px rgba(28, 203, 245, 0.45), 0 18px 40px -22px rgba(28, 203, 245, 0.35);
    }

    .rg-amb__perk-icon {
      width: 46px;
      height: 46px;
      box-shadow: 0 0 16px rgba(28, 203, 245, 0.25);
    }

    .rg-amb__perk-icon svg {
      width: 24px;
      height: 24px;
    }

    .rg-amb__perk-copy {
      gap: 7px;
    }

    .rg-amb__perk-title {
      font-size: 11px;
      letter-spacing: 0.32em;
    }

    .rg-amb__perk-text {
      font-size: 17px;
      line-height: 1.35;
    }

    .rg-amb__button {
      display: inline-flex;
      align-self: flex-start;
      width: auto;
      min-width: 0;
      height: 60px;
      min-height: 0;
      margin: 8px 0 0;
      padding: 0 48px;
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-amb__perk {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Ambassador",
  "class": "rg-amb-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "ambassador",
      "info": "Used by links such as /#ambassador."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "label_eyebrow",
      "label": "Photo label — small",
      "default": "BRAND PROGRAM"
    },
    {
      "type": "text",
      "id": "label_title",
      "label": "Photo label — title",
      "default": "Raw Gravity Ambassadors"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading — start",
      "default": "Become a Raw Gravity"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading — accent (blue)",
      "default": "Ambassador"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Love creating content? Join creators, athletes and wellness pros who get free coffee every month, first dibs on new drops, and real commission on every order they bring in. No follower minimum, just real love for the product."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "APPLY NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Application form or page. Defaults to /pages/contact."
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dollar", "label": "Dollar" },
            { "value": "gift", "label": "Gift" },
            { "value": "zap", "label": "Zap" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "spark", "label": "Spark" }
          ],
          "default": "dollar"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "EARN COMMISSION"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Up to 25% on every sale"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "RG · Ambassador",
      "blocks": [
        { "type": "perk", "settings": { "icon": "dollar", "title": "EARN COMMISSION", "text": "Up to 25% on every sale" } },
        { "type": "perk", "settings": { "icon": "gift", "title": "FREE PRODUCTS", "text": "Monthly product drops" } },
        { "type": "perk", "settings": { "icon": "zap", "title": "EARLY ACCESS", "text": "New launches before anyone else" } }
      ]
    }
  ]
}
{% endschema %}
