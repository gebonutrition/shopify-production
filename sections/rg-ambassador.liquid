{%- comment -%}
  RAW GRAVITY · Ambassador program
  Desktop: photo (left half) + copy with perks; mobile: heading, photo strip
  with text, 3 perk tiles, full-width button.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#ambassador.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign button_link = s.button_link | default: '/pages/contact'
-%}

<section
  class="rg rg-amb"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-amb__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 1400
        | image_tag:
          widths: '450, 700, 1000, 1400',
          sizes: '(min-width: 990px) 50vw, 46vw',
          loading: 'lazy',
          alt: s.image.alt,
          class: 'rg-amb__image'
      }}
    {%- endif -%}
    {%- if s.label_title != blank -%}
      <div class="rg-amb__label rg-amb__label--photo" aria-hidden="true">
        <span class="rg-amb__label-eyebrow">{{ s.label_eyebrow | escape }}</span>
        <span class="rg-amb__label-title">{{ s.label_title | escape }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="rg-amb__content">
    <div class="rg-amb__inner">
      <div class="rg-amb__head">
        {%- if s.eyebrow != blank -%}
          <p class="rg-amb__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="rg-amb__title">
          {{- s.heading_start | escape }}
          {% if s.heading_accent != blank -%}
            <span class="rg-amb__accent">{{ s.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
      </div>

      <div class="rg-amb__copy">
        {%- if s.text != blank -%}
          <p class="rg-amb__text">{{ s.text | escape }}</p>
        {%- endif -%}
        {%- if s.label_title != blank -%}
          <p class="rg-amb__label rg-amb__label--inline">
            <span class="rg-amb__label-eyebrow">{{ s.label_eyebrow | escape }}</span>
            <span class="rg-amb__label-title">{{ s.label_title | escape }}</span>
          </p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="rg-amb__perks" role="list">
          {%- for block in section.blocks -%}
            <li class="rg-amb__perk" {{ block.shopify_attributes }}>
              <span class="rg-amb__perk-icon">
                {%- render 'rg-icon', name: block.settings.icon, size: 22, stroke: 1.8 -%}
              </span>
              <span class="rg-amb__perk-copy">
                <span class="rg-amb__perk-title">{{ block.settings.title | escape }}</span>
                <span class="rg-amb__perk-text">{{ block.settings.text | escape }}</span>
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a class="rg-btn rg-amb__button" href="{{ button_link }}">
          {{- s.button_label | escape }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-amb {
    display: grid;
    grid-template-columns: 46% minmax(0, 1fr);
    grid-template-areas:
      'head head'
      'media copy'
      'rest rest';
    column-gap: 14px;
    align-items: center;
    background: #323232;
    color: var(--rg-on-dark);
  }

  .rg-amb p,
  .rg-amb h2 {
    margin: 0;
  }

  /* Flatten wrappers so head / copy / perks become grid items on mobile */
  .rg-amb__content,
  .rg-amb__inner {
    display: contents;
  }

  .rg-amb__head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 44px var(--rg-gutter) 16px;
  }

  .rg-amb__eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-amb__title {
    font-family: var(--rg-font-display);
    font-size: 29px;
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-amb__accent {
    color: var(--rg-accent);
  }

  .rg-amb__media {
    grid-area: media;
    position: relative;
    height: min(280px, 33dvh);
    min-height: 200px;
    overflow: hidden;
    border-radius: 0 18px 18px 0;
  }

  .rg-amb__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 35%;
  }

  .rg-amb__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding-right: var(--rg-gutter);
  }

  .rg-amb__text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--rg-on-dark-2);
    text-wrap: pretty;
  }

  .rg-amb__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid rgba(28, 203, 245, 0.25);
    border-radius: 10px;
    background: rgba(26, 26, 26, 0.72);
  }

  .rg-amb__label--inline {
    align-self: flex-start;
  }

  .rg-amb__label--photo {
    display: none;
  }

  .rg-amb__label-eyebrow {
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.26em;
    color: var(--rg-accent);
  }

  .rg-amb__label-title {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--rg-on-dark);
  }

  .rg-amb__perks {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 16px var(--rg-gutter) 0;
    list-style: none;
  }

  .rg-amb__perk {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 12px 10px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
  }

  .rg-amb__perk-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(28, 203, 245, 0.14);
    color: var(--rg-accent);
  }

  .rg-amb__perk-icon svg {
    width: 16px;
    height: 16px;
  }

  .rg-amb__perk-copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .rg-amb__perk-title {
    font-size: 8px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    color: var(--rg-accent);
  }

  .rg-amb__perk-text {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--rg-on-dark);
  }

  .rg-amb .rg-amb__button {
    grid-column: 1 / -1;
    width: calc(100% - var(--rg-gutter) * 2);
    margin: 14px var(--rg-gutter) 44px;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-amb {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'media content';
      column-gap: 0;
      align-items: stretch;
      background: var(--rg-dark-bg);
    }

    .rg-amb__media {
      height: auto;
      min-height: min(640px, calc(100vh - 40px));
      border-radius: 0;
    }

    .rg-amb__image {
      object-position: 50% 40%;
    }

    .rg-amb__label--photo {
      position: absolute;
      right: 32px;
      bottom: 32px;
      display: flex;
      gap: 6px;
      padding: 12px 18px;
      border: 0;
      border-radius: 14px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      pointer-events: none;
    }

    .rg-amb__label--photo .rg-amb__label-eyebrow {
      font-size: 10px;
      letter-spacing: 0.32em;
    }

    .rg-amb__label--photo .rg-amb__label-title {
      font-size: 15px;
      letter-spacing: 0.01em;
    }

    .rg-amb__label--inline {
      display: none;
    }

    .rg-amb__content {
      grid-area: content;
      display: flex;
      align-items: center;
      padding: 40px 48px 40px 64px;
    }

    .rg-amb__inner {
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-width: 580px;
    }

    .rg-amb__head {
      gap: 14px;
      padding: 0;
    }

    .rg-amb__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-amb__title {
      font-size: 40px;
    }

    .rg-amb__copy {
      padding: 0;
    }

    .rg-amb__text {
      font-size: 15px;
      line-height: 1.55;
    }

    .rg-amb__perks {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 0;
    }

    .rg-amb__perk {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 10px 18px;
      border-radius: 16px;
      background: transparent;
      transition: background 0.25s;
    }

    .rg-amb__perks:not(:hover) .rg-amb__perk:first-child,
    .rg-amb__perk:hover {
      background: #3b3b3b;
    }

    .rg-amb__perk-icon {
      width: 38px;
      height: 38px;
    }

    .rg-amb__perk-icon svg {
      width: 22px;
      height: 22px;
    }

    .rg-amb__perk-copy {
      gap: 6px;
    }

    .rg-amb__perk-title {
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.38em;
    }

    .rg-amb__perk-text {
      font-size: 16px;
    }

    .rg-amb .rg-amb__button {
      align-self: flex-start;
      width: auto;
      min-height: 58px;
      margin: 6px 0 0;
      padding: 0 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Ambassador",
  "class": "rg-amb-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "ambassador",
      "info": "Used by links such as /#ambassador."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "label_eyebrow",
      "label": "Photo label — small",
      "default": "BRAND PROGRAM"
    },
    {
      "type": "text",
      "id": "label_title",
      "label": "Photo label — title",
      "default": "Raw Gravity Ambassadors"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading — start",
      "default": "Become a Raw Gravity"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading — accent (blue)",
      "default": "Ambassador"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Love creating content? Join creators, athletes and wellness pros who get free coffee every month, first dibs on new drops, and real commission on every order they bring in. No follower minimum, just real love for the product."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "APPLY NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Application form or page. Defaults to /pages/contact."
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dollar", "label": "Dollar" },
            { "value": "gift", "label": "Gift" },
            { "value": "zap", "label": "Zap" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "spark", "label": "Spark" }
          ],
          "default": "dollar"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "EARN COMMISSION"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Up to 25% on every sale"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "RG · Ambassador",
      "blocks": [
        { "type": "perk", "settings": { "icon": "dollar", "title": "EARN COMMISSION", "text": "Up to 25% on every sale" } },
        { "type": "perk", "settings": { "icon": "gift", "title": "FREE PRODUCTS", "text": "Monthly product drops" } },
        { "type": "perk", "settings": { "icon": "zap", "title": "EARLY ACCESS", "text": "New launches before anyone else" } }
      ]
    }
  ]
}
{% endschema %}
