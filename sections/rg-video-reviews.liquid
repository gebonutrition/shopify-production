{%- comment -%}
  RAW GRAVITY · Video reviews ("Join the Community")
  Videos come from Shopify Files (video picker); Shopify serves adaptive sources.
  Desktop: 4-up grid, hover lift. Mobile: swipe carousel with dots.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#reviews.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign button_link = s.button_link | default: routes.all_products_collection_url
-%}

<section
  class="rg rg-vid"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-container">
    <div class="rg-vid__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-vid__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-vid__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <rg-video-reviews class="rg-vid__root">
      <ul class="rg-vid__track" role="list" data-rg-track>
        {%- for block in section.blocks -%}
          {%- assign video = block.settings.video -%}
          <li class="rg-vid__card" data-rg-card {{ block.shopify_attributes }}>
            {%- if video != blank -%}
              {{
                video
                | video_tag:
                  image_size: '720x',
                  preload: 'none',
                  playsinline: true,
                  loop: true,
                  controls: false,
                  class: 'rg-vid__video'
              }}
            {%- endif -%}

            {%- if block.settings.poster != blank -%}
              {{
                block.settings.poster
                | image_url: width: 720
                | image_tag:
                  widths: '360, 540, 720',
                  sizes: '(min-width: 990px) 250px, 54vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'rg-vid__poster'
              }}
            {%- endif -%}

            <span class="rg-vid__shade" aria-hidden="true"></span>

            {%- if video != blank -%}
              <button
                type="button"
                class="rg-vid__play"
                data-rg-play
                aria-label="Play video: {{ block.settings.caption | escape }}"
                aria-pressed="false"
              >
                <svg class="rg-vid__icon-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
                <svg class="rg-vid__icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
              </button>
            {%- endif -%}

            {%- if block.settings.caption != blank -%}
              <p class="rg-vid__caption"><span>“{{ block.settings.caption | escape }}”</span></p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <div class="rg-vid__swipe" aria-hidden="true">
          <span class="rg-vid__dots">
            {%- for block in section.blocks -%}
              <span class="rg-vid__dot{% if forloop.first %} is-active{% endif %}" data-rg-dot></span>
            {%- endfor -%}
          </span>
          <span class="rg-vid__hint">
            SWIPE
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      {%- endif -%}
    </rg-video-reviews>
  {%- endif -%}

  {%- if s.button_label != blank -%}
    <div class="rg-container rg-vid__cta">
      <a class="rg-btn rg-vid__button" href="{{ button_link }}">
        {{- s.button_label | escape }} <span aria-hidden="true">→</span>
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-vid {
    padding-block: 44px;
    background:
      radial-gradient(90% 30% at 15% 0%, var(--rg-dark-glow) 0%, rgba(38, 70, 79, 0) 100%),
      radial-gradient(80% 25% at 100% 60%, rgba(38, 70, 79, 0.85) 0%, rgba(38, 70, 79, 0) 100%),
      var(--rg-dark);
    color: var(--rg-on-dark);
    scroll-margin-top: 80px;
  }

  .rg-vid p,
  .rg-vid h2 {
    margin: 0;
  }

  .rg-vid__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .rg-vid__eyebrow {
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-vid__title {
    font-family: var(--rg-font-display);
    font-size: 29px;
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-vid__root {
    display: block;
  }

  .rg-vid__track {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    margin: 12px 0 0;
    padding: 18px var(--rg-gutter) 4px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--rg-gutter);
    scrollbar-width: none;
  }

  .rg-vid__track::-webkit-scrollbar {
    display: none;
  }

  .rg-vid__card {
    position: relative;
    flex: 0 0 54%;
    overflow: hidden;
    aspect-ratio: 25 / 36;
    border: 1px solid rgba(28, 203, 245, 0.28);
    border-radius: 22px;
    background: linear-gradient(180deg, #333333 0%, #1c1c1c 100%);
    box-shadow: 0 20px 40px -30px rgba(0, 0, 0, 0.6);
    scroll-snap-align: start;
    transition: transform 0.35s var(--rg-ease), box-shadow 0.35s var(--rg-ease), border-color 0.35s var(--rg-ease);
  }

  .rg-vid__card.is-active {
    transform: translateY(-16px);
    border: 2px solid var(--rg-accent);
    box-shadow: 0 0 36px rgba(28, 203, 245, 0.45);
  }

  .rg-vid__video,
  .rg-vid__poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .rg-vid__poster {
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .rg-vid__card.is-playing .rg-vid__poster {
    opacity: 0;
  }

  .rg-vid__shade {
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.6) 100%);
  }

  .rg-vid__play {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rg-accent);
    color: var(--rg-ink);
    box-shadow: 0 0 0 5px rgba(28, 203, 245, 0.22), 0 0 18px rgba(28, 203, 245, 0.5);
    cursor: pointer;
    transition: transform 0.2s var(--rg-ease);
  }

  .rg-vid__play:hover {
    transform: scale(1.08);
  }

  .rg-vid__play:focus-visible {
    outline: 2px solid var(--rg-on-dark);
    outline-offset: 4px;
  }

  .rg-vid__icon-pause,
  .rg-vid__card.is-playing .rg-vid__icon-play {
    display: none;
  }

  .rg-vid__card.is-playing .rg-vid__icon-pause {
    display: block;
  }

  .rg-vid__caption {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    display: flex;
    align-items: center;
    height: 52px;
    padding: 10px 12px;
    border: 1px solid rgba(28, 203, 245, 0.3);
    border-radius: 10px;
    background: rgba(14, 14, 14, 0.88);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--rg-on-dark);
    text-wrap: pretty;
    pointer-events: none;
  }

  .rg-vid__swipe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
  }

  .rg-vid__dots {
    display: flex;
    gap: 6px;
  }

  .rg-vid__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #5a5a5a;
    transition: width 0.3s, background 0.3s;
  }

  .rg-vid__dot.is-active {
    width: 22px;
    background: var(--rg-accent);
  }

  .rg-vid__hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.2em;
    color: #8fa3a8;
  }

  .rg-vid__cta {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  .rg-vid .rg-vid__button {
    width: 100%;
    box-shadow: var(--rg-glow-btn);
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-vid {
      padding-block: 56px;
      background:
        radial-gradient(60% 40% at 15% 0%, var(--rg-dark-glow) 0%, rgba(38, 70, 79, 0) 100%),
        radial-gradient(50% 35% at 100% 55%, rgba(38, 70, 79, 0.85) 0%, rgba(38, 70, 79, 0) 100%),
        var(--rg-dark);
    }

    .rg-vid__head {
      gap: 20px;
    }

    .rg-vid__eyebrow {
      font-size: 12px;
      letter-spacing: 0.36em;
    }

    .rg-vid__title {
      font-size: 42px;
    }

    .rg-vid__track {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      max-width: min(1000px, calc((100vh - 300px) * 2.6));
      margin: 32px auto 0;
      padding: 16px 0 0;
      overflow: visible;
    }

    .rg-vid__card {
      flex: none;
    }

    .rg-vid__play {
      width: 36px;
      height: 36px;
    }

    .rg-vid__caption {
      height: auto;
      padding: 8px 10px;
      line-height: 1.25;
      white-space: nowrap;
    }

    .rg-vid__caption span {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .rg-vid__swipe {
      display: none;
    }

    .rg-vid__cta {
      margin-top: 36px;
    }

    .rg-vid .rg-vid__button {
      width: auto;
      min-height: 60px;
      padding: 0 56px;
    }
  }

  @media (hover: hover) and (min-width: 990px) {
    .rg-vid__card:hover {
      transform: translateY(-16px);
      border: 2px solid var(--rg-accent);
      box-shadow: 0 0 36px rgba(28, 203, 245, 0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-vid__card,
    .rg-vid__dot,
    .rg-vid__play {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* RAW GRAVITY · video reviews: one video plays at a time; mobile swipe dots. */
  if (!customElements.get('rg-video-reviews')) {
    customElements.define(
      'rg-video-reviews',
      class RgVideoReviews extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-rg-track]');
          this.cards = Array.from(this.querySelectorAll('[data-rg-card]'));
          this.dots = Array.from(this.querySelectorAll('[data-rg-dot]'));
          this.onClick = this.onClick.bind(this);
          this.onScroll = this.onScroll.bind(this);
          this.addEventListener('click', this.onClick);
          this.track?.addEventListener('scroll', this.onScroll, { passive: true });
          this.cards.forEach((card) => {
            const video = card.querySelector('video');
            if (!video) return;
            video.addEventListener('pause', () => this.setPlaying(card, false));
            video.addEventListener('play', () => this.setPlaying(card, true));
          });
        }

        disconnectedCallback() {
          this.removeEventListener('click', this.onClick);
          this.track?.removeEventListener('scroll', this.onScroll);
        }

        onClick(event) {
          const button = event.target.closest('[data-rg-play]');
          if (!button) return;
          const card = button.closest('[data-rg-card]');
          const video = card?.querySelector('video');
          if (!video) return;
          if (video.paused) {
            this.cards.forEach((other) => {
              const otherVideo = other.querySelector('video');
              if (otherVideo && otherVideo !== video) otherVideo.pause();
            });
            video.muted = false;
            video.play().catch(() => {
              video.muted = true;
              video.play().catch(() => {});
            });
          } else {
            video.pause();
          }
        }

        setPlaying(card, playing) {
          card.classList.toggle('is-playing', playing);
          card.classList.toggle('is-active', playing);
          card.querySelector('[data-rg-play]')?.setAttribute('aria-pressed', String(playing));
        }

        onScroll() {
          if (!this.dots.length || !this.track) return;
          window.cancelAnimationFrame(this.frame);
          this.frame = window.requestAnimationFrame(() => {
            const trackLeft = this.track.getBoundingClientRect().left;
            let active = 0;
            let best = Infinity;
            this.cards.forEach((card, index) => {
              const distance = Math.abs(card.getBoundingClientRect().left - trackLeft);
              if (distance < best) {
                best = distance;
                active = index;
              }
            });
            this.dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active));
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "RG · Video reviews",
  "class": "rg-vid-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "reviews",
      "info": "Used by links such as /#reviews."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL PEOPLE. REAL MORNINGS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Community"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET STARTED NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to All products when empty."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload in Content → Files. Vertical (9:16) works best."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image (optional)",
          "info": "Shown until the video plays. Defaults to the video's own preview frame."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "My morning starts with this cup"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "RG · Video reviews",
      "blocks": [
        { "type": "video", "settings": { "caption": "My morning starts with this cup" } },
        { "type": "video", "settings": { "caption": "My new pre-workout ritual" } },
        { "type": "video", "settings": { "caption": "Always in my bag, wherever I go" } },
        { "type": "video", "settings": { "caption": "Ready in 30 seconds" } }
      ]
    }
  ]
}
{% endschema %}
