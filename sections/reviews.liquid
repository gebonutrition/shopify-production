<section class="rg-section rg-reviews" style="background: #393939; padding-top: 80px;">
  <div class="rg-container">

    <style>
      .rg-reviews__heading { color: #fff !important; }
      .rg-review-tab {
        border: 1.5px solid rgba(255,255,255,0.35) !important;
        color: #fff !important;
        background: transparent !important;
      }
      .rg-review-tab:hover,
      .rg-review-tab.active {
        border-color: var(--rg-accent) !important;
        background: transparent !important;
        color: var(--rg-accent) !important;
      }
      .rg-testimonial {
        background: #232323 !important;
        border: 1px solid rgba(255,255,255,0.06) !important;
      }
      .rg-reviews-cta {
        display: inline-block; padding: 16px 44px;
        background: linear-gradient(120deg, #1ecffb, #7fe6ff, #4fdcfc, #1eb8e0, #90eaff, #35d0f5);
        background-size: 300% 300%;
        border: 1.5px solid #1ecffb;
        color: #101010; text-decoration: none;
        font-size: 15px; letter-spacing: 0.15em; text-transform: uppercase;
        font-weight: 700; border-radius: 4px;
        animation: rgReviewsBtnGradient 5s ease infinite;
        transition: transform 0.2s, box-shadow 0.25s;
      }
      .rg-reviews-cta:hover {
        transform: translateY(-2px); box-shadow: 0 10px 32px rgba(30,207,251,0.35);
      }
      @keyframes rgReviewsBtnGradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
    </style>

    <p style="text-align: center; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: -4px;">Over 240 Million Cups Served</p>
    <h2 style="text-align: center; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; color: #fff; font-size: clamp(1.8rem, 3.2vw, 2.6rem); margin: 0;">Join The Movement</h2>

    <!-- Video review cards -->
    <div class="rg-video-cards" style="margin-top: 8px; transform: scaleX(1.15) scaleY(1.25); transform-origin: top center; display: flex; flex-wrap: nowrap; justify-content: center; gap: 12px; position: relative; z-index: 1; min-height: 1px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'reviewer' -%}
          {%- assign vid_idx = forloop.index -%}
          <div class="rg-video-card" {{ block.shopify_attributes }} style="min-height: 1px;">
            {%- if block.settings.avatar != blank -%}
              <img src="{{ block.settings.avatar | image_url: width: 600 }}" alt="{{ block.settings.name }}" width="600" height="800" loading="eager" fetchpriority="high" style="display: block;">
            {%- else -%}
              {%- case vid_idx -%}
                {%- when 1 -%}{%- assign vc_file = 'reviewer-1.jpg' -%}
                {%- when 2 -%}{%- assign vc_file = 'reviewer-2.jpg' -%}
                {%- when 3 -%}{%- assign vc_file = 'reviewer-3.jpg' -%}
                {%- else -%}{%- assign vc_file = 'product-brewing.jpg' -%}
              {%- endcase -%}
              <img src="{{ vc_file | asset_url }}" alt="{{ block.settings.name }}" width="600" height="800" loading="eager" fetchpriority="high" style="display: block;">
            {%- endif -%}
            <span class="rg-video-card__play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <div class="rg-video-card__overlay">
              <span class="rg-video-card__name">{{ block.settings.name }}</span>
              <span class="rg-video-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Reviews sub-heading -->
<div style="text-align: center; margin: 100px 0 16px; position: relative; z-index: 2;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 4px; margin-bottom: -4px;">
        {%- for i in (1..5) -%}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:inline-block; color: #fe7803;"><path d="M12 1.5l3.09 6.26 6.91 1.01-5 4.87 1.18 6.89L12 17.27l-6.18 3.25 1.18-6.89-5-4.87 6.91-1.01L12 1.5z"/></svg>
        {%- endfor -%}
        <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.05em; color: rgba(255,255,255,0.7);">Over 60,000 Five Star Reviews</span>
      </div>
      <h3 style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; font-size: clamp(2.2rem, 4.0vw, 3.2rem); color: #fff; margin: 0;">Read Our Reviews</h3>
    </div>
    <!-- Review filter tabs -->
    <style>
      .rg-reviews__tabs { gap: 10px !important; }
      .rg-review-tab {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-size: 13px !important; font-weight: 800 !important; letter-spacing: 0.02em !important;
        text-transform: uppercase !important; color: #242424 !important;
        border: none !important;
        background: #d2d2ff94 !important;
        border-radius: 8px !important; padding: 10px 18px !important;
        cursor: pointer !important;
        transition: background 0.22s, transform 0.22s !important;
      }
      .rg-review-tab:hover {
  background: #e2e2ffc0 !important;
  color: #242424 !important;
  transform: translateY(-2px);
}
      .rg-review-tab.active {
  background: var(--rg-accent) !important;
  color: #fff !important;
}
    </style>
    <div class="rg-reviews__tabs rg-flex-center" style="margin-bottom: 20px !important; margin-top: -20px !important;">
      {%- assign tabs = section.settings.tabs | split: ',' -%}
      {%- for tab in tabs -%}
        <button class="rg-review-tab{% if forloop.first %} active{% endif %}" type="button">{{ tab | strip | upcase }}</button>
      {%- endfor -%}
    </div>
    <!-- Dark testimonial cards -->
    <style>
      .rg-testimonials { align-items: stretch; }
      .rg-testimonial { min-height: 260px; }
      .rg-testimonials .rg-testimonial:first-child,
      .rg-testimonials .rg-testimonial:last-child {
        transform: scale(0.98);
      }
    </style>
    <div style="display: flex; align-items: center; gap: 12px;">
      <button type="button" id="rg-reviews-prev" aria-label="Previous review" style="flex-shrink: 0; width: 44px; height: 44px; border-radius: 10px; background: rgba(10,10,10,0.7); border: 1px solid rgba(255,255,255,0.15); font-size: 18px; color: #fff; cursor: pointer;">‹</button>

      <div style="overflow: hidden; flex: 1; min-width: 0;">
        <div id="rg-reviews-track" style="display: flex; gap: 16px; will-change: transform;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'testimonial' -%}
              <div class="rg-testimonial" data-category="{{ block.settings.category }}" {{ block.shopify_attributes }} style="flex-shrink: 0; background: #393939; border-radius: 20px; padding: 36px 32px 56px; box-sizing: border-box; position: relative; border: 1px solid transparent; height: 260px; overflow: hidden;">
                <div>
  <div style="color: #fe7803; display: flex; gap: 4px; margin-bottom: 14px; justify-content: center;">
    {%- for i in (1..5) -%}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l3.09 6.26 6.91 1.01-5 4.87 1.18 6.89L12 17.27l-6.18 3.25 1.18-6.89-5-4.87 6.91-1.01L12 1.5z"/></svg>
    {%- endfor -%}
  </div>
  <div style="text-align: center; color: var(--rg-accent); font-weight: 700; font-size: 17px; margin-bottom: 8px;">{{ block.settings.headline }}</div>
  <p style="font-size: 16px; line-height: 1.6; color: #fff; margin: 0 0 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">{{ block.settings.text }}</p>
</div>
                <div style="position: absolute; left: 32px; right: 32px; bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                  <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: #fff;">
                    <span style="width: 22px; height: 22px; border-radius: 50%; background: #fff; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
                      <svg width="14px" height="14px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: #2D2D2D;"><path d="M5 20V19C5 15.134 8.13401 12 12 12V12C15.866 12 19 15.134 19 19V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12C14.2091 12 16 10.2091 16 8C16 5.79086 14.2091 4 12 4C9.79086 4 8 5.79086 8 8C8 10.2091 9.79086 12 12 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </span>
                    {{ block.settings.name }}
                  </span>
                  <span style="display: inline-flex; align-items: center; gap: 5px; background: #fafafaff; border-radius: 9999px; padding: 5px 12px; font-size: 12px; font-weight: 600; color: #2D2D2D; white-space: nowrap;">✓ Verified Buyer</span>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    <button type="button" id="rg-reviews-next" aria-label="Next review" style="flex-shrink: 0; width: 44px; height: 44px; border-radius: 10px; background: rgba(10,10,10,0.7); border: 1px solid rgba(255,255,255,0.15); font-size: 18px; color: #fff; cursor: pointer;">›</button>
  </div>

  <div style="display: flex; justify-content: center; margin-top: 40px;">
    <a href="{{ section.settings.cta_link | default: '#' }}" class="rg-reviews-cta">Try It</a>
  </div>

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const tabs = document.querySelectorAll('.rg-review-tab');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const category = tab.textContent.trim();
      document.querySelectorAll('.rg-testimonial').forEach(card => {
        card.style.display = (card.dataset.category === category) ? '' : 'none';
      });
      if (window.rgReviewsSnap) window.rgReviewsSnap();
    });
  });
  document.querySelectorAll('.rg-testimonial').forEach(card => {
    card.style.display = (card.dataset.category === 'TASTE') ? '' : 'none';
  });

  // Testimonials — sliding carousel with cloned buffer cards
  (function () {
    const track = document.getElementById('rg-reviews-track');
    if (!track) return;
    const origCards = Array.from(track.querySelectorAll('.rg-testimonial'));
    const N = origCards.length;
    const BUFFER = 1;
    const clonesBefore = origCards.slice(-BUFFER).map(c => c.cloneNode(true));
    const clonesAfter = origCards.slice(0, BUFFER).map(c => c.cloneNode(true));
    track.innerHTML = '';
    [...clonesBefore, ...origCards, ...clonesAfter].forEach(c => track.appendChild(c));
    let centerIdx = BUFFER;
    let isAnimating = false;
    function getLayout() {
      const vp = track.parentElement;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
      const cardW = Math.max(280, (vp.offsetWidth - 2 * gap) / 3);
      Array.from(track.children).forEach(c => { c.style.width = cardW + 'px'; });
      return { cardW, gap, step: cardW + gap, viewW: vp.offsetWidth };
    }
    function trackOffset() {
      const { cardW, step, viewW } = getLayout();
      return -(centerIdx * step) + (viewW - cardW) / 2;
    }
    function applyDepth(animate) {
      const tr = animate ? 'transform 0.6s cubic-bezier(0.4,0,0.2,1), opacity 0.6s cubic-bezier(0.4,0,0.2,1)' : 'none';
      Array.from(track.children).forEach((card, i) => {
        const d = Math.abs(i - centerIdx);
        card.style.transition = tr;
        const scale = d === 0 ? 1 : d === 1 ? 0.92 : 0.85;
        card.style.transform = `scale(${scale})`;
        card.style.opacity = d === 0 ? '1' : d === 1 ? '0.75' : '0';
      });
    }
    function snapTo() {
      track.style.transition = 'none';
      Array.from(track.children).forEach(c => { c.style.transition = 'none'; });
      void track.offsetWidth;
      track.style.transform = `translateX(${trackOffset()}px)`;
      applyDepth(false);
      requestAnimationFrame(() => requestAnimationFrame(() => { track.style.transition = ''; }));
    }
    function slideTo() {
      track.style.transition = 'transform 0.6s cubic-bezier(0.4,0,0.2,1)';
      track.style.transform = `translateX(${trackOffset()}px)`;
      applyDepth(true);
    }
    track.addEventListener('transitionend', e => {
      if (e.target !== track || e.propertyName !== 'transform') return;
      let jumped = false;
      if (centerIdx >= BUFFER + N) { centerIdx -= N; jumped = true; }
      else if (centerIdx < BUFFER) { centerIdx += N; jumped = true; }
      if (jumped) snapTo();
      isAnimating = false;
    });
    function goNext() { if (isAnimating) return; isAnimating = true; centerIdx++; slideTo(); }
    function goPrev() { if (isAnimating) return; isAnimating = true; centerIdx--; slideTo(); }
    const prevBtn = document.getElementById('rg-reviews-prev');
    const nextBtn = document.getElementById('rg-reviews-next');
    if (prevBtn) prevBtn.addEventListener('click', goPrev);
    if (nextBtn) nextBtn.addEventListener('click', goNext);
    window.addEventListener('resize', snapTo);
    window.rgReviewsSnap = snapTo;
    snapTo();
  })();
});
</script>

