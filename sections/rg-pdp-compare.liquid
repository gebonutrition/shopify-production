{%- comment -%}
  RAW GRAVITY · Product page comparison table "Feel the difference" (Raw Coffee+ vs regular coffee vs other blends).
  Cell values: "check" = check mark, "check: text" = check mark + text, "x" = ban icon, "-" = dash,
  anything else = text. A line break in a cell shows on mobile only.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "07 Comparison".
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="rg rg-z rg-cmp"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap rg-cmp__wrap">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow rg-cmp__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="rg-pdp-h2 rg-cmp__title">{{ s.heading | escape | newline_to_br }}</h2>

    <div class="rg-cmp__card">
      <div class="rg-cmp__table" role="table" aria-label="{{ s.heading | escape }}">
        <div class="rg-cmp__glow" aria-hidden="true"><span></span></div>

        <div class="rg-cmp__head" role="row">
          <span role="columnheader"><span class="rg-visually-hidden">{{ s.label_feature | default: 'Feature' | escape }}</span></span>
          {%- for column in (1..3) -%}
            {%- liquid
              case column
                when 1
                  assign col_image = s.image_ours
                  assign col_label = s.label_ours
                  assign col_class = 'ours'
                when 2
                  assign col_image = s.image_regular
                  assign col_label = s.label_regular
                  assign col_class = 'regular'
                else
                  assign col_image = s.image_other
                  assign col_label = s.label_other
                  assign col_class = 'other'
              endcase
            -%}
            <span class="rg-cmp__col rg-cmp__col--{{ col_class }}" role="columnheader">
              <span class="rg-cmp__thumb">
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 200 | image_tag: widths: '100, 200', sizes: '76px', loading: 'lazy', alt: '' }}
                {%- endif -%}
              </span>
              <span>{{ col_label | escape }}</span>
            </span>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          <div class="rg-cmp__row{% if forloop.last %} rg-cmp__row--last{% endif %}" role="row" {{ block.shopify_attributes }}>
            <span class="rg-cmp__label" role="rowheader">{{ block.settings.label | escape }}</span>
            {%- for column in (1..3) -%}
              {%- liquid
                case column
                  when 1
                    assign raw = block.settings.ours | default: 'check'
                    assign cell_class = 'ours'
                  when 2
                    assign raw = block.settings.regular
                    assign cell_class = 'regular'
                  else
                    assign raw = block.settings.other
                    assign cell_class = 'other'
                endcase
                assign value = raw | strip
                assign key = value | downcase
                assign check_text = ''
                assign key_prefix = key | slice: 0, 6
                if key_prefix == 'check:'
                  assign check_text = value | slice: 6, value.size | strip
                endif
              -%}
              <span class="rg-cmp__cell rg-cmp__cell--{{ cell_class }}" role="cell">
                {%- if key == 'check' or check_text != '' -%}
                  <svg class="rg-cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
                  {%- if check_text != '' -%}
                    <span class="rg-cmp__text">{{ check_text | escape | newline_to_br | replace: '<br />', '<br class="rg-br-m">' }}</span>
                  {%- else -%}
                    <span class="rg-visually-hidden">Yes</span>
                  {%- endif -%}
                {%- elsif key == 'x' -%}
                  <svg class="rg-cmp__ban" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                  <span class="rg-visually-hidden">No</span>
                {%- elsif key == '-' or key == '—' or key == '' -%}
                  <span class="rg-cmp__dash" aria-label="Not stated">—</span>
                {%- else -%}
                  <span class="rg-cmp__text">{{ value | escape | newline_to_br | replace: '<br />', '<br class="rg-br-m">' }}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-cmp {
    background: var(--rg-bg-2);
  }

  .rg-cmp .rg-cmp__eyebrow {
    margin-bottom: 16px;
    text-align: center;
  }

  .rg-cmp .rg-cmp__title {
    margin-bottom: 22px;
    text-align: center;
  }

  .rg-cmp__card {
    margin: 0 auto;
    padding: 12px 6px;
    border-radius: 22px;
    background: var(--rg-white);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
  }

  .rg-cmp__table {
    position: relative;
    --rg-cmp-cols: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.9fr) minmax(0, 0.9fr);
  }

  .rg-cmp__glow,
  .rg-cmp__head,
  .rg-cmp__row {
    display: grid;
    grid-template-columns: var(--rg-cmp-cols);
  }

  .rg-cmp__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rg-cmp__glow span {
    grid-column: 2;
    border-radius: 28px;
    box-shadow: 0 0 44px rgba(28, 203, 245, 0.35);
  }

  .rg-cmp__head {
    position: relative;
    height: 78px;
  }

  .rg-cmp__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0 2px;
    color: var(--rg-text-3);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
  }

  .rg-cmp__col--ours {
    border-radius: 28px 28px 0 0;
    background: linear-gradient(180deg, #4fdcfb, #1ccbf5);
    color: var(--rg-white);
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .rg-cmp__thumb {
    display: flex;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 6px;
    overflow: hidden;
    border: 1px solid var(--rg-line-2);
    border-radius: 16px;
    background: var(--rg-white);
  }

  .rg-cmp__col--ours .rg-cmp__thumb {
    border: 0;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.2);
  }

  .rg-cmp__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-cmp__row {
    position: relative;
    min-height: 26px;
    border-top: 1px solid #e6e6e6;
  }

  .rg-cmp__label {
    display: flex;
    align-items: center;
    padding: 4px 6px 4px 10px;
    color: var(--rg-graphite);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
  }

  .rg-cmp__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    padding: 5px 4px;
    color: var(--rg-text-3);
    text-align: center;
  }

  .rg-cmp__cell--ours {
    margin-top: -1px;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(180deg, #4fdcfb, #1ccbf5);
    color: var(--rg-white);
  }

  .rg-cmp__row--last .rg-cmp__cell--ours {
    border-radius: 0 0 28px 28px;
  }

  .rg-cmp__text {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
  }

  .rg-cmp__cell--ours .rg-cmp__text {
    font-weight: 800;
    line-height: 1.25;
  }

  .rg-cmp__cell--ours svg + .rg-cmp__text {
    font-weight: 700;
  }

  .rg-cmp__check {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .rg-cmp__ban {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .rg-cmp__dash {
    font-size: 11px;
    font-weight: 600;
  }

  .rg-cmp .rg-pdp-cta {
    font-size: 12px;
  }

  @media screen and (min-width: 990px) {
    .rg-cmp .rg-cmp__wrap {
      padding-block: clamp(24px, 4vh, 44px);
    }

    .rg-cmp__card {
      padding: 18px 32px;
      border-radius: 32px;
    }

    .rg-cmp__table {
      --rg-cmp-cols: 1.55fr 1fr 1fr 1fr;
    }

    .rg-cmp__head {
      height: clamp(120px, 15vh, 150px);
    }

    .rg-cmp__col {
      gap: 12px;
      padding: 0;
      font-size: 20px;
      line-height: normal;
    }

    .rg-cmp__col--ours {
      font-size: 22px;
    }

    .rg-cmp__thumb {
      width: clamp(56px, 8vh, 76px);
      height: clamp(56px, 8vh, 76px);
    }

    .rg-cmp__row {
      min-height: clamp(32px, 4.6vh, 44px);
    }

    .rg-cmp__label {
      padding: 6px 12px 6px 30px;
      font-size: 17px;
    }

    .rg-cmp__cell {
      gap: 8px;
      padding: 6px 14px;
    }

    .rg-cmp__text {
      font-size: 17px;
    }

    .rg-cmp__check {
      width: 22px;
      height: 22px;
    }

    .rg-cmp__ban {
      width: 24px;
      height: 24px;
    }

    .rg-cmp__dash {
      font-size: 20px;
    }

    .rg-cmp .rg-pdp-cta {
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Comparison",
  "class": "rg-cmp-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "compare"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SIDE BY SIDE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "FEEL THE DIFFERENCE\nWITH RAW COFFEE+"
    },
    {
      "type": "image_picker",
      "id": "image_ours",
      "label": "Raw Coffee+ image"
    },
    {
      "type": "text",
      "id": "label_ours",
      "label": "Raw Coffee+ label",
      "default": "RAW COFFEE+"
    },
    {
      "type": "image_picker",
      "id": "image_regular",
      "label": "Regular coffee image"
    },
    {
      "type": "text",
      "id": "label_regular",
      "label": "Regular coffee label",
      "default": "Regular Coffee"
    },
    {
      "type": "image_picker",
      "id": "image_other",
      "label": "Other blends image"
    },
    {
      "type": "text",
      "id": "label_other",
      "label": "Other blends label",
      "default": "Other Blends"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY RAW COFFEE+ →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature",
          "default": "No energy crash"
        },
        {
          "type": "textarea",
          "id": "ours",
          "label": "Raw Coffee+",
          "default": "check",
          "info": "check | check: text | x | - | text. A line break shows on mobile only."
        },
        {
          "type": "textarea",
          "id": "regular",
          "label": "Regular coffee",
          "default": "x"
        },
        {
          "type": "textarea",
          "id": "other",
          "label": "Other blends",
          "default": "x"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "RG · Comparison",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
