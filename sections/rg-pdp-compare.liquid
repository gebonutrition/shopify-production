{%- comment -%}
  RAW GRAVITY · Product page comparison table (Raw Coffee+ vs regular coffee vs other blends).
  In the two comparison columns, "x" renders the "not included" icon; any other text is shown as is.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "07 Comparison".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rows = section.blocks
-%}

<section
  class="rg rg-cmp"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap">
    <h2 class="rg-pdp-h2 rg-cmp__title">{{ s.heading | escape | newline_to_br }}</h2>

    <div class="rg-cmp__card">
      <div class="rg-cmp__table" role="table" aria-label="{{ s.heading | escape }}">
        <div class="rg-cmp__glow" aria-hidden="true"><span></span></div>

        <div class="rg-cmp__row rg-cmp__row--head" role="row">
          <span role="columnheader"><span class="rg-visually-hidden">Feature</span></span>
          {%- for col in (1..3) -%}
            {%- liquid
              case col
                when 1
                  assign col_image = s.image_ours
                  assign col_label = s.label_ours
                when 2
                  assign col_image = s.image_regular
                  assign col_label = s.label_regular
                when 3
                  assign col_image = s.image_other
                  assign col_label = s.label_other
              endcase
            -%}
            <span class="rg-cmp__col{% if col == 1 %} rg-cmp__col--ours{% endif %}" role="columnheader">
              <span class="rg-cmp__thumb">
                {%- if col_image != blank -%}
                  {{ col_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '64px', loading: 'lazy', alt: '' }}
                {%- endif -%}
              </span>
              <span>{{ col_label | escape }}</span>
            </span>
          {%- endfor -%}
        </div>

        {%- for block in rows -%}
          {%- liquid
            assign b = block.settings
            assign regular = b.regular | strip
            assign other = b.other | strip
            assign regular_down = regular | downcase
            assign other_down = other | downcase
          -%}
          <div class="rg-cmp__row" role="row" {{ block.shopify_attributes }}>
            <span class="rg-cmp__label" role="rowheader">{{ b.label | escape }}</span>
            <span class="rg-cmp__yes{% if forloop.last %} rg-cmp__yes--last{% endif %}" role="cell">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
              <span class="rg-visually-hidden">{{ s.label_ours | escape }}: yes</span>
            </span>
            {%- for value in (1..2) -%}
              {%- liquid
                if value == 1
                  assign cell = regular
                  assign cell_down = regular_down
                  assign cell_label = s.label_regular
                else
                  assign cell = other
                  assign cell_down = other_down
                  assign cell_label = s.label_other
                endif
              -%}
              <span class="rg-cmp__cell" role="cell">
                {%- if cell_down == 'x' or cell == blank -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                  <span class="rg-visually-hidden">{{ cell_label | escape }}: no</span>
                {%- else -%}
                  <span class="rg-cmp__text">{{ cell | escape }}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-cmp {
    background: var(--rg-bg-2);
  }

  .rg-cmp .rg-cmp__title {
    margin-bottom: 20px;
    text-align: center;
  }

  .rg-cmp__card {
    padding: 14px 10px;
    border-radius: 22px;
    background: var(--rg-white);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.1);
  }

  .rg-cmp__table {
    position: relative;
    --rg-cmp-cols: 1.35fr 1fr 0.9fr 0.9fr;
    --rg-cmp-radius: 18px;
  }

  .rg-cmp__glow {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: var(--rg-cmp-cols);
    pointer-events: none;
  }

  .rg-cmp__glow span {
    grid-column: 2;
    border-radius: var(--rg-cmp-radius);
    box-shadow: 0 0 28px rgba(28, 203, 245, 0.35);
  }

  .rg-cmp__row {
    position: relative;
    display: grid;
    grid-template-columns: var(--rg-cmp-cols);
    min-height: 62px;
    border-top: 1px solid #e6e6e6;
  }

  .rg-cmp__row--head {
    height: 150px;
    border-top: 0;
  }

  .rg-cmp__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--rg-text-3);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .rg-cmp__col--ours {
    padding: 0 4px;
    border-radius: var(--rg-cmp-radius) var(--rg-cmp-radius) 0 0;
    background: linear-gradient(180deg, #4fdcfb, #1ccbf5);
    color: var(--rg-white);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.15;
  }

  .rg-cmp__thumb {
    display: flex;
    flex: none;
    width: 56px;
    height: 56px;
    padding: 6px;
    overflow: hidden;
    border: 1px solid var(--rg-line-2);
    border-radius: 12px;
    background: var(--rg-white);
  }

  .rg-cmp__col--ours .rg-cmp__thumb {
    border: 0;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.2);
  }

  .rg-cmp__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-cmp__label {
    display: flex;
    align-items: center;
    padding: 8px 6px 8px 8px;
    color: var(--rg-graphite);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .rg-cmp__yes {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: -1px;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(180deg, #4fdcfb, #1ccbf5);
    color: var(--rg-white);
  }

  .rg-cmp__yes--last {
    border-radius: 0 0 var(--rg-cmp-radius) var(--rg-cmp-radius);
  }

  .rg-cmp__yes svg {
    width: 18px;
    height: 18px;
    stroke-width: 2.2;
  }

  .rg-cmp__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rg-text-3);
  }

  .rg-cmp__cell svg {
    width: 18px;
    height: 18px;
  }

  .rg-cmp__text {
    font-size: 12px;
    font-weight: 600;
  }

  @media screen and (min-width: 990px) {
    .rg-cmp .rg-cmp__title {
      margin-bottom: 28px;
    }

    .rg-cmp__card {
      max-width: 1080px;
      margin: 0 auto;
      padding: 26px 28px;
      border-radius: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
    }

    .rg-cmp__table {
      --rg-cmp-cols: 1.55fr 1fr 1fr 1fr;
      --rg-cmp-radius: 28px;
    }

    .rg-cmp__glow span {
      box-shadow: 0 0 44px rgba(28, 203, 245, 0.35);
    }

    .rg-cmp__row {
      min-height: 50px;
      height: 50px;
    }

    .rg-cmp__row--head {
      height: 150px;
    }

    .rg-cmp__col {
      gap: 12px;
      font-size: 18px;
    }

    .rg-cmp__col--ours {
      padding: 0;
      font-size: 22px;
      letter-spacing: 0.01em;
    }

    .rg-cmp__thumb {
      width: 64px;
      height: 64px;
      border-radius: 16px;
    }

    .rg-cmp__label {
      padding: 0 0 0 30px;
      font-size: 18px;
    }

    .rg-cmp__yes svg {
      width: 22px;
      height: 22px;
      stroke-width: 2;
    }

    .rg-cmp__cell svg {
      width: 24px;
      height: 24px;
    }

    .rg-cmp__text {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Comparison",
  "class": "rg-cmp-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "compare"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "FEEL THE DIFFERENCE\nWITH RAW COFFEE+"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "image_picker",
      "id": "image_ours",
      "label": "Our product image"
    },
    {
      "type": "text",
      "id": "label_ours",
      "label": "Our product label",
      "default": "RAW COFFEE +"
    },
    {
      "type": "image_picker",
      "id": "image_regular",
      "label": "Column 2 image"
    },
    {
      "type": "text",
      "id": "label_regular",
      "label": "Column 2 label",
      "default": "Regular Coffee"
    },
    {
      "type": "image_picker",
      "id": "image_other",
      "label": "Column 3 image",
      "info": "Do not show a real competitor's packaging or brand."
    },
    {
      "type": "text",
      "id": "label_other",
      "label": "Column 3 label",
      "default": "Other Blends"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY RAW COFFEE →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature",
          "default": "No energy crash"
        },
        {
          "type": "text",
          "id": "regular",
          "label": "Column 2 value",
          "default": "x",
          "info": "x = not included icon; any other text is shown."
        },
        {
          "type": "text",
          "id": "other",
          "label": "Column 3 value",
          "default": "x",
          "info": "x = not included icon; any other text is shown."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "RG · Comparison",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
