{%- comment -%}
  RAW GRAVITY · Product page "Functional benefits" (photo + 4 icon cards).
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "06 Functional benefits".
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="rg rg-fben"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <div class="rg-fben__head">
      <h2 class="rg-pdp-h2 rg-fben__title">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}
        <p class="rg-pdp-lead rg-fben__text">{{ s.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rg-fben__body">
      <div class="rg-fben__photo">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1000
            | image_tag:
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 990px) 447px, calc(100vw - 32px)',
              loading: 'lazy',
              alt: s.image.alt
          }}
        {%- endif -%}
      </div>

      <ul class="rg-fben__cards" role="list">
        {%- for block in section.blocks -%}
          <li class="rg-fben__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag: widths: '80, 128, 160', sizes: '64px', loading: 'lazy', alt: '', class: 'rg-fben__icon'
              }}
            {%- endif -%}
            <span class="rg-fben__copy">
              <span class="rg-fben__card-title">{{ block.settings.title | escape }}</span>
              <span class="rg-fben__card-text">{{ block.settings.text | escape }}</span>
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-fben {
    background: linear-gradient(180deg, #ffffff, #f4f4f6);
  }

  .rg-fben__head .rg-fben__text {
    margin: 10px 0 20px;
  }

  .rg-fben__photo {
    width: 100%;
    height: 343px;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 24px;
    background: #eceef2;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
  }

  .rg-fben__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-fben__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-fben__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 10px 18px;
    border-radius: 16px;
    background: var(--rg-white);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.05);
    text-align: center;
  }

  .rg-fben__icon {
    display: block;
    flex: none;
    width: 54px;
    height: 54px;
    object-fit: contain;
  }

  .rg-fben__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rg-fben__card-title {
    font-size: 12.5px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--rg-ink);
    text-wrap: balance;
  }

  .rg-fben__card-text {
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--rg-text-2);
    text-wrap: pretty;
  }

  @media screen and (min-width: 990px) {
    .rg-fben__head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 48px;
      margin-bottom: 24px;
    }

    .rg-fben__title {
      max-width: 760px;
    }

    .rg-fben__head .rg-fben__text {
      max-width: 420px;
      margin: 0;
    }

    .rg-fben__body {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: 20px;
    }

    .rg-fben__photo {
      flex: none;
      width: 447px;
      height: 405px;
      margin: 0;
    }

    .rg-fben__cards {
      grid-template-columns: repeat(2, minmax(0, 260px));
      grid-auto-rows: 1fr;
      gap: 16px;
    }

    .rg-fben__card {
      justify-content: center;
      gap: 10px;
      padding: 16px 18px;
      border-radius: 20px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.05);
      transition: transform 0.25s var(--rg-ease), box-shadow 0.25s var(--rg-ease);
    }

    .rg-fben__card:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.08);
    }

    .rg-fben__icon {
      width: 64px;
      height: 64px;
    }

    .rg-fben__copy {
      gap: 6px;
    }

    .rg-fben__card-title {
      font-size: 17px;
    }

    .rg-fben__card-text {
      font-size: 14px;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-fben__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Functional benefits",
  "class": "rg-fben-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "benefits"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FUNCTIONAL BENEFITS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CLINICALLY STUDIED PROVEN RESULTS",
      "info": "Claim must be substantiated."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET STARTED NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SHARP MENTAL FOCUS"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "RG · Functional benefits",
      "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }]
    }
  ]
}
{% endschema %}
