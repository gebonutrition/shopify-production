{%- comment -%}
  RAW GRAVITY · Product page "Join the community" (customer videos, dark).
  Desktop: 5 cards visible, arrows on the sides. Mobile: 2 cards visible, swipe, dots + hint.
  Playback, arrows (data-rg-step) and dots: <rg-video-reviews> from assets/rg-video-reviews.js.
  Names and quotes must belong to the people in the videos.
  Layout "Home page" (rg-comm--home): main landing card and type sizes.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "09 Join the movement";
  Raw Gravity Landing(.dc.html) + Mobile, section "Reviews" (layout "Home page").
{%- endcomment -%}
{%- assign s = section.settings -%}

<script src="{{ 'rg-video-reviews.js' | asset_url }}" type="module"></script>
<section
  class="rg rg-z rg-comm rg-pdp-dark rg-comm--{{ s.layout | default: 'product' }}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-comm__inner">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow rg-comm__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="rg-pdp-h2 rg-comm__title">{{ s.heading | escape }}</h2>

    {%- if section.blocks.size > 0 -%}
      <rg-video-reviews class="rg-comm__root">
        {%- if section.blocks.size > 5 -%}
          <button type="button" class="rg-comm__arrow rg-comm__arrow--prev" data-rg-step="-1" aria-label="Previous videos">‹</button>
        {%- endif -%}
        <ul class="rg-comm__track" role="list" data-rg-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign video = block.settings.video
              assign duration = block.settings.duration
              if duration == blank and video.duration
                assign total_seconds = video.duration | divided_by: 1000
                assign minutes = total_seconds | divided_by: 60
                assign seconds = total_seconds | modulo: 60 | prepend: '0' | slice: -2, 2
                assign duration = minutes | append: ':' | append: seconds
              endif
            -%}
            <li class="rg-comm__card" data-rg-card {{ block.shopify_attributes }}>
              {%- if video != blank -%}
                {{
                  video
                  | video_tag:
                    image_size: '720x',
                    preload: 'none',
                    playsinline: true,
                    loop: true,
                    controls: false,
                    class: 'rg-comm__video'
                }}
              {%- endif -%}
              {%- if block.settings.poster != blank -%}
                {{
                  block.settings.poster
                  | image_url: width: 720
                  | image_tag: widths: '360, 540, 720', sizes: '(min-width: 990px) 20vw, 45vw', loading: 'lazy', alt: '', class: 'rg-comm__poster'
                }}
              {%- endif -%}
              <span class="rg-comm__shade" aria-hidden="true"></span>
              {%- if duration != blank -%}
                <span class="rg-comm__dur" aria-hidden="true"><span class="rg-comm__tri"></span>{{ duration }}</span>
              {%- endif -%}
              <span class="rg-comm__big-play" aria-hidden="true"><span></span></span>
              {%- if video != blank -%}
                <button
                  type="button"
                  class="rg-comm__play"
                  data-rg-play
                  aria-label="Play video{% if block.settings.name != blank %}: {{ block.settings.name | escape }}{% endif %}"
                  aria-pressed="false"
                >
                  <span class="rg-comm__badge" aria-hidden="true">
                    <svg class="rg-comm__icon-play" viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
                    <svg class="rg-comm__icon-pause" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
                  </span>
                </button>
              {%- endif -%}
              <div class="rg-comm__meta">
                <span class="rg-comm__stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
                {%- if block.settings.name != blank -%}
                  <span class="rg-comm__name">{{ block.settings.name | escape }}</span>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <span class="rg-comm__quote">“{{ block.settings.caption | escape }}”</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.blocks.size > 5 -%}
          <button type="button" class="rg-comm__arrow rg-comm__arrow--next" data-rg-step="1" aria-label="Next videos">›</button>
        {%- endif -%}

        {%- if section.blocks.size > 2 -%}
          <div class="rg-comm__swipe" aria-hidden="true">
            {%- for block in section.blocks -%}
              <span class="rg-comm__dot{% if forloop.first %} is-active{% endif %}" data-rg-dot></span>
            {%- endfor -%}
            {%- if s.swipe_hint != blank -%}
              <span class="rg-comm__hint">{{ s.swipe_hint | escape }}</span><span class="rg-comm__hint-arrow">→</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </rg-video-reviews>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row rg-comm__cta">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-comm {
    background: radial-gradient(ellipse at 15% 0%, #26464f 0%, #323232 45%, #2e2e2e 100%);
  }

  .rg-comm__inner {
    padding: 30px 0 22px;
  }

  .rg-comm__eyebrow,
  .rg-comm__title {
    text-align: center;
  }

  .rg-comm .rg-comm__title {
    margin-bottom: 20px;
    padding-inline: 16px;
  }

  .rg-comm__root {
    position: relative;
    display: block;
  }

  .rg-comm__track {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 4px 16px 8px;
    overflow-x: auto;
    list-style: none;
    scroll-padding: 0 16px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .rg-comm__track::-webkit-scrollbar {
    display: none;
  }

  .rg-comm__card {
    position: relative;
    flex: none;
    width: calc((100% - 42px) / 2);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.3);
    border-radius: 16px;
    background: linear-gradient(180deg, #3a3a3a, #161616);
    scroll-snap-align: start;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }

  .rg-comm__video,
  .rg-comm__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-comm__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(14, 14, 14, 0.85));
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .rg-comm__dur {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 20px;
    padding: 0 7px;
    border-radius: 10px;
    background: rgba(14, 14, 14, 0.6);
    backdrop-filter: blur(6px);
    color: var(--rg-white);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  .rg-comm__tri {
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--rg-white);
  }

  .rg-comm__big-play {
    position: absolute;
    top: 42%;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(4px);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .rg-comm__big-play span {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 13px solid var(--rg-white);
  }

  .rg-comm__play {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .rg-comm__play:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: -4px;
  }

  .rg-comm__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--rg-accent);
    box-shadow: 0 0 0 4px rgba(28, 203, 245, 0.22), 0 0 16px rgba(28, 203, 245, 0.6);
    color: var(--rg-ink);
  }

  .rg-comm__badge svg {
    width: 14px;
    height: 14px;
  }

  .rg-comm__icon-pause,
  .rg-comm__card.is-playing .rg-comm__icon-play {
    display: none;
  }

  .rg-comm__card.is-playing .rg-comm__icon-pause {
    display: block;
  }

  .rg-comm__card.is-playing .rg-comm__shade,
  .rg-comm__card.is-playing .rg-comm__big-play,
  .rg-comm__card.is-playing .rg-comm__dur,
  .rg-comm__card.is-playing .rg-comm__meta,
  .rg-comm__card.is-playing .rg-comm__poster {
    opacity: 0;
  }

  .rg-comm__meta {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: var(--rg-white);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .rg-comm__stars {
    color: #ff8a1f;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 1.5px;
  }

  .rg-comm__name {
    overflow: hidden;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .rg-comm__quote {
    display: flex;
    align-items: flex-start;
    height: 2.7em;
    font-size: 11px;
    font-style: italic;
    line-height: 1.3;
    color: #f2f2f2;
    text-wrap: balance;
  }

  .rg-comm__swipe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }

  .rg-comm__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #5a5a5a;
    transition: width 0.2s, background 0.2s;
  }

  .rg-comm__dot.is-active {
    width: 22px;
    background: var(--rg-accent);
  }

  .rg-comm__hint {
    margin-left: 12px;
    color: #9a9a9a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
  }

  .rg-comm__hint-arrow {
    color: var(--rg-accent);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
  }

  .rg-comm__arrow {
    display: none;
  }

  .rg-comm .rg-comm__cta {
    margin-top: 24px;
    padding: 0 16px;
  }

  /* ---------- Desktop (rendered through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-comm {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100vh / var(--rg-z, 1) - 140px);
      background: radial-gradient(ellipse at 15% 0%, #26464f 0%, #323232 50%, #2e2e2e 100%);
    }

    .rg-comm__inner {
      width: 100%;
      max-width: 1840px;
      margin: 0 auto;
      padding: clamp(28px, 4vh, 48px) 64px;
    }

    .rg-comm .rg-comm__title {
      margin-bottom: 18px;
      padding-inline: 0;
    }

    .rg-comm__root {
      max-width: calc(clamp(340px, calc(100vh / var(--rg-z, 1) - 430px), 620px) * 0.5625 * 5 + 72px);
      margin: 0 auto;
    }

    .rg-comm__track {
      gap: 16px;
      padding: 10px 4px 14px;
      scroll-padding: 0;
      scroll-behavior: smooth;
    }

    .rg-comm__card {
      width: calc((100% - 64px) / 5);
      border-color: rgba(28, 203, 245, 0.35);
      border-radius: 22px;
      background: #2e2e2e;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.12);
    }

    /* Fewer cards than slots: keep the row centred (auto margins collapse when it overflows) */
    .rg-comm__card:first-child {
      margin-left: auto;
    }

    .rg-comm__card:last-child {
      margin-right: auto;
    }

    .rg-comm__card:hover {
      border-color: var(--rg-accent);
      box-shadow: 0 0 0 1px #1ccbf5, 0 0 34px rgba(28, 203, 245, 0.45);
      transform: translateY(-8px);
    }

    .rg-comm__dur {
      top: 10px;
      left: 10px;
      gap: 5px;
      height: 24px;
      padding: 0 9px;
      border-radius: 13px;
      font-size: 11px;
    }

    .rg-comm__tri {
      border-top-width: 4.5px;
      border-bottom-width: 4.5px;
      border-left-width: 7px;
    }

    .rg-comm__big-play {
      width: 56px;
      height: 56px;
    }

    .rg-comm__big-play span {
      margin-left: 4px;
      border-top-width: 10px;
      border-bottom-width: 10px;
      border-left-width: 16px;
    }

    .rg-comm__badge {
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
      box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
    }

    .rg-comm__badge svg {
      width: 16px;
      height: 16px;
    }

    .rg-comm__meta {
      right: 14px;
      bottom: 14px;
      left: 14px;
      gap: 4px;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
    }

    .rg-comm__stars {
      font-size: 13px;
      letter-spacing: 2px;
    }

    .rg-comm__name {
      font-size: 17px;
    }

    .rg-comm__quote {
      font-size: 14px;
      line-height: 1.35;
    }

    .rg-comm__swipe {
      display: none;
    }

    .rg-comm__arrow {
      position: absolute;
      top: 50%;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 1px solid rgba(28, 203, 245, 0.5);
      border-radius: 50%;
      background: var(--rg-white);
      box-shadow: 0 0 18px rgba(28, 203, 245, 0.35);
      color: var(--rg-ink);
      font: 400 24px/1 var(--rg-font-body);
      transform: translateY(-50%);
      cursor: pointer;
    }

    .rg-comm__arrow:hover {
      background: var(--rg-accent);
    }

    .rg-comm__arrow:focus-visible {
      outline: 2px solid var(--rg-accent);
      outline-offset: 2px;
    }

    .rg-comm__arrow--prev {
      left: -22px;
    }

    .rg-comm__arrow--next {
      right: -22px;
    }

    .rg-comm .rg-comm__cta {
      margin-top: 18px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-comm__card {
      transition: none;
    }

    .rg-comm__track {
      scroll-behavior: auto;
    }
  }

  /* ---------- Layout "Home page" (Raw Gravity Landing + Mobile, "Reviews") ---------- */
  @media screen and (max-width: 989px) {
    .rg-comm--home .rg-comm__inner {
      padding: 44px 0;
    }

    .rg-comm--home .rg-comm__eyebrow {
      margin-bottom: 14px;
      padding-inline: 16px;
      font-size: 9px;
      letter-spacing: 0.32em;
    }

    .rg-comm--home .rg-comm__title {
      margin-bottom: 0;
      font-size: clamp(26px, 3.436svh, 33px);
      line-height: 1.04;
    }

    .rg-comm--home .rg-comm__track {
      gap: 12px;
      margin-top: 12px;
      padding: 12px 16px 4px;
    }

    .rg-comm--home .rg-comm__card {
      width: auto;
      flex: 0 0 44%;
      aspect-ratio: 9 / 14;
      border-color: rgba(28, 203, 245, 0.35);
      border-radius: 20px;
      background: #2e2e2e;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    }

    .rg-comm--home .rg-comm__shade {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(14, 14, 14, 0.85));
    }

    .rg-comm--home .rg-comm__dur {
      top: 10px;
      left: 10px;
      gap: 5px;
      height: 24px;
      padding: 0 9px;
      border-radius: 13px;
      font-size: 11px;
    }

    .rg-comm--home .rg-comm__tri {
      border-top-width: 4.5px;
      border-bottom-width: 4.5px;
      border-left-width: 7px;
    }

    .rg-comm--home .rg-comm__big-play {
      width: 46px;
      height: 46px;
    }

    .rg-comm--home .rg-comm__big-play span {
      margin-left: 4px;
      border-top-width: 9px;
      border-bottom-width: 9px;
      border-left-width: 14px;
    }

    .rg-comm--home .rg-comm__badge {
      width: 34px;
      height: 34px;
      box-shadow: 0 0 0 5px rgba(28, 203, 245, 0.22), 0 0 18px rgba(28, 203, 245, 0.5);
    }

    .rg-comm--home .rg-comm__badge svg {
      width: 12px;
      height: 12px;
    }

    .rg-comm--home .rg-comm__meta {
      right: 12px;
      bottom: 12px;
      left: 12px;
      gap: 4px;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    }

    .rg-comm--home .rg-comm__stars {
      font-size: 11px;
      letter-spacing: 2px;
    }

    .rg-comm--home .rg-comm__name {
      overflow: visible;
      font-size: clamp(12px, 1.659svh, 16px);
      white-space: normal;
    }

    .rg-comm--home .rg-comm__quote {
      display: block;
      height: auto;
      font-size: 12px;
      line-height: 1.35;
      color: rgba(255, 255, 255, 0.9);
    }

    .rg-comm--home .rg-comm__swipe {
      margin-top: 18px;
    }

    .rg-comm--home .rg-comm__hint {
      margin-left: 10px;
      color: #8a8a8a;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.2em;
    }

    .rg-comm--home .rg-comm__hint-arrow {
      margin-left: 2px;
      font-size: 14px;
    }

    .rg-comm--home .rg-comm__cta {
      margin-top: 22px;
    }

    .rg-comm--home .rg-pdp-cta {
      width: fit-content;
      min-width: 50%;
      height: auto;
      min-height: 50px;
      border-radius: 12px;
      font-size: clamp(13px, 1.777svh, 17px);
    }
  }

  @media screen and (min-width: 990px) {
    .rg-comm--home {
      min-height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
    }

    .rg-comm--home .rg-comm__eyebrow {
      letter-spacing: 0.38em;
    }

    .rg-comm--home .rg-comm__title {
      font-size: clamp(37px, calc(100vh / var(--rg-z, 1) * 0.0511), 55px);
      line-height: 1.04;
    }

    .rg-comm--home .rg-comm__shade {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(14, 14, 14, 0.85));
    }

    .rg-comm--home .rg-comm__meta {
      right: 16px;
      bottom: 16px;
      left: 16px;
      gap: 6px;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    }

    .rg-comm--home .rg-comm__stars {
      font-size: 14px;
    }

    .rg-comm--home .rg-comm__name {
      overflow: visible;
      font-size: 18px;
      white-space: normal;
    }

    .rg-comm--home .rg-comm__quote {
      display: block;
      height: auto;
      color: rgba(255, 255, 255, 0.9);
    }

    .rg-comm--home .rg-pdp-cta {
      font-size: 17px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Community videos",
  "class": "rg-comm-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "product", "label": "Product page" },
        { "value": "home", "label": "Home page" }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL PEOPLE. REAL MORNINGS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "text",
      "id": "swipe_hint",
      "label": "Mobile hint",
      "default": "Scroll to see more"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET STARTED NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image",
          "info": "Empty = the video's own preview frame."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Must be the real name of the person in the video."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration label",
          "info": "e.g. 0:24. Empty = taken from the video."
        }
      ]
    }
