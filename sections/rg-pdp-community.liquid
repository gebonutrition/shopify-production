{%- comment -%}
  RAW GRAVITY · Product page "Join the Community" (customer videos, dark).
  Desktop: 4-up grid with hover lift. Mobile: swipe row with dots + SWIPE hint.
  Playback/dots: <rg-video-reviews> from sections/rg-video-reviews.liquid.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "09 Join the movement".
{%- endcomment -%}
{%- assign s = section.settings -%}

<section class="rg rg-comm rg-pdp-dark">
  <div class="rg-comm__inner">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow rg-comm__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="rg-pdp-h2 rg-comm__title">{{ s.heading | escape }}</h2>

    {%- if section.blocks.size > 0 -%}
      <rg-video-reviews class="rg-comm__root">
        <ul class="rg-comm__track" role="list" data-rg-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign video = block.settings.video
              assign duration = block.settings.duration
              if duration == blank and video.duration
                assign total_seconds = video.duration | divided_by: 1000
                assign minutes = total_seconds | divided_by: 60
                assign seconds = total_seconds | modulo: 60 | prepend: '0' | slice: -2, 2
                assign duration = minutes | append: ':' | append: seconds
              endif
            -%}
            <li class="rg-comm__card" data-rg-card {{ block.shopify_attributes }}>
              {%- if video != blank -%}
                {{
                  video
                  | video_tag:
                    image_size: '720x',
                    preload: 'none',
                    playsinline: true,
                    loop: true,
                    controls: false,
                    class: 'rg-comm__video'
                }}
              {%- endif -%}
              {%- if block.settings.poster != blank -%}
                {{
                  block.settings.poster
                  | image_url: width: 720
                  | image_tag: widths: '360, 540, 720', sizes: '(min-width: 990px) 255px, 62vw', loading: 'lazy', alt: '', class: 'rg-comm__poster'
                }}
              {%- endif -%}
              <span class="rg-comm__shade" aria-hidden="true"></span>
              {%- if duration != blank -%}
                <span class="rg-comm__dur" aria-hidden="true"><span class="rg-comm__tri"></span>{{ duration }}</span>
              {%- endif -%}
              <span class="rg-comm__big-play" aria-hidden="true"><span></span></span>
              {%- if video != blank -%}
                <button
                  type="button"
                  class="rg-comm__play"
                  data-rg-play
                  aria-label="Play video: {{ block.settings.caption | escape }}"
                  aria-pressed="false"
                >
                  <svg class="rg-comm__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
                  <svg class="rg-comm__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
                </button>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="rg-comm__quote">“{{ block.settings.caption | escape }}”</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.blocks.size > 1 -%}
          <div class="rg-comm__swipe" aria-hidden="true">
            {%- for block in section.blocks -%}
              <span class="rg-comm__dot{% if forloop.first %} is-active{% endif %}" data-rg-dot></span>
            {%- endfor -%}
            <span class="rg-comm__hint">SWIPE</span><span class="rg-comm__arrow">→</span>
          </div>
        {%- endif -%}
      </rg-video-reviews>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row rg-comm__cta">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-comm__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 44px 0 22px;
  }

  .rg-comm__eyebrow,
  .rg-comm__title {
    text-align: center;
  }

  .rg-comm__title {
    margin-bottom: 20px;
    padding-inline: 16px;
  }

  .rg-comm__track {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 4px 16px 8px;
    overflow-x: auto;
    list-style: none;
    scroll-padding: 0 16px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .rg-comm__track::-webkit-scrollbar {
    display: none;
  }

  .rg-comm__card {
    position: relative;
    flex: none;
    width: 62%;
    aspect-ratio: 9 / 13;
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.3);
    border-radius: 22px;
    background: linear-gradient(180deg, #3a3a3a, #161616);
    scroll-snap-align: start;
  }

  .rg-comm__video,
  .rg-comm__poster,
  .rg-comm__card video,
  .rg-comm__card img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-comm__poster {
    z-index: 1;
    transition: opacity 0.3s;
  }

  .rg-comm__card.is-playing .rg-comm__poster,
  .rg-comm__card.is-playing .rg-comm__big-play,
  .rg-comm__card.is-playing .rg-comm__shade,
  .rg-comm__card.is-playing .rg-comm__dur {
    opacity: 0;
  }

  .rg-comm__shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(14, 14, 14, 0.9));
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .rg-comm__dur {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 9px;
    border-radius: 13px;
    background: rgba(14, 14, 14, 0.6);
    backdrop-filter: blur(6px);
    color: var(--rg-white);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .rg-comm__tri {
    width: 0;
    height: 0;
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
    border-left: 7px solid var(--rg-white);
  }

  .rg-comm__big-play {
    position: absolute;
    top: 42%;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(4px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .rg-comm__big-play span {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
    border-left: 18px solid var(--rg-white);
  }

  /* The whole card is the play target; the round cyan button carries the state */
  .rg-comm__play {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rg-accent);
    box-shadow: 0 0 0 6px rgba(28, 203, 245, 0.22), 0 0 24px rgba(28, 203, 245, 0.6);
    color: var(--rg-ink);
    cursor: pointer;
  }

  .rg-comm__play::after {
    content: '';
    position: absolute;
    inset: -400px -400px -400px -400px;
  }

  .rg-comm__play svg {
    width: 14px;
    height: 14px;
  }

  .rg-comm__icon-pause,
  .rg-comm__card.is-playing .rg-comm__icon-play {
    display: none;
  }

  .rg-comm__card.is-playing .rg-comm__icon-pause {
    display: block;
  }

  .rg-comm__play:focus-visible {
    outline: 2px solid var(--rg-white);
    outline-offset: 3px;
  }

  .rg-comm__quote {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    z-index: 3;
    display: flex;
    align-items: center;
    height: 60px;
    margin: 0;
    padding: 0 12px;
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.35);
    border-radius: 14px;
    background: rgba(14, 14, 14, 0.75);
    color: var(--rg-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
    pointer-events: none;
  }

  .rg-comm__swipe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }

  .rg-comm__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #5a5a5a;
    transition: width 0.2s, background 0.2s;
  }

  .rg-comm__dot.is-active {
    width: 22px;
    background: var(--rg-accent);
  }

  .rg-comm__hint {
    margin-left: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: #9a9a9a;
  }

  .rg-comm__arrow {
    color: var(--rg-accent);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
  }

  .rg-comm__cta {
    padding-inline: 16px;
  }

  .rg-comm .rg-comm__cta .rg-pdp-cta {
    height: 50px;
    font-size: 15px;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-comm__inner {
      padding: clamp(28px, 4.5vh, 44px) 40px 28px;
    }

    .rg-comm__title {
      margin-bottom: 28px;
      padding: 0;
    }

    .rg-comm__track {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      max-width: 1080px;
      margin: 0 auto;
      padding: 0;
      overflow: visible;
    }

    .rg-comm__card {
      width: auto;
      aspect-ratio: 9 / 12;
      background: #2e2e2e;
      transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }

    .rg-comm__card:hover,
    .rg-comm__card.is-active {
      border-color: var(--rg-accent);
      box-shadow: 0 0 0 1px var(--rg-accent), 0 0 34px rgba(28, 203, 245, 0.45);
      transform: translateY(-8px);
    }

    .rg-comm__shade {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(14, 14, 14, 0.92));
    }

    .rg-comm__dur {
      top: 10px;
      left: 10px;
      height: 24px;
      font-size: 11px;
    }

    .rg-comm__big-play {
      width: 56px;
      height: 56px;
    }

    .rg-comm__big-play span {
      border-top-width: 10px;
      border-bottom-width: 10px;
      border-left-width: 16px;
    }

    .rg-comm__play {
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
      box-shadow: 0 0 0 5px rgba(28, 203, 245, 0.22), 0 0 22px rgba(28, 203, 245, 0.6);
    }

    .rg-comm__play svg {
      width: 16px;
      height: 16px;
    }

    .rg-comm__quote {
      right: 10px;
      bottom: 10px;
      left: 10px;
      display: -webkit-box;
      height: auto;
      padding: 7px 9px;
      border-radius: 10px;
      background: rgba(14, 14, 14, 0.55);
      backdrop-filter: blur(6px);
      font-size: 12px;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .rg-comm__swipe {
      display: none;
    }

    .rg-comm .rg-comm__cta .rg-pdp-cta {
      height: 58px;
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-comm__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Community videos",
  "class": "rg-comm-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL PEOPLE. REAL MORNINGS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Community"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET STARTED NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image",
          "info": "Optional. Empty = the video's own preview frame."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Quote",
          "default": "My morning starts with this cup"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration label",
          "info": "Empty = taken from the video, e.g. 0:24."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "RG · Community videos",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
