{%- comment -%}
  RAW GRAVITY · Trust badges ("Uncompromising Standards"), v2.
  Outline icons (snippets/rg-line-icon.liquid) in a glowing circle; a custom image is the fallback.
  Desktop: 6 in a row (zoomed through .rg-z); mobile: 3 per row.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section[data-screen-label=Trust] (2026-11 update).
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="rg rg-z rg-trust"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-trust__wrap">
    <div class="rg-trust__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-trust__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-trust__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="rg-trust__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="rg-trust__item" {{ block.shopify_attributes }}>
          <span class="rg-trust__badge" aria-hidden="true">
            {%- if block.settings.line_icon != blank and block.settings.line_icon != 'none' -%}
              {%- render 'rg-line-icon', name: block.settings.line_icon, size: 86, stroke: 3 -%}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 240
                | image_tag: widths: '120, 240', sizes: '(min-width: 990px) 86px, 38px', loading: 'lazy', alt: ''
              }}
            {%- endif -%}
          </span>
          <span class="rg-trust__label">{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile, "Trust") ---------- */
  .rg-trust {
    background: radial-gradient(ellipse at 15% 0%, #26464f 0%, #323232 45%, #2e2e2e 100%);
    color: var(--rg-on-dark);
  }

  .rg-trust p,
  .rg-trust h2 {
    margin: 0;
  }

  .rg-trust__wrap {
    padding: 28px 20px;
  }

  .rg-trust__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .rg-trust .rg-trust__eyebrow {
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-trust .rg-trust__title {
    font: 900 clamp(26px, 3.436svh, 33px) / 1.04 var(--rg-font-body);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-trust__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .rg-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .rg-trust__badge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 52px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(28, 203, 245, 0.26) 0%, rgba(28, 203, 245, 0.1) 50%, rgba(28, 203, 245, 0) 72%);
    box-shadow: 0 0 16px rgba(28, 203, 245, 0.3);
    color: #00b7e8;
  }

  .rg-trust__badge svg,
  .rg-trust__badge img {
    display: block;
    width: 72%;
    height: 72%;
    object-fit: contain;
    filter: drop-shadow(0 0 4px rgba(0, 183, 232, 0.65));
  }

  .rg-trust__label {
    font: 700 11px/1.25 var(--rg-font-body);
    text-wrap: balance;
  }

  /* ---------- Desktop (Raw Gravity Landing, "Trust"; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-trust {
      --rg-trust-vh: calc(100vh / var(--rg-z, 1));
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .rg-trust__wrap {
      width: 100%;
      max-width: calc(1280px + 96px);
      margin: 0 auto;
      padding: clamp(45px, calc(var(--rg-trust-vh) * 0.0622), 67px) 48px;
    }

    .rg-trust__head {
      gap: 24px;
    }

    .rg-trust .rg-trust__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-trust .rg-trust__title {
      font-size: clamp(37px, calc(var(--rg-trust-vh) * 0.0511), 55px);
    }

    .rg-trust__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 20px;
      margin-top: 40px;
    }

    .rg-trust__item {
      gap: 14px;
    }

    .rg-trust__badge {
      width: min(100%, 120px);
      box-shadow: 0 0 34px rgba(28, 203, 245, 0.3);
    }

    .rg-trust__badge svg,
    .rg-trust__badge img {
      filter: drop-shadow(0 0 7px rgba(0, 183, 232, 0.65));
    }

    .rg-trust__label {
      font-size: 16px;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Trust badges",
  "class": "rg-trust-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "quality"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUALITY & TRUST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uncompromising Standards"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "line_icon",
          "label": "Icon",
          "options": [
            { "value": "lab", "label": "Lab tested (flask)" },
            { "value": "vegan", "label": "Vegan (leaves)" },
            { "value": "non-gmo", "label": "Non-GMO (DNA)" },
            { "value": "gmp", "label": "Made in USA (flag)" },
            { "value": "no-blends", "label": "No proprietary blends" },
            { "value": "guarantee", "label": "60-day guarantee" },
            { "value": "none", "label": "Custom image below" }
          ],
          "default": "lab"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom badge image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Third-Party Lab Tested",
          "info": "Each claim must be substantiated."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "RG · Trust badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge", "settings": { "label": "100% Vegan" } },
        { "type": "badge", "settings": { "label": "Non-GMO" } }
      ]
    }
  ]
}
{% endschema %}
