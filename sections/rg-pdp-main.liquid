{% javascript %}
  /* RAW GRAVITY · product gallery: one image at a time, arrows + thumbnails. */
  if (!customElements.get('rg-pdp-gallery')) {
    customElements.define(
      'rg-pdp-gallery',
      class RgPdpGallery extends HTMLElement {
        connectedCallback() {
          this.slides = Array.from(this.querySelectorAll('.rg-pdp__slide[data-index]'));
          this.thumbs = Array.from(this.querySelectorAll('.rg-pdp__thumb'));
          this.current = this.querySelector('[data-current]');
          this.index = 0;
          if (this.slides.length < 2) return;

          this.addEventListener('click', (event) => {
            const arrow = event.target.closest('.rg-pdp__arrow');
            const thumb = event.target.closest('.rg-pdp__thumb');
            if (arrow) this.show(this.index + Number(arrow.dataset.dir));
            if (thumb) this.show(Number(thumb.dataset.index));
          });

          this.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') this.show(this.index - 1);
            if (event.key === 'ArrowRight') this.show(this.index + 1);
          });

          let startX = null;
          const stage = this.querySelector('.rg-pdp__stage');
          stage.addEventListener('touchstart', (event) => {
            startX = event.touches[0].clientX;
          }, { passive: true });
          stage.addEventListener('touchend', (event) => {
            if (startX === null) return;
            const dx = event.changedTouches[0].clientX - startX;
            if (Math.abs(dx) > 40) this.show(this.index + (dx < 0 ? 1 : -1));
            startX = null;
          });
        }

        show(next) {
          const total = this.slides.length;
          this.index = ((next % total) + total) % total;
          this.slides.forEach((slide, i) => {
            slide.hidden = i !== this.index;
          });
          this.thumbs.forEach((thumb, i) => {
            if (i === this.index) {
              thumb.setAttribute('aria-current', 'true');
            } else {
              thumb.removeAttribute('aria-current');
            }
          });
          if (this.current) this.current.textContent = String(this.index + 1);
        }
      }
    );
  }
{% endjavascript %}

