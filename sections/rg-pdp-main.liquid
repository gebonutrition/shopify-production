    .rg-pdp__vids {
      margin-top: 40px;
    }

    .rg-pdp__vids-track {
      gap: 12px;
      scroll-behavior: smooth;
    }

    .rg-pdp__vid {
      flex-basis: calc((100% - 24px) / 3);
      border-radius: 12px;
    }

    .rg-pdp__vid-badge {
      top: 8px;
      right: 8px;
