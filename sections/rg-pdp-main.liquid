      width: 30px;
      height: 30px;
      box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
      transform: none;
    }

    .rg-pdp__vid-badge svg {
      width: 11px;
      height: 11px;
    }

    .rg-pdp__vid-name {
      bottom: 8px;
      left: 8px;
      font-size: 11px;
    }

    .rg-pdp__vids-arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--rg-white);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
      color: var(--rg-graphite);
      font: 400 20px/1 var(--rg-font-body);
      transform: translateY(-50%);
