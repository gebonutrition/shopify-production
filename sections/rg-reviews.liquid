{%- comment -%}
  RAW GRAVITY · Reviews ("Read Our Reviews")
  Review blocks are grouped into tabs by their "Tab" label (order of first appearance).
  Desktop: arrows flank a 2-up panel; mobile: stacked cards, arrows + dots below.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#reviews-list.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign groups = ''
  for block in section.blocks
    assign label = block.settings.group | strip | upcase
    if label == blank
      assign label = 'REVIEWS'
    endif
    assign groups_check = groups | split: '||'
    unless groups_check contains label
      if groups == ''
        assign groups = label
      else
        assign groups = groups | append: '||' | append: label
      endif
    endunless
  endfor
  assign group_list = groups | split: '||'
  assign button_link = s.button_link | default: routes.all_products_collection_url
-%}

<script src="{{ 'rg-tabs.js' | asset_url }}" type="module"></script>
<section
  class="rg rg-reviews"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-container">
    <div class="rg-reviews__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-reviews__eyebrow">
          {%- if s.show_stars -%}
            <span class="rg-reviews__stars" aria-hidden="true">★★★★★</span>
          {%- endif -%}
          {{- s.eyebrow | escape -}}
        </p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-reviews__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <rg-tabs class="rg-reviews__tabs-root">
        {%- if group_list.size > 1 -%}
          <div class="rg-reviews__tabs" role="tablist" aria-label="{{ s.heading | escape }}">
            {%- for group in group_list -%}
              <button
                type="button"
                class="rg-reviews__tab"
                role="tab"
                id="rg-rev-tab-{{ section.id }}-{{ forloop.index0 }}"
                aria-controls="rg-rev-panel-{{ section.id }}-{{ forloop.index0 }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-rg-tab="{{ forloop.index0 }}"
              >
                {{- group | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="rg-reviews__stage">
          {%- if group_list.size > 1 -%}
            <button type="button" class="rg-reviews__arrow rg-reviews__arrow--prev" data-rg-prev aria-label="Previous reviews">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
          {%- endif -%}

          <div class="rg-reviews__panels">
            {%- for group in group_list -%}
              {%- assign group_index = forloop.index0 -%}
              <div
                class="rg-reviews__panel"
                role="tabpanel"
                id="rg-rev-panel-{{ section.id }}-{{ group_index }}"
                aria-labelledby="rg-rev-tab-{{ section.id }}-{{ group_index }}"
                data-rg-panel="{{ group_index }}"
                {% unless forloop.first %}
                  hidden
                {% endunless %}
              >
                {%- for block in section.blocks -%}
                  {%- assign label = block.settings.group | strip | upcase -%}
                  {%- if label == blank -%}{%- assign label = 'REVIEWS' -%}{%- endif -%}
                  {%- if label == group -%}
                    <article class="rg-reviews__card" {{ block.shopify_attributes }}>
                      <div class="rg-reviews__photo">
                        {%- if block.settings.photo != blank -%}
                          {{
                            block.settings.photo
                            | image_url: width: 600
                            | image_tag:
                              widths: '300, 450, 600',
                              sizes: '(min-width: 990px) 240px, 34vw',
                              loading: 'lazy',
                              alt: block.settings.name
                          }}
                        {%- endif -%}
                      </div>
                      <div class="rg-reviews__body">
                        <p class="rg-reviews__card-stars" aria-label="5 out of 5 stars">★★★★★</p>
                        <h3 class="rg-reviews__card-title">{{ block.settings.title | escape }}</h3>
                        <p class="rg-reviews__text">{{ block.settings.text | escape }}</p>
                        <div class="rg-reviews__meta">
                          <span class="rg-reviews__name">
                            <span class="rg-reviews__avatar" aria-hidden="true">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                            </span>
                            {{- block.settings.name | escape -}}
                          </span>
                          {%- if block.settings.badge != blank -%}
                            <span class="rg-reviews__badge">{{ block.settings.badge | escape }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    </article>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if group_list.size > 1 -%}
            <button type="button" class="rg-reviews__arrow rg-reviews__arrow--next" data-rg-next aria-label="Next reviews">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </button>

            <div class="rg-reviews__dots">
              {%- for group in group_list -%}
                <button
                  type="button"
                  class="rg-reviews__dot"
                  data-rg-tab="{{ forloop.index0 }}"
                  aria-label="{{ group | escape }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </rg-tabs>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <div class="rg-reviews__cta">
        <a class="rg-btn rg-reviews__button" href="{{ button_link }}">
          {{- s.button_label | escape }} <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-reviews {
    padding-block: 32px 36px;
    background: radial-gradient(80% 30% at 100% 40%, rgba(38, 70, 79, 0.85) 0%, rgba(38, 70, 79, 0) 100%), var(--rg-dark);
    color: var(--rg-on-dark);
  }

  .rg-reviews p,
  .rg-reviews h2,
  .rg-reviews h3 {
    margin: 0;
  }

  .rg-reviews__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .rg-reviews__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.26em;
    color: var(--rg-accent);
  }

  .rg-reviews__stars,
  .rg-reviews__card-stars {
    color: #f7931e;
    letter-spacing: 0.06em;
  }

  .rg-reviews__stars {
    font-size: 15px;
  }

  .rg-reviews__title {
    font-family: var(--rg-font-display);
    font-size: 29px;
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-reviews__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
  }

  .rg-reviews__tab {
    flex: none;
    padding: 11px 13px;
    border: 0;
    border-radius: 999px;
    background: rgba(38, 70, 79, 0.9);
    color: var(--rg-on-dark);
    font: 700 10px/1 var(--rg-font-body);
    letter-spacing: 0.14em;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .rg-reviews__tab[aria-selected='true'] {
    background: var(--rg-accent);
    color: var(--rg-ink);
  }

  .rg-reviews__tab:focus-visible,
  .rg-reviews__arrow:focus-visible,
  .rg-reviews__dot:focus-visible {
    outline: 2px solid var(--rg-on-dark);
    outline-offset: 2px;
  }

  .rg-reviews__stage {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    column-gap: 16px;
    row-gap: 14px;
    margin-top: 14px;
  }

  .rg-reviews__panels {
    order: -1;
    flex: 1 1 100%;
    min-width: 0;
  }

  .rg-reviews__panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rg-reviews__panel[hidden] {
    display: none;
  }

  .rg-reviews__card {
    display: grid;
    grid-template-columns: 34% minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.28);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(50, 66, 72, 0.9) 0%, rgba(44, 54, 58, 0.9) 100%);
  }

  .rg-reviews__photo {
    position: relative;
    min-height: 100%;
    background: var(--rg-graphite);
  }

  .rg-reviews__photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .rg-reviews__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 12px;
  }

  .rg-reviews__card-stars {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .rg-reviews__card-title {
    font-family: var(--rg-font-body);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.25;
    color: var(--rg-accent);
    text-wrap: balance;
  }

  .rg-reviews__text {
    flex: 1;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--rg-on-dark-2);
    text-wrap: pretty;
  }

  .rg-reviews__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 4px;
  }

  .rg-reviews__name {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }

  .rg-reviews__avatar,
  .rg-reviews__badge {
    border: 1px solid rgba(28, 203, 245, 0.45);
    background: rgba(28, 203, 245, 0.1);
  }

  .rg-reviews__avatar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: var(--rg-on-dark-2);
  }

  .rg-reviews__badge {
    flex: none;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .rg-reviews__arrow {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid rgba(28, 203, 245, 0.25);
    border-radius: 50%;
    background: #1e1e1e;
    color: var(--rg-on-dark);
    box-shadow: 0 0 20px rgba(28, 203, 245, 0.25);
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .rg-reviews__arrow svg {
    width: 18px;
    height: 18px;
  }

  .rg-reviews__arrow--next {
    order: 2;
  }

  .rg-reviews__dots {
    order: 1;
    display: flex;
    gap: 6px;
  }

  .rg-reviews__dot {
    width: 8px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #5a5a5a;
    cursor: pointer;
    transition: width 0.3s, background 0.3s;
  }

  .rg-reviews__dot[aria-current='true'] {
    width: 28px;
    background: var(--rg-accent);
  }

  .rg-reviews__cta {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  .rg-reviews .rg-reviews__button {
    width: 100%;
    box-shadow: var(--rg-glow-btn);
  }

  @media (hover: hover) {
    .rg-reviews__arrow:hover {
      background: var(--rg-accent);
      color: var(--rg-ink);
    }
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-reviews {
      padding-block: 48px 56px;
      background: radial-gradient(50% 45% at 100% 40%, rgba(38, 70, 79, 0.85) 0%, rgba(38, 70, 79, 0) 100%), var(--rg-dark);
    }

    .rg-reviews__head {
      gap: 14px;
    }

    .rg-reviews__eyebrow {
      gap: 16px;
      font-size: 12px;
      letter-spacing: 0.36em;
    }

    .rg-reviews__stars {
      font-size: 17px;
    }

    .rg-reviews__title {
      font-size: 46px;
    }

    .rg-reviews__tabs {
      gap: 10px;
      margin-top: 20px;
    }

    .rg-reviews__tab {
      padding: 13px 22px;
      font-size: 12px;
      letter-spacing: 0.18em;
    }

    .rg-reviews__stage {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr) 52px;
      grid-template-areas:
        'prev panels next'
        '. dots .';
      column-gap: 22px;
      row-gap: 20px;
      max-width: 1240px;
      margin: 24px auto 0;
    }

    .rg-reviews__arrow--prev {
      grid-area: prev;
    }

    .rg-reviews__arrow--next {
      grid-area: next;
    }

    .rg-reviews__panels {
      grid-area: panels;
    }

    .rg-reviews__dots {
      grid-area: dots;
      justify-content: center;
      gap: 8px;
    }

    .rg-reviews__dot {
      height: 8px;
    }

    .rg-reviews__arrow {
      width: 52px;
      height: 52px;
      box-shadow: 0 0 24px rgba(28, 203, 245, 0.25);
    }

    .rg-reviews__arrow svg {
      width: 20px;
      height: 20px;
    }

    .rg-reviews__panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .rg-reviews__card {
      grid-template-columns: 40% minmax(0, 1fr);
      min-height: 340px;
      border-radius: 24px;
      box-shadow: 0 30px 60px -36px rgba(0, 0, 0, 0.7);
    }

    .rg-reviews__body {
      gap: 10px;
      padding: 24px 24px 20px;
    }

    .rg-reviews__card-stars {
      font-size: 17px;
    }

    .rg-reviews__card-title {
      font-size: 19px;
    }

    .rg-reviews__text {
      font-size: 14px;
      line-height: 1.6;
    }

    .rg-reviews__meta {
      gap: 12px;
      padding-top: 6px;
    }

    .rg-reviews__name {
      gap: 10px;
      font-size: 15px;
      line-height: 1;
    }

    .rg-reviews__avatar {
      width: 26px;
      height: 26px;
    }

    .rg-reviews__badge {
      padding: 7px 12px;
      font-size: 12px;
    }

    .rg-reviews__cta {
      margin-top: 24px;
    }

    .rg-reviews .rg-reviews__button {
      width: auto;
      min-height: 60px;
      padding: 0 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-reviews__tab,
    .rg-reviews__arrow,
    .rg-reviews__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Reviews",
  "class": "rg-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "reviews-list",
      "info": "Used by links such as /#reviews-list."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "RATED 4.8 ON AMAZON",
      "info": "Must match a real, current rating."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars before the eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read Our Reviews"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY IT NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to All products when empty."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Tab",
          "default": "ENERGY",
          "info": "Reviews with the same tab label are shown together."
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Just amazing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "✓ Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RG · Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "group": "ENERGY"
          }
        },
        {
          "type": "review",
          "settings": {
            "group": "ENERGY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
