<style>
  .rg-amb-wrap {
    background: #393939;
    border-top: 1px solid rgba(255,255,255,0.05);
    overflow: hidden;
  }
  .rg-amb-inner { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; }
  .rg-amb-photo { position: relative; background: #1a1816; overflow: hidden; }
  .rg-amb-photo-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 55% 35%, rgba(30,207,251,0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 20% 75%, rgba(30,207,251,0.08) 0%, transparent 50%),
      linear-gradient(170deg, #2a2724 0%, #1a1816 100%);
  }
  .rg-amb-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .rg-amb-photo-edge {
    position: absolute; inset: 0;
    background: linear-gradient(to right, transparent 60%, #232323 100%);
  }
  .rg-amb-photo-tag {
    position: absolute; bottom: 40px; left: 40px;
    background: rgba(30,28,26,0.75); backdrop-filter: blur(14px);
    border: 1px solid rgba(30,207,251,0.3); border-radius: 8px;
    padding: 14px 20px;
  }
  .rg-amb-photo-tag-line { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--rg-accent); margin-bottom: 3px; }
  .rg-amb-photo-tag-title { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; text-transform: none; font-size: 16px; color: #F5F0EB; }

  .rg-amb-text { padding: 96px 80px 96px 56px; display: flex; flex-direction: column; justify-content: center; }
  .rg-amb-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rg-accent); margin-bottom: 20px; }
  .rg-amb-heading {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 800; text-transform: none;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    color: #F5F0EB; line-height: 1.15; margin-bottom: 22px;
  }
  .rg-amb-heading span { color: var(--rg-accent); }
  .rg-amb-desc { font-size: 15px; color: rgba(240,234,224,0.55); line-height: 1.8; max-width: 440px; margin-bottom: 44px; }

  .rg-amb-perks { display: flex; flex-direction: column; gap: 14px; margin-bottom: 48px; }
  .rg-amb-perk {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06); border-radius: 8px;
    transition: background 0.4s cubic-bezier(0.22,1,.36,1), border-color 0.4s cubic-bezier(0.22,1,.36,1), transform 0.4s cubic-bezier(0.22,1,.36,1);
  }
  .rg-amb-perk:hover { background: rgba(30,207,251,0.08); border-color: rgba(30,207,251,0.25); }
  .rg-amb-perk-icon {
    width: 34px; height: 34px; flex-shrink: 0; border-radius: 50%;
    background: rgba(30,207,251,0.1); border: 1px solid rgba(30,207,251,0.25);
    display: flex; align-items: center; justify-content: center; color: var(--rg-accent);
    transition: background 0.4s ease, transform 0.4s cubic-bezier(0.22,1,.36,1);
  }
  .rg-amb-perk:hover .rg-amb-perk-icon { background: rgba(30,207,251,0.22); transform: scale(1.1); }
  .rg-amb-perk-text { font-size: 14px; color: rgba(240,234,224,0.65); line-height: 1.5; }
  .rg-amb-perk-text strong { display: block; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rg-accent); font-weight: 500; margin-bottom: 3px; }

  .rg-amb-cta {
    display: inline-block; padding: 16px 44px;
    background: linear-gradient(120deg, #1ecffb, #7fe6ff, #4fdcfc, #1eb8e0, #90eaff, #35d0f5);
    background-size: 300% 300%;
    border: 1.5px solid #1ecffb;
    color: #101010; text-decoration: none;
    font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 700; border-radius: 4px; align-self: flex-start;
    animation: rgAmbBtnGradient 5s ease infinite;
    transition: transform 0.2s, box-shadow 0.25s;
  }
  .rg-amb-cta:hover {
    transform: translateY(-2px); box-shadow: 0 10px 32px rgba(30,207,251,0.35);
  }
  @keyframes rgAmbBtnGradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @media (max-width: 1024px) {
    .rg-amb-inner { grid-template-columns: 1fr; }
    .rg-amb-photo { min-height: 320px; }
    .rg-amb-photo-edge { background: linear-gradient(to bottom, transparent 60%, #232323 100%); }
    .rg-amb-text { padding: 64px 32px; }
  }
</style>

<section class="rg-amb-wrap">
  <div class="rg-amb-inner">

    <div class="rg-amb-photo">
      <div class="rg-amb-photo-bg"></div>
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.title }}"
          width="1200"
          height="1200"
          loading="lazy"
        >
      {%- endif -%}
      <div class="rg-amb-photo-edge"></div>
      <div class="rg-amb-photo-tag">
        <p class="rg-amb-photo-tag-line">Brand Program</p>
        <p class="rg-amb-photo-tag-title">Raw Gravity Ambassadors</p>
      </div>
    </div>

    <div class="rg-amb-text">
      <p class="rg-amb-eyebrow">Join the Community</p>

      {%- assign title_words = section.settings.title | split: ' ' -%}
      {%- assign title_last = title_words | last -%}
      <h2 class="rg-amb-heading">
        {%- for word in title_words -%}
          {%- unless forloop.last -%}{{ word }} {%- endunless -%}
        {%- endfor -%}
        <br><span>{{ title_last }}</span>
      </h2>

      <p class="rg-amb-desc">{{ section.settings.description }}</p>

      <div class="rg-amb-perks">
        {%- for block in section.blocks -%}
          <div class="rg-amb-perk" {{ block.shopify_attributes }}>
            <span class="rg-amb-perk-icon">
              {%- case block.settings.title -%}
                {%- when 'Earn Commission' -%}
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                {%- when 'Free Products' -%}
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20,12 20,22 4,22 4,12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
                {%- when 'Early Access' -%}
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10 13,2"/></svg>
                {%- else -%}
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {%- endcase -%}
            </span>
            <div class="rg-amb-perk-text">
              <strong>{{ block.settings.title }}</strong>
              {{ block.settings.description }}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="rg-amb-cta">{{ section.settings.cta_text }}</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Ambassador",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Become An Ambassador" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Meet the RAW GRAVITY Brand Ambassador Program — a community of coffee lovers who want to earn more with RAW GRAVITY. Enjoy discounts for your followers, commission earnings on the sales you drive, first access to product launches, and more!" },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "View More" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji, unused)", "default": "💰" },
        { "type": "text", "id": "title", "label": "Title", "default": "Earn Commission" },
        { "type": "text", "id": "description", "label": "Description", "default": "Earn on every sale you drive — your audience, your revenue" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ambassador",
      "blocks": [
        { "type": "perk", "settings": { "icon": "💰", "title": "Earn Commission", "description": "Earn on every sale you drive — your audience, your revenue" } },
        { "type": "perk", "settings": { "icon": "🎁", "title": "Free Products", "description": "Complimentary product drops to fuel your content and daily ritual" } },
        { "type": "perk", "settings": { "icon": "🚀", "title": "Early Access", "description": "First access to new launches and exclusive blend previews" } }
      ]
    }
  ]
}
{% endschema %}
