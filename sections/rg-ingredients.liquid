{%- comment -%}
  RAW GRAVITY · Ingredients ("Nootropics For Your Mind")
  Desktop: list | glass photo | list; mobile: photo + heading, 2-col list.
  Each ingredient opens a native <dialog> with photo and details (prev/next).
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#ingredients + modal.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign left_count = s.left_count
  if left_count > total
    assign left_count = total
  endif
  assign button_link = s.button_link | default: routes.all_products_collection_url
  assign plus_icon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>'
-%}

<section
  class="rg rg-ing"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <rg-ingredients class="rg-container rg-ing__wrap">
    <div class="rg-ing__intro">
      <div class="rg-ing__media" aria-hidden="true">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 800
            | image_tag:
              widths: '300, 500, 800',
              sizes: '(min-width: 990px) 300px, 44vw',
              loading: 'lazy',
              alt: '',
              class: 'rg-ing__image'
          }}
        {%- endif -%}
      </div>
      <div class="rg-ing__head">
        {%- if s.eyebrow != blank -%}
          <p class="rg-ing__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="rg-ing__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="rg-ing__lead">{{ s.intro }}</div>
        {%- endif -%}
        {%- if s.fun_fact != blank -%}
          <p class="rg-ing__fact">{{ s.fun_fact }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Desktop: two columns around the photo {%- endcomment -%}
    <div class="rg-ing__cols">
      <ul class="rg-ing__list rg-ing__list--left" role="list">
        {%- for block in section.blocks limit: left_count -%}
          <li>
            <button type="button" class="rg-ing__item" data-rg-open="{{ forloop.index0 }}" aria-haspopup="dialog">
              <span class="rg-ing__item-copy">
                <span class="rg-ing__name">{{ block.settings.name | escape }}</span>
                <span class="rg-ing__dose">{{ block.settings.dose | escape }}</span>
                <span class="rg-ing__sub">{{ block.settings.sub | escape }}</span>
              </span>
              <span class="rg-ing__plus">{{ plus_icon }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <div class="rg-ing__center" aria-hidden="true">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 800
            | image_tag: widths: '400, 600, 800', sizes: '300px', loading: 'lazy', alt: '', class: 'rg-ing__image'
          }}
        {%- endif -%}
      </div>

      <ul class="rg-ing__list rg-ing__list--right" role="list">
        {%- for block in section.blocks offset: left_count -%}
          <li>
            <button type="button" class="rg-ing__item" data-rg-open="{{ forloop.index0 | plus: left_count }}" aria-haspopup="dialog">
              <span class="rg-ing__item-copy">
                <span class="rg-ing__name">{{ block.settings.name | escape }}</span>
                <span class="rg-ing__dose">{{ block.settings.dose | escape }}</span>
                <span class="rg-ing__sub">{{ block.settings.sub | escape }}</span>
              </span>
              <span class="rg-ing__plus">{{ plus_icon }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Mobile: one 2-column list {%- endcomment -%}
    <ul class="rg-ing__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <button type="button" class="rg-ing__item" data-rg-open="{{ forloop.index0 }}" aria-haspopup="dialog">
            <span class="rg-ing__item-copy">
              <span class="rg-ing__name">{{ block.settings.name | escape }}</span>
              <span class="rg-ing__dose">{{ block.settings.dose | escape }}</span>
            </span>
            <span class="rg-ing__plus">{{ plus_icon }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.button_label != blank -%}
      <div class="rg-ing__cta">
        <a class="rg-btn rg-ing__button" href="{{ button_link }}">
          {{- s.button_label | escape }} <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      <dialog class="rg-ing__dialog" aria-label="{{ s.heading | escape }}">
        <div class="rg-ing__modal">
          {%- for block in section.blocks -%}
            {%- assign num = forloop.index | prepend: '0' | slice: -2, 2 -%}
            {%- assign count = total | prepend: '0' | slice: -2, 2 -%}
            <article class="rg-ing__panel" data-rg-panel="{{ forloop.index0 }}" hidden>
              <div class="rg-ing__photo">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1100
                    | image_tag:
                      widths: '450, 750, 1100',
                      sizes: '(min-width: 990px) 560px, 100vw',
                      loading: 'lazy',
                      alt: block.settings.name
                  }}
                {%- endif -%}
              </div>
              <div class="rg-ing__body">
                <div class="rg-ing__scroll">
                  <p class="rg-ing__num">INGREDIENT {{ num }} / {{ count }}</p>
                  <h3 class="rg-ing__modal-title">{{ block.settings.name | escape }}</h3>
                  {%- if block.settings.dose != blank -%}
                    <p class="rg-ing__pill">{{ block.settings.dose | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.sub != blank -%}
                    <p class="rg-ing__modal-sub">{{ block.settings.sub | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="rg-ing__modal-text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
                <div class="rg-ing__nav">
                  <button type="button" class="rg-ing__nav-btn" data-rg-prev>‹ PREV</button>
                  <span class="rg-ing__counter">{{ forloop.index }} / {{ total }}</span>
                  <button type="button" class="rg-ing__nav-btn rg-ing__nav-btn--next" data-rg-next>NEXT ›</button>
                </div>
              </div>
            </article>
          {%- endfor -%}
          <button type="button" class="rg-ing__close" data-rg-close aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </dialog>
    {%- endif -%}
  </rg-ingredients>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-ing {
    padding-block: 32px;
    background: var(--rg-bg);
  }

  .rg-ing p,
  .rg-ing h2,
  .rg-ing h3 {
    margin: 0;
  }

  .rg-ing ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ing__wrap {
    display: block;
  }

  .rg-ing__intro {
    display: grid;
    grid-template-columns: 44% minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    margin-left: -14px;
  }

  .rg-ing__media {
    position: relative;
    aspect-ratio: 3 / 4;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 62%, transparent 100%);
  }

  .rg-ing__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .rg-ing__media .rg-ing__image {
    transform: scale(1.15);
  }

  .rg-ing__head {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  .rg-ing__eyebrow {
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.3em;
    color: var(--rg-accent);
  }

  .rg-ing__title {
    font-family: var(--rg-font-display);
    font-size: 25px;
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-ink);
  }

  .rg-ing__lead,
  .rg-ing__lead p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--rg-ink);
    text-wrap: pretty;
  }

  .rg-ing__fact {
    font-size: 12px;
    line-height: 1.4;
    color: var(--rg-text-2);
  }

  .rg-ing__fact strong,
  .rg-ing__fact b {
    color: var(--rg-ink);
  }

  .rg-ing__cols {
    display: none;
  }

  .rg-ing__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 14px;
    margin-top: 14px;
  }

  .rg-ing__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
    padding: 7px 0 0;
    border: 0;
    border-top: 1px solid var(--rg-line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .rg-ing__item:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: 2px;
  }

  .rg-ing__item-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .rg-ing__name {
    font-family: var(--rg-font-display);
    font-size: 11px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--rg-ink);
    transition: color 0.25s;
  }

  .rg-ing__dose {
    margin-top: 6px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--rg-accent);
  }

  .rg-ing__sub {
    display: none;
  }

  .rg-ing__plus {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #f2f2f2;
    color: var(--rg-accent);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }

  .rg-ing__plus svg {
    width: 12px;
    height: 12px;
  }

  .rg-ing__cta {
    margin-top: 16px;
  }

  .rg-ing .rg-ing__button {
    width: 100%;
  }

  /* Dialog (mobile: full screen) */
  .rg-ing__dialog {
    width: 100%;
    max-width: 430px;
    height: 100%;
    max-height: none;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: var(--rg-white);
    color: var(--rg-ink);
  }

  .rg-ing__dialog::backdrop {
    background: rgba(26, 26, 26, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .rg-ing__modal {
    position: relative;
    height: 100%;
  }

  .rg-ing__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .rg-ing__panel[hidden] {
    display: none;
  }

  .rg-ing__photo {
    position: relative;
    flex: none;
    height: 30dvh;
    background: var(--rg-bg);
  }

  .rg-ing__photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-ing__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .rg-ing__scroll {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 9px;
    min-height: 0;
    padding: 18px 20px 12px;
    overflow: auto;
  }

  .rg-ing__num {
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.3em;
    color: var(--rg-accent);
  }

  .rg-ing__modal-title {
    font-family: var(--rg-font-body);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--rg-ink);
  }

  .rg-ing__pill {
    align-self: flex-start;
    padding: 7px 12px;
    border-radius: 999px;
    background: #f2f2f2;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .rg-ing__modal-sub {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .rg-ing__modal-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--rg-text-2);
    text-wrap: pretty;
  }

  .rg-ing__nav {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 20px;
    padding: 10px 0 16px;
    border-top: 1px solid var(--rg-line);
  }

  .rg-ing__nav-btn {
    display: flex;
    align-items: center;
    height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: #f2f2f2;
    color: var(--rg-ink);
    font: 700 12px/1 var(--rg-font-body);
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.3s;
  }

  .rg-ing__nav-btn--next {
    background: var(--rg-accent);
  }

  .rg-ing__nav-btn:hover {
    background: var(--rg-accent);
  }

  .rg-ing__counter {
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--rg-text-3);
  }

  .rg-ing__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rg-graphite);
    color: var(--rg-on-dark);
    cursor: pointer;
  }

  .rg-ing__close:focus-visible,
  .rg-ing__nav-btn:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 2px;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-ing {
      padding-block: 56px;
    }

    .rg-ing__intro {
      display: block;
      margin: 0;
    }

    .rg-ing__media,
    .rg-ing__grid {
      display: none;
    }

    .rg-ing__head {
      align-items: center;
      gap: 14px;
      text-align: center;
    }

    .rg-ing__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-ing__title {
      font-size: 46px;
      line-height: 1.04;
    }

    .rg-ing__lead,
    .rg-ing__lead p {
      max-width: 820px;
      font-size: 16px;
      line-height: 1.5;
      text-wrap: balance;
    }

    .rg-ing__fact {
      font-size: 15px;
      line-height: 1.5;
    }

    .rg-ing__cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 300px) minmax(0, 1fr);
      align-items: stretch;
      gap: 40px;
      margin-top: 24px;
    }

    .rg-ing__list {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
    }

    .rg-ing__list--right .rg-ing__item {
      flex-direction: row-reverse;
      text-align: right;
    }

    .rg-ing__item {
      gap: 16px;
      padding-top: 9px;
    }

    .rg-ing__name {
      font-size: 17px;
      letter-spacing: 0.02em;
    }

    .rg-ing__dose {
      margin-top: 5px;
      font-size: 13px;
      letter-spacing: 0.14em;
    }

    .rg-ing__sub {
      display: block;
      margin-top: 3px;
      font-size: 14px;
      line-height: 1.4;
      color: var(--rg-text-2);
    }

    .rg-ing__plus {
      width: 32px;
      height: 32px;
    }

    .rg-ing__plus svg {
      width: 14px;
      height: 14px;
    }

    .rg-ing__item:hover .rg-ing__name,
    .rg-ing__item:focus-visible .rg-ing__name {
      color: var(--rg-accent-dark);
    }

    .rg-ing__item:hover .rg-ing__plus,
    .rg-ing__item:focus-visible .rg-ing__plus {
      background: var(--rg-accent);
      color: var(--rg-ink);
      transform: rotate(90deg);
    }

    .rg-ing__center {
      position: relative;
      align-self: center;
      aspect-ratio: 3 / 4;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
      mask-composite: intersect;
    }

    .rg-ing__cta {
      display: flex;
      justify-content: center;
      margin-top: 28px;
    }

    .rg-ing .rg-ing__button {
      width: auto;
      min-height: 66px;
      padding: 0 48px;
    }

    /* Dialog: centered two-column card */
    .rg-ing__dialog {
      width: calc(100% - 96px);
      max-width: 1120px;
      height: min(680px, calc(100vh - 64px));
      margin: auto;
      border-radius: 32px;
      box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.55);
    }

    .rg-ing__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 100%;
    }

    .rg-ing__photo {
      height: auto;
      min-height: 0;
    }

    .rg-ing__scroll {
      gap: 20px;
      padding: 56px 56px 24px;
    }

    .rg-ing__num {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-ing__modal-title {
      padding-right: 56px;
      font-size: 34px;
      line-height: 1.1;
    }

    .rg-ing__pill {
      padding: 12px 20px;
      font-size: 15px;
    }

    .rg-ing__modal-sub {
      font-size: 20px;
    }

    .rg-ing__modal-text {
      font-size: 17px;
      line-height: 1.6;
    }

    .rg-ing__nav {
      gap: 16px;
      margin: 0 56px;
      padding: 20px 0 32px;
    }

    .rg-ing__nav-btn {
      height: 52px;
      padding: 0 26px;
      font-size: 14px;
    }

    .rg-ing__nav-btn--next {
      background: #f2f2f2;
    }

    .rg-ing__counter {
      font-size: 14px;
    }

    .rg-ing__close {
      top: 24px;
      right: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-ing__plus,
    .rg-ing__name,
    .rg-ing__nav-btn {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* RAW GRAVITY · ingredients modal (native <dialog>, prev/next, backdrop click). */
  if (!customElements.get('rg-ingredients')) {
    customElements.define(
      'rg-ingredients',
      class RgIngredients extends HTMLElement {
        connectedCallback() {
          this.dialog = this.querySelector('dialog');
          this.panels = Array.from(this.querySelectorAll('[data-rg-panel]'));
          this.index = 0;
          this.onClick = this.onClick.bind(this);
          this.onKeydown = this.onKeydown.bind(this);
          this.addEventListener('click', this.onClick);
          this.dialog?.addEventListener('keydown', this.onKeydown);
        }

        disconnectedCallback() {
          this.removeEventListener('click', this.onClick);
          this.dialog?.removeEventListener('keydown', this.onKeydown);
        }

        onClick(event) {
          const open = event.target.closest('[data-rg-open]');
          if (open) {
            this.opener = open;
            this.show(Number(open.dataset.rgOpen));
            return;
          }
          if (!this.dialog?.open) return;
          if (event.target === this.dialog || event.target.closest('[data-rg-close]')) this.close();
          else if (event.target.closest('[data-rg-prev]')) this.show(this.index - 1);
          else if (event.target.closest('[data-rg-next]')) this.show(this.index + 1);
        }

        onKeydown(event) {
          if (event.key === 'ArrowRight') this.show(this.index + 1);
          if (event.key === 'ArrowLeft') this.show(this.index - 1);
        }

        show(index) {
          if (!this.dialog || !this.panels.length) return;
          const count = this.panels.length;
          this.index = ((index % count) + count) % count;
          this.panels.forEach((panel, i) => {
            panel.hidden = i !== this.index;
          });
          if (!this.dialog.open) {
            this.dialog.showModal();
            /* Horizon's own scroll lock: on desktop .page-wrapper is the scroll container */
            document.documentElement.setAttribute('scroll-lock', '');
            this.dialog.addEventListener(
              'close',
              () => {
                document.documentElement.removeAttribute('scroll-lock');
                this.opener?.focus();
              },
              { once: true }
            );
          }
        }

        close() {
          this.dialog?.close();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "RG · Ingredients",
  "class": "rg-ing-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "ingredients",
      "info": "Used by links such as /#ingredients."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center photo",
      "info": "Shown with multiply blending on a light background."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NOOTROPICS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nootropics For Your Mind"
    },
