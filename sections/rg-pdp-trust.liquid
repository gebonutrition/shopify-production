{%- comment -%}
  RAW GRAVITY · Product page "Why people trust Raw Gravity" (6 icon cards, numbered).
  Desktop: 3 x 2 grid. Mobile: one column.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "10 Quality & Trust".
{%- endcomment -%}
{%- assign s = section.settings -%}

<section class="rg rg-ptrust">
  <div class="rg-pdp-wrap">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow rg-ptrust__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="rg-pdp-h2 rg-ptrust__title">{{ s.heading | escape }}</h2>
    {%- if s.text != blank -%}
      <p class="rg-pdp-lead rg-ptrust__text">{{ s.text | escape }}</p>
    {%- endif -%}

    <ul class="rg-ptrust__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="rg-ptrust__card" {{ block.shopify_attributes }}>
          <span class="rg-ptrust__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- if block.settings.icon != blank -%}
            {{
              block.settings.icon
              | image_url: width: 168
              | image_tag: widths: '112, 168', sizes: '56px', loading: 'lazy', alt: '', class: 'rg-ptrust__icon'
            }}
          {%- endif -%}
          <span class="rg-ptrust__copy">
            <span class="rg-ptrust__card-title">{{ block.settings.title | escape }}</span>
            <span class="rg-ptrust__card-text">{{ block.settings.text | escape }}</span>
          </span>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-ptrust {
    background: var(--rg-white);
  }

  .rg-ptrust__eyebrow,
  .rg-ptrust__title,
  .rg-ptrust__text {
    text-align: center;
  }

  .rg-ptrust .rg-ptrust__text {
    margin: 14px 0 24px;
  }

  .rg-ptrust__grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ptrust__card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    overflow: hidden;
    padding: 16px;
    border: 1px solid var(--rg-line-2);
    border-radius: 16px;
    background: linear-gradient(160deg, #ffffff 0%, #f6f6f8 100%);
    transition: transform 0.25s var(--rg-ease), box-shadow 0.25s var(--rg-ease), border-color 0.25s var(--rg-ease);
  }

  .rg-ptrust__card:hover {
    border-color: var(--rg-accent);
    box-shadow: 0 18px 40px rgba(28, 203, 245, 0.18);
    transform: translateY(-6px);
  }

  .rg-ptrust__num {
    position: absolute;
    right: -4px;
    bottom: -18px;
    color: rgba(28, 203, 245, 0.07);
    font-size: 72px;
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }

  .rg-ptrust__icon {
    display: block;
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .rg-ptrust__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .rg-ptrust__card-title {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.25;
  }

  .rg-ptrust__card-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--rg-text-2);
  }

  @media screen and (min-width: 990px) {
    .rg-ptrust .rg-ptrust__title {
      margin-bottom: 12px;
    }

    .rg-ptrust .rg-ptrust__text {
      margin: 0 0 22px;
    }

    .rg-ptrust__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .rg-ptrust__card {
      align-items: center;
      gap: 16px;
      padding: 18px 20px;
      border-radius: 20px;
    }

    .rg-ptrust__card:hover {
      transform: translateY(-4px);
    }

    .rg-ptrust__num {
      right: -6px;
      bottom: -24px;
      font-size: 96px;
    }

    .rg-ptrust__card-title {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-ptrust__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Trust cards (PDP)",
  "class": "rg-ptrust-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUALITY & TRUST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY PEOPLE TRUST RAW GRAVITY"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY RAW COFFEE →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Trust card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Third-Party Lab Tested"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "RG · Trust cards (PDP)",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
