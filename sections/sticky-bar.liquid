<style>
  .rg-map-wrap {
    background: #393939;
    padding: 128px 56px;
    position: relative; overflow: hidden;
  }
  .rg-map-wrap::before {
    content: ''; position: absolute;
    width: 900px; height: 900px;
    background: radial-gradient(circle, rgba(30,207,251,0.06) 0%, transparent 65%);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .rg-map-inner { max-width: 1400px; margin: 0 auto; position: relative; }
  .rg-map-head { text-align: center; margin-bottom: 24px; }
  .rg-map-eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(30,207,251,0.65); margin-bottom: 4px; display: block;
  }
  .rg-map-head h2 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 800; text-transform: none;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.01em; color: #F5F0EB;
    margin-bottom: 13px;
  }
  .rg-map-head p {
    font-size: 15px; font-weight: 300;
    color: rgba(240,234,224,0.42); max-width: 480px; margin: 0 auto;
  }

  .rg-map-svg-wrap { position: relative; width: 100%; }
  #rg-map-d3-wrap {
    width: 100%;
    opacity: 0; transform: translateY(24px);
    transition: opacity 1.1s cubic-bezier(0.4,0,0.2,1), transform 1.1s cubic-bezier(0.4,0,0.2,1);
    position: relative;
  }
  #rg-map-d3-wrap.map-in { opacity: 1; transform: none; }

  @keyframes rgDotPulse {
    0%,100% { opacity: .7; r: 4px; }
    50%      { opacity: 1;  r: 5.5px; }
  }
  @keyframes rgRingPulse {
    0%   { r: 4px;  opacity: .5; }
    70%  { r: 18px; opacity: 0; }
    100% { r: 4px;  opacity: 0; }
  }
  .rg-d3-city { opacity: 0; transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1); cursor: default; }
  .rg-d3-city.dot-in { opacity: 1; }
  .rg-d3-city.dot-in .rg-d3-dot-core { animation: rgDotPulse 2.8s ease-in-out infinite; }
  .rg-d3-city.dot-in .rg-d3-dot-ring { animation: rgRingPulse 2.8s ease-in-out infinite; }
  .rg-d3-dot-core { fill: #1ecffb; }
.rg-d3-dot-ring { fill: none; stroke: #1ecffb; stroke-width: 1; }
.rg-d3-city[data-has-tip] .rg-d3-dot-core { fill: #ffffff; }
.rg-d3-city[data-has-tip] .rg-d3-dot-ring { stroke: #ffffff; }
  .rg-d3-city-label {
    font-family: 'Inter', sans-serif; font-size: 10px;
    fill: rgba(30,207,251,0.8); letter-spacing: 0.05em;
  }

  #rg-usa-map-tilt {
  width: 76%;
  margin: 0 auto;
  transform-style: preserve-3d;
  will-change: transform;
  transition: transform 0.5s ease;
}
  #rg-usa-svg { width: 100%; height: auto; display: block; }
  .rg-usa-state { fill: rgba(30,207,251,0.06); stroke: rgba(30,207,251,0.2); stroke-width: 0.5; }
  .rg-usa-state-border { fill: none; stroke: rgba(30,207,251,0.16); stroke-width: 0.4; }

  .rg-map-stats { display: flex; justify-content: center; gap: 96px; margin-top: 24px; }
  .rg-ms-n {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 3.4rem; color: #F5F0EB;
    letter-spacing: -0.02em; text-align: center;
    font-weight: 800;
  }
  #rg-map-tooltip {
  position: fixed; z-index: 999; pointer-events: none;
  opacity: 0; transition: opacity 0.2s ease;
  transform: translate(-50%, -110%); max-width: 260px;
}
#rg-map-tooltip.rg-tip-visible { opacity: 1; }
.rg-map-tip-text {
  background: #232323; border-radius: 14px; padding: 18px 20px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.45);
  width: 220px; box-sizing: border-box;
}
.rg-map-tip-text p { font-size: 13px; line-height: 1.5; margin: 0 0 8px; color: rgba(255,255,255,0.92); }
.rg-map-tip-name { font-size: 11px; font-weight: 700; color: var(--rg-accent); text-transform: uppercase; letter-spacing: 0.04em; }
.rg-map-tip-photo {
  background: #232323; border-radius: 14px; overflow: hidden; width: 220px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.45);
}
.rg-map-tip-photo img { width: 100%; height: 120px; object-fit: cover; display: block; }
.rg-map-tip-photo-body { padding: 14px 16px; }
.rg-map-tip-photo-body p { font-size: 12px; line-height: 1.5; margin: 0 0 6px; color: rgba(255,255,255,0.92); }

  .rg-ms-l {
    font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(240,234,224,0.4); margin-top: 3px; text-align: center;
  }

  @media (max-width: 768px) {
    .rg-map-wrap { padding: 64px 24px; }
    .rg-map-stats { gap: 48px; }
  }
</style>

<section class="rg-map-wrap" id="map" style="padding-top: 40px;">
  <div class="rg-map-inner">
    <div class="rg-map-head">
      <span class="rg-map-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div id="rg-map-d3-wrap" class="rg-map-svg-wrap">
      <div id="rg-usa-map-tilt">
        <svg id="rg-usa-svg" viewBox="0 0 900 520" preserveAspectRatio="xMidYMid meet">
          <defs>
            <filter id="rg-dot-glow-usa">
              <feGaussianBlur stdDeviation="2" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <g id="rg-usa-states"></g>
          <g id="rg-usa-cities-detail"></g>
        </svg>
        <div id="rg-map-tooltip"><div id="rg-map-tooltip-inner"></div></div>
      </div>
    </div>

    <div class="rg-map-stats">
      <div>
        <div class="rg-ms-n">{{ section.settings.stat1_number }}</div>
        <div class="rg-ms-l">{{ section.settings.stat1_label }}</div>
      </div>
      <div>
        <div class="rg-ms-n">{{ section.settings.stat2_number }}</div>
        <div class="rg-ms-l">{{ section.settings.stat2_label }}</div>
      </div>
      <div>
        <div class="rg-ms-n">{{ section.settings.stat3_number }}</div>
        <div class="rg-ms-l">{{ section.settings.stat3_label }}</div>
      </div>
    </div>
  </div>
</section>

