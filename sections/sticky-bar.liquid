            <div class="rg-map-tip-text">
              <p>"${d.tip.quote}"</p>
              <span class="rg-map-tip-name">${d.tip.author}</span>
            </div>`;
        }
        const dotRect = this.getBoundingClientRect();
        tooltip.style.left = (dotRect.left + dotRect.width / 2 - 80) + 'px';
        tooltip.style.top = (dotRect.top + dotRect.height / 2) + 'px';
        tooltip.classList.add('rg-tip-visible');
      })
      .on('mouseleave', function () {
        document.getElementById('rg-map-tooltip').classList.remove('rg-tip-visible');
      });
    usaGroups.filter(d => d.label)
      .append('text').attr('class','rg-d3-city-label').attr('x',d=>d.lx).attr('y',d=>d.ly).text(d=>d.name);

    const wrap = document.getElementById('rg-map-d3-wrap');
    let triggered = false;
    new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !triggered) {
          triggered = true;
          wrap.classList.add('map-in');
          document.querySelectorAll('#rg-usa-cities-detail .rg-d3-city').forEach((el,i) => {
            setTimeout(() => el.classList.add('dot-in'), 900 + i * 40);
          });
        }
      });
    }, { threshold: 0.25 }).observe(wrap);

    // 3D tilt-on-mouse disabled

  } catch (err) { console.error('Map error:', err); }
})();
</script>

