<header class="rg-header" role="banner">
  <div class="rg-container">
    <div class="rg-header__inner rg-header__inner--3col" style="height: 64px;">

      <nav class="rg-nav" role="navigation" style="margin-left: -200px;">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="rg-nav__link">{{ link.title }}</a>
        {%- else -%}
          <a href="/collections/all" class="rg-nav__link">Shop</a>
          <a href="/pages/about" class="rg-nav__link">About</a>
          <a href="/pages/science" class="rg-nav__link">Science</a>
        {%- endfor -%}
      </nav>

      <a href="/" class="rg-header__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: height: 200 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo.width }}"
            height="40"
            loading="eager"
            style="height: 26px; width: auto; display: block;"
          >
        {%- else -%}
          <img
            src="{{ 'raw-gravity-logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            width="170"
            height="40"
            loading="eager"
          >
        {%- endif -%}
      </a>

      <div class="rg-header__actions" style="margin-right: -200px;">
        <a href="{{ routes.search_url }}" class="rg-icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </a>
        <a href="{{ routes.account_url }}" class="rg-icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        <a href="{{ routes.cart_url }}" class="rg-icon-btn rg-icon-btn--cart" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="rg-cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
