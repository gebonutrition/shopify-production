{%- comment -%}
  RAW GRAVITY · FAQ ("Questions & Answers"), v2.
  Exclusive accordion with native <details name> (no JS); one name across both columns.
  Desktop: two columns (first half of the questions left), zoomed through .rg-z. Mobile: one column.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#faq (2026-11 update).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign accordion_name = 'rg-faq-' | append: section.id
  assign button_link = s.button_link | default: '/#contact'
  assign left_count = section.blocks.size | plus: 1 | divided_by: 2
-%}

<section
  class="rg rg-z rg-faq"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-faq__wrap">
    <div class="rg-faq__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-faq__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-faq__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="rg-faq__list">
      {%- for column in (1..2) -%}
        <div class="rg-faq__col">
          {%- for block in section.blocks -%}
            {%- liquid
              assign in_column = false
              if column == 1 and forloop.index <= left_count
                assign in_column = true
              elsif column == 2 and forloop.index > left_count
                assign in_column = true
              endif
            -%}
            {%- if in_column -%}
              <details
                class="rg-faq__item"
                name="{{ accordion_name }}"
                {% if forloop.first and s.open_first %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="rg-faq__q">
                  <span>{{ block.settings.question | escape }}</span>
                  <span class="rg-faq__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                  </span>
                </summary>
                <div class="rg-faq__a">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.button_label != blank -%}
      <div class="rg-faq__more">
        {%- if s.more_text != blank -%}
          <p class="rg-faq__more-text">{{ s.more_text | escape }}</p>
        {%- endif -%}
        <a class="rg-faq__button" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile, section#faq) ---------- */
  .rg-faq {
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .rg-faq p,
  .rg-faq h2 {
    margin: 0;
  }

  .rg-faq__wrap {
    padding: 36px 20px;
  }

  .rg-faq__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .rg-faq .rg-faq__eyebrow {
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-faq .rg-faq__title {
    font: 900 clamp(26px, 3.436svh, 33px) / 1.04 var(--rg-font-body);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .rg-faq__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 16px;
  }

  .rg-faq__col {
    display: contents;
  }

  .rg-faq__item {
    overflow: hidden;
    border-radius: 18px;
    background: var(--rg-white);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 24px 60px -28px rgba(26, 26, 26, 0.14);
  }

  .rg-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 12px 11px 16px;
    font: 700 13.5px/1.3 var(--rg-font-body);
    cursor: pointer;
    list-style: none;
  }

  .rg-faq__q::-webkit-details-marker {
    display: none;
  }

  .rg-faq__q:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: -2px;
  }

  .rg-faq__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f2f2f2;
    color: var(--rg-ink);
    transition: transform 0.3s var(--rg-ease);
  }

  .rg-faq__icon svg {
    width: 16px;
    height: 16px;
  }

  .rg-faq__item[open] .rg-faq__icon {
    transform: rotate(180deg);
  }

  .rg-faq__a {
    padding: 0 16px 16px;
    font: 400 clamp(13px, 1.777svh, 16px) / 1.55 var(--rg-font-body);
    color: #555555;
    text-wrap: pretty;
  }

  .rg-faq__a p {
    margin: 0;
  }

  .rg-faq__a p + p {
    margin-top: 0.6em;
  }

  .rg-faq__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .rg-faq .rg-faq__more-text {
    font: 400 clamp(12px, 1.659svh, 16px) / 1 var(--rg-font-body);
    color: #555555;
  }

  .rg-faq__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: fit-content;
    min-width: 50%;
    min-height: 50px;
    margin: 0 auto;
    padding: 0 12px;
    border-radius: 12px;
    background: var(--rg-accent);
    box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
    color: var(--rg-ink);
    font: 800 clamp(13px, 1.777svh, 17px) / 1 var(--rg-font-body);
    letter-spacing: 0.1em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.2s;
  }

  .rg-faq__button:hover {
    color: var(--rg-ink);
    filter: brightness(1.05);
  }

  .rg-faq__button:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 3px;
  }

  /* ---------- Desktop (Raw Gravity Landing, section#faq; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-faq {
      --rg-faq-vh: calc(100vh / var(--rg-z, 1));
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
    }

    .rg-faq__wrap {
      width: 100%;
      max-width: calc(1280px + 96px);
      margin: 0 auto;
      padding: clamp(45px, calc(var(--rg-faq-vh) * 0.0622), 67px) 48px;
    }

    .rg-faq__head {
      gap: 24px;
    }

    .rg-faq .rg-faq__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-faq .rg-faq__title {
      font-size: clamp(37px, calc(var(--rg-faq-vh) * 0.0511), 55px);
    }

    .rg-faq__list {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 10px 20px;
      align-items: start;
      margin-top: 28px;
    }

    .rg-faq__col {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 0;
    }

    .rg-faq__item {
      border-radius: 20px;
    }

    .rg-faq__q {
      gap: 20px;
      height: clamp(76px, calc((var(--rg-faq-vh) - 76px) * 0.115), 118px);
      padding: 0 28px;
      font-size: 16px;
    }

    .rg-faq__icon {
      width: 34px;
      height: 34px;
    }

    .rg-faq__icon svg {
      width: 18px;
      height: 18px;
    }

    .rg-faq__a {
      padding: 0 28px 20px;
      font-size: 17px;
      line-height: 1.6;
    }

    .rg-faq__more {
      flex-direction: row;
      justify-content: center;
      gap: 20px;
      margin-top: 24px;
    }

    .rg-faq .rg-faq__more-text {
      font-size: 17px;
      line-height: 1.5;
    }

    .rg-faq__button {
      gap: 12px;
      width: auto;
      min-width: 0;
      min-height: 66px;
      margin: 0;
      padding: 0 48px;
      font-size: 17px;
    }

    .rg-faq__button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(28, 203, 245, 0.42);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-faq__icon,
    .rg-faq__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · FAQ",
  "class": "rg-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq",
      "info": "Used by links such as /#faq."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions & Answers"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Text before button",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CONTACT US →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to /#contact (footer)."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What does mushroom coffee taste like?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Like a smooth cup of classic Arabica coffee with a light, earthy note.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RG · FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
