{%- comment -%}
  RAW GRAVITY · FAQ ("Questions & Answers")
  Exclusive accordion with native <details name> (no JS), first item open.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#faq.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign accordion_name = 'rg-faq-' | append: section.id
  assign button_link = s.button_link | default: '/#contact'
-%}

<section
  class="rg rg-faq"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-container">
    <div class="rg-faq__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-faq__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-faq__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="rg-faq__list">
      {%- for block in section.blocks -%}
        <details
          class="rg-faq__item"
          name="{{ accordion_name }}"
          {% if forloop.first and s.open_first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="rg-faq__q">
            <span>{{ block.settings.question | escape }}</span>
            <span class="rg-faq__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="rg-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if s.button_label != blank -%}
      <div class="rg-faq__more">
        {%- if s.more_text != blank -%}
          <p class="rg-faq__more-text">{{ s.more_text | escape }}</p>
        {%- endif -%}
        <a class="rg-btn rg-faq__button" href="{{ button_link }}">
          {{- s.button_label | escape }} <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-faq {
    padding-block: 36px;
    background: var(--rg-bg);
  }

  .rg-faq p,
  .rg-faq h2 {
    margin: 0;
  }

  .rg-faq__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .rg-faq__eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-faq__title {
    font-family: var(--rg-font-display);
    font-size: 29px;
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-ink);
  }

  .rg-faq__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 16px;
  }

  .rg-faq__item {
    overflow: hidden;
    border-radius: 18px;
    background: var(--rg-white);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 24px 60px -28px rgba(26, 26, 26, 0.14);
  }

  .rg-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 12px 11px 16px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--rg-ink);
    cursor: pointer;
    list-style: none;
  }

  .rg-faq__q::-webkit-details-marker {
    display: none;
  }

  .rg-faq__q:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: -2px;
    border-radius: 18px;
  }

  .rg-faq__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f2f2f2;
    color: var(--rg-ink);
    transition: transform 0.3s var(--rg-ease);
  }

  .rg-faq__icon svg {
    width: 16px;
    height: 16px;
  }

  .rg-faq__item[open] .rg-faq__icon {
    transform: rotate(180deg);
  }

  .rg-faq__a,
  .rg-faq__a p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--rg-text-2);
    text-wrap: pretty;
  }

  .rg-faq__a {
    padding: 0 16px 16px;
  }

  .rg-faq__a p + p {
    margin-top: 8px;
  }

  .rg-faq__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .rg-faq__more-text {
    font-size: 14px;
    line-height: 1;
    color: var(--rg-text-2);
  }

  .rg-faq .rg-faq__button {
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .rg-faq {
      padding-block: 56px;
    }

    .rg-faq__head {
      gap: 24px;
    }

    .rg-faq__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-faq__title {
      font-size: 46px;
    }

    .rg-faq__list {
      gap: 8px;
      max-width: 960px;
      margin: 28px auto 0;
    }

    .rg-faq__item {
      border-radius: 20px;
    }

    .rg-faq__q {
      gap: 20px;
      padding: 13px 24px;
      font-size: 16px;
    }

    .rg-faq__q:focus-visible {
      border-radius: 20px;
    }

    .rg-faq__icon {
      width: 34px;
      height: 34px;
    }

    .rg-faq__icon svg {
      width: 18px;
      height: 18px;
    }

    .rg-faq__a,
    .rg-faq__a p {
      font-size: 16px;
    }

    .rg-faq__a {
      padding: 0 28px 20px;
    }

    .rg-faq__more {
      flex-direction: row;
      justify-content: center;
      gap: 20px;
      margin-top: 24px;
    }

    .rg-faq__more-text {
      font-size: 17px;
      line-height: 1.5;
    }

    .rg-faq .rg-faq__button {
      width: auto;
      min-height: 66px;
      padding: 0 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-faq__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · FAQ",
  "class": "rg-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq",
      "info": "Used by links such as /#faq."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions & Answers"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Text before button",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to /#contact (footer)."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What does mushroom coffee taste like?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Like a smooth cup of classic Arabica coffee with a light, earthy note.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RG · FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
