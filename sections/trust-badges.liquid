<section class="rg-section rg-trust" style="background: #2a2a2a; padding-top: 24px; padding-bottom: 18px;">
  <div class="rg-container">

    <div class="rg-text-center rg-trust__head">
      <span class="rg-eyebrow rg-eyebrow--cyan">{{ section.settings.eyebrow }}</span>
      <h2 class="rg-trust__heading" style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; text-transform: none; font-size: clamp(2.2rem, 3.8vw, 3rem);">{{ section.settings.heading }}</h2>
    </div>

    <div class="rg-trust__badges">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="rg-trust__badge" {{ block.shopify_attributes }} style="background: transparent; border: none; padding: 0;">
  {%- if block.settings.image != blank -%}
    <img
  src="{{ block.settings.image | image_url: width: 400 }}"
  alt="{{ block.settings.label }}"
  width="400"
  height="440"
  loading="lazy"
  style="width: 100%; height: auto; aspect-ratio: 1 / 1.1; object-fit: cover; object-position: center; display: block; margin-bottom: 14px; border-radius: 12px;"
>
  {%- endif -%}
  <span class="rg-trust__badge-label" style="display: block; text-align: center; color: #fff;">{{ block.settings.label }}</span>
</div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Quality & Trust" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Uncompromising Standards" },
    { "type": "text", "id": "featured_label", "label": "Featured label", "default": "As Featured In" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flask", "label": "Lab flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield check" },
            { "value": "ribbon", "label": "Ribbon award" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "refresh", "label": "Refresh / guarantee" }
          ],
          "default": "flask"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Third-Party Tested" },
        { "type": "text", "id": "description", "label": "Description", "default": "Every batch independently verified" }
      ]
    },
    {
      "type": "media_logo",
      "name": "Media Logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication Name", "default": "Forbes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "flask", "label": "Third-Party Tested", "description": "Every batch independently verified" } },
        { "type": "badge", "settings": { "icon": "leaf", "label": "100% Vegan", "description": "Plant-based & cruelty-free" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "GMP Certified", "description": "Manufactured to the highest standards" } },
        { "type": "badge", "settings": { "icon": "ribbon", "label": "Clinically Dosed", "description": "Research-backed ingredient amounts" } },
        { "type": "badge", "settings": { "icon": "truck", "label": "Free Shipping", "description": "On all orders over $75" } },
        { "type": "badge", "settings": { "icon": "refresh", "label": "30-Day Guarantee", "description": "Full refund, no questions asked" } },
        { "type": "media_logo", "settings": { "name": "Forbes" } },
        { "type": "media_logo", "settings": { "name": "Men's Health" } },
        { "type": "media_logo", "settings": { "name": "Well+Good" } },
        { "type": "media_logo", "settings": { "name": "Shape" } },
        { "type": "media_logo", "settings": { "name": "GQ" } }
      ]
    }
  ]
}
{% endschema %}
