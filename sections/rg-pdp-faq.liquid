{%- comment -%}
  RAW GRAVITY · Product page FAQ with 2+ tabs ("Taste & everyday use" / "Formula & benefits").
  Questions are grouped into tabs by their "Tab" label; each tab is an exclusive accordion
  (native <details name>), first question open. Tab switching: <rg-tabs> (sections/rg-reviews.liquid).
  Desktop is rendered through .rg-z (assets/rg-base.css).
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "11 FAQ".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign groups = ''
  for block in section.blocks
    assign label = block.settings.group | strip
    if label == blank
      assign label = 'FAQ'
    endif
    assign groups_check = groups | split: '||'
    unless groups_check contains label
      if groups == ''
        assign groups = label
      else
        assign groups = groups | append: '||' | append: label
      endif
    endunless
  endfor
  assign group_list = groups | split: '||'
  assign button_link = s.button_link
  if button_link == blank and shop.email != blank
    assign button_link = 'mailto:' | append: shop.email
  endif
-%}

<script src="{{ 'rg-tabs.js' | asset_url }}" type="module"></script>
<section
  class="rg rg-z rg-pfaq"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap rg-pfaq__wrap">
    {%- if s.eyebrow != blank -%}
      <p class="rg-pdp-eyebrow rg-pfaq__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="rg-pdp-h2 rg-pfaq__title">{{ s.heading | escape }}</h2>

    <rg-tabs class="rg-pfaq__root">
      {%- if group_list.size > 1 -%}
        {%- if s.topic_label != blank -%}
          <p class="rg-pfaq__topic">{{ s.topic_label | escape }}</p>
        {%- endif -%}
        <div class="rg-pfaq__tabs-row">
          <div class="rg-pfaq__tabs" role="tablist" aria-label="{{ s.heading | escape }}">
            {%- for group in group_list -%}
              <button
                type="button"
                class="rg-pfaq__tab"
                role="tab"
                id="rg-pfaq-tab-{{ section.id }}-{{ forloop.index0 }}"
                aria-controls="rg-pfaq-panel-{{ section.id }}-{{ forloop.index0 }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-rg-tab="{{ forloop.index0 }}"
              >
                {%- liquid
                  assign group_size = 0
                  for block in section.blocks
                    assign block_label = block.settings.group | strip
                    if block_label == blank
                      assign block_label = 'FAQ'
                    endif
                    if block_label == group
                      assign group_size = group_size | plus: 1
                    endif
                  endfor
                -%}
                <span>{{ group | escape }}</span>
                <span class="rg-pfaq__count" aria-hidden="true">{{ group_size }}</span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- for group in group_list -%}
        {%- assign group_index = forloop.index0 -%}
        {%- assign accordion_name = 'rg-pfaq-' | append: section.id | append: '-' | append: group_index -%}
        {%- assign first_in_group = true -%}
        <div
          class="rg-pfaq__list"
          role="tabpanel"
          id="rg-pfaq-panel-{{ section.id }}-{{ group_index }}"
          aria-labelledby="rg-pfaq-tab-{{ section.id }}-{{ group_index }}"
          data-rg-panel="{{ group_index }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign label = block.settings.group | strip
              if label == blank
                assign label = 'FAQ'
              endif
            -%}
            {%- if label == group -%}
              <details
                class="rg-pfaq__item"
                name="{{ accordion_name }}"
                {% if first_in_group and s.open_first %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="rg-pfaq__q">
                  <span>{{ block.settings.question | escape }}</span>
                  <svg class="rg-pfaq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="rg-pfaq__a">{{ block.settings.answer }}</div>
              </details>
              {%- assign first_in_group = false -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </rg-tabs>

    {%- if s.button_label != blank -%}
      <div class="rg-pfaq__more">
        {%- if s.more_text != blank -%}
          <p class="rg-pfaq__more-text">{{ s.more_text | escape }}</p>
        {%- endif -%}
        <a class="rg-pdp-cta rg-pfaq__button" id="{{ s.button_anchor | default: 'contact-us' | handle }}" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-pfaq {
    background: var(--rg-bg-2);
  }

  .rg-pfaq .rg-pfaq__eyebrow,
  .rg-pfaq .rg-pfaq__title {
    text-align: center;
  }

  .rg-pfaq .rg-pfaq__title {
    margin-bottom: 0;
  }

  .rg-pfaq__topic {
    display: none;
  }

  .rg-pfaq__tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    padding: 5px;
    border-radius: 14px;
    background: var(--rg-offer);
  }

  .rg-pfaq__tab {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 44px;
    padding: 0 8px;
    border: 0;
    border-radius: 10px;
    background: var(--rg-white);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    color: var(--rg-graphite);
    font: 700 14px/1.2 var(--rg-font-body);
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .rg-pfaq__tab[aria-selected='true'] {
    background: var(--rg-accent);
    box-shadow: 0 0 18px rgba(28, 203, 245, 0.5), 0 6px 20px rgba(28, 203, 245, 0.3);
  }

  .rg-pfaq__tab:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 2px;
  }

  .rg-pfaq__count {
    display: none;
  }

  .rg-pfaq__list:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rg-pfaq__item {
    border: 1px solid var(--rg-line-2);
    border-radius: 14px;
    background: var(--rg-white);
  }

  .rg-pfaq__item[open] {
    border-color: var(--rg-accent);
  }

  .rg-pfaq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 56px;
    padding: 16px;
    color: var(--rg-graphite);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  .rg-pfaq__q:hover {
    color: var(--rg-graphite);
  }

  .rg-pfaq__q::-webkit-details-marker {
    display: none;
  }

  .rg-pfaq__q:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: -2px;
    border-radius: 14px;
  }

  .rg-pfaq__chev {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--rg-accent-dark);
    transition: transform 0.2s;
  }

  .rg-pfaq__item[open] .rg-pfaq__chev {
    transform: rotate(180deg);
  }

  .rg-pfaq__a {
    padding: 0 16px 18px;
    color: var(--rg-text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .rg-pfaq__a p {
    margin: 0;
  }

  .rg-pfaq__a p + p {
    margin-top: 8px;
  }

  .rg-pfaq__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
  }

  .rg-pfaq__more-text {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .rg-pfaq .rg-pfaq__button {
    box-shadow: 0 8px 24px rgba(28, 203, 245, 0.3);
  }

  /* ---------- Desktop (rendered through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-pfaq .rg-pfaq__wrap {
      max-width: 920px;
    }

    .rg-pfaq .rg-pfaq__title {
      margin-bottom: 28px;
    }

    .rg-pfaq__topic {
      display: block;
      margin: 0 0 14px;
      color: var(--rg-text-3);
      font-size: 17px;
      font-weight: 600;
      text-align: center;
    }

    .rg-pfaq__tabs-row {
      display: flex;
      justify-content: center;
      margin-bottom: 40px;
    }

    .rg-pfaq__tabs {
      gap: 12px;
      margin: 0;
      padding: 0;
      border-radius: 0;
      background: none;
    }

    .rg-pfaq__tab {
      flex: none;
      height: 52px;
      padding: 0 26px;
      border: 1.5px solid rgba(28, 203, 245, 0.5);
      border-radius: 999px;
      color: var(--rg-ink);
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .rg-pfaq__tab:hover {
      border-color: var(--rg-accent);
    }

    .rg-pfaq__tab[aria-selected='true'] {
      border-color: var(--rg-accent);
    }

    .rg-pfaq__count {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 24px;
      padding: 0 7px;
      border-radius: 12px;
      background: rgba(28, 203, 245, 0.15);
      color: var(--rg-accent-dark);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0;
    }

    .rg-pfaq__tab[aria-selected='true'] .rg-pfaq__count {
      background: var(--rg-ink);
      color: var(--rg-white);
    }

    .rg-pfaq__list:not([hidden]) {
      gap: 12px;
    }

    .rg-pfaq__item {
      border-radius: 16px;
    }

    .rg-pfaq__q {
      gap: 20px;
      min-height: 0;
      padding: 22px 26px;
      font-size: 18px;
      line-height: normal;
    }

    .rg-pfaq__chev {
      width: 20px;
      height: 20px;
    }

    .rg-pfaq__a {
      padding: 0 26px 24px;
      font-size: 17px;
    }

    .rg-pfaq__more {
      gap: 18px;
      margin-top: 48px;
    }

    .rg-pfaq__more-text {
      font-size: 22px;
    }

    .rg-pfaq .rg-pfaq__button {
      box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
      transition: background 0.2s, color 0.2s;
    }

    .rg-pfaq .rg-pfaq__button:hover {
      filter: none;
      background: var(--rg-ink);
      color: var(--rg-white);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · FAQ tabs (PDP)",
  "class": "rg-pfaq-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUESTIONS & ANSWERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "topic_label",
      "label": "Label above the tabs (desktop)",
      "default": "Choose a topic"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question of each tab",
      "default": true
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Text before button",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CONTACT US →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = email the store's sender address."
    },
    {
      "type": "text",
      "id": "button_anchor",
      "label": "Button anchor ID",
      "default": "contact-us"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Tab",
          "default": "Taste & everyday use",
          "info": "Questions with the same tab label are shown together."
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I prepare it?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add one scoop to 8–12 oz of hot water and stir.</p>"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "RG · FAQ tabs (PDP)",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
