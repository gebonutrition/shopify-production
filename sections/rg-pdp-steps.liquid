{%- comment -%}
  RAW GRAVITY · Product page "How to make" (dark): intro + button on the left, 2 x 2 steps on the right.
  Mobile: intro, 2 x 2 steps, button. A line break in a step text shows on desktop only.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "05 How to prepare".
{%- endcomment -%}
{%- assign s = section.settings -%}

{%- capture steps_cta -%}
  {%- if s.button_label != blank -%}
    <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
  {%- endif -%}
{%- endcapture -%}

<section
  class="rg rg-z rg-steps rg-pdp-dark"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap rg-steps__grid">
    <div class="rg-steps__intro">
      {%- if s.eyebrow != blank -%}
        <p class="rg-pdp-eyebrow rg-steps__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="rg-pdp-h2">{{ s.heading | escape | newline_to_br }}</h2>
      {%- if s.text != blank -%}
        <p class="rg-pdp-lead rg-steps__text">{{ s.text | escape }}</p>
      {%- endif -%}
      {%- if steps_cta != blank -%}
        <div class="rg-steps__cta rg-steps__cta--desktop">{{ steps_cta }}</div>
      {%- endif -%}
    </div>

    <ol class="rg-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="rg-steps__item" {{ block.shopify_attributes }}>
          <div class="rg-steps__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 900, 1200',
                  sizes: '(min-width: 990px) 25vw, 45vw',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {%- endif -%}
          </div>
          <span class="rg-steps__title">{{ block.settings.title | escape }}</span>
          <span class="rg-steps__step-text">{{ block.settings.text | escape | newline_to_br | replace: '<br />', '<br class="rg-br-d">' }}</span>
        </li>
      {%- endfor -%}
    </ol>

    {%- if steps_cta != blank -%}
      <div class="rg-pdp-cta-row rg-steps__cta--mobile">{{ steps_cta }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rg-steps {
    background: radial-gradient(ellipse at 15% 0%, #26464f 0%, #323232 50%, #2e2e2e 100%);
  }

  .rg-steps .rg-steps__grid {
    padding-inline: 0;
  }

  .rg-steps__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 16px;
    padding: 0 16px;
  }

  .rg-steps .rg-steps__eyebrow,
  .rg-steps .rg-steps__text {
    margin: 0;
  }

  .rg-steps__cta--desktop {
    display: none;
  }

  .rg-steps__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0 16px;
    list-style: none;
  }

  .rg-steps__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .rg-steps__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    background: #eceef2;
  }

  .rg-steps__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-steps__title {
    font-size: 10.5px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: var(--rg-on-dark);
  }

  .rg-steps__step-text {
    margin-top: -5px;
    font-size: 10px;
    line-height: 1.45;
    color: var(--rg-on-dark-2);
    text-wrap: pretty;
  }

  .rg-steps .rg-steps__cta--mobile {
    margin-top: 20px;
    padding: 0 16px;
  }

  @media screen and (min-width: 990px) {
    .rg-steps {
      background: radial-gradient(ellipse at 85% 0%, #26464f 0%, #323232 50%, #2e2e2e 100%);
    }

    .rg-steps .rg-steps__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 64px;
      align-items: stretch;
      padding-inline: 40px;
    }

    .rg-steps__intro {
      display: flex;
      align-items: flex-start;
      gap: 0;
      margin: 0;
      padding: 0;
    }

    .rg-steps .rg-steps__eyebrow {
      margin-bottom: 16px;
    }

    .rg-steps .rg-steps__text {
      max-width: 460px;
      margin-top: 20px;
    }

    .rg-steps__cta--desktop {
      display: flex;
      margin-top: 32px;
    }

    .rg-steps__list {
      gap: 28px 18px;
      padding: 0;
    }

    .rg-steps__item {
      gap: 10px;
    }

    .rg-steps__media {
      aspect-ratio: 3 / 2;
      border-radius: 20px;
      background: #3a3a3a;
      box-shadow: 0 0 0 1px rgba(28, 203, 245, 0.25), 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .rg-steps__title {
      font-size: 17px;
      letter-spacing: 0.04em;
      line-height: normal;
    }

    .rg-steps__step-text {
      margin-top: -6px;
      font-size: 17px;
      line-height: 1.5;
    }

    .rg-steps .rg-steps__cta--mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · How to prepare",
  "class": "rg-steps-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "how-to"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW TO MAKE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "YOUR PERFECT CUP\nIN 30 SECONDS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY RAW COFFEE+ →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "STEP ONE · SCOOP"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "A line break shows on desktop only."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "RG · How to prepare",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
