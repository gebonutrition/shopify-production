{%- comment -%}
  RAW GRAVITY · Shop ("Find Your Blend"), light v2.
  Product cards: pick a product (link + image come from it) and override any text.
  Works before the catalog is final: without a product, the card uses its own
  image and link (or All products).
  Desktop: 3 cards (image on top). Mobile: one row per card (image left), no badge.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#shop (2026-11 update).
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="rg rg-z rg-shop"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-shop__wrap">
    <div class="rg-shop__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-shop__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-shop__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="rg-shop__grid" id="products" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign product = b.product
          assign card_image = b.image | default: product.featured_image
          assign card_link = b.link
          if card_link == blank and product != blank
            assign card_link = product.url
          endif
          if card_link == blank
            assign card_link = routes.all_products_collection_url
          endif
          assign card_title = b.title | default: product.title
          assign why_list = b.why | split: '·'
        -%}
        <li class="rg-shop__card" {{ block.shopify_attributes }}>
          <a class="rg-shop__media" href="{{ card_link }}" tabindex="-1" aria-hidden="true">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 900
                | image_tag:
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 420px, 36vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'rg-shop__image'
              }}
            {%- endif -%}
            {%- if b.badge != blank -%}
              <span class="rg-shop__badge">{{ b.badge | escape }}</span>
            {%- endif -%}
          </a>

          <div class="rg-shop__body">
            <div class="rg-shop__names">
              {%- if b.pre != blank -%}
                <p class="rg-shop__pre">{{ b.pre | escape }}</p>
              {%- endif -%}
              <h3 class="rg-shop__name">{{ card_title | escape }}</h3>
              {%- if b.rating != blank -%}
                <p class="rg-shop__rating">
                  <span class="rg-shop__stars" aria-hidden="true">★★★★★</span>
                  <span>{{ b.rating | escape }}<span class="rg-visually-hidden"> out of 5 stars</span></span>
                </p>
              {%- endif -%}
            </div>
            {%- if b.description != blank -%}
              <p class="rg-shop__desc">{{ b.description | escape }}</p>
            {%- endif -%}
            {%- if b.why != blank -%}
              <ul class="rg-shop__why" role="list">
                {%- for item in why_list -%}
                  {%- assign item_text = item | strip -%}
                  {%- if item_text != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                      {{- item_text | escape -}}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <a class="rg-shop__button" href="{{ card_link }}">
              {{- b.button_label | default: 'TRY NOW' | escape }}
              <span class="rg-visually-hidden">: {{ card_title | escape }}</span>
            </a>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile, section#shop) ---------- */
  .rg-shop {
    background: var(--rg-bg);
    color: var(--rg-ink);
  }

  .rg-shop p,
  .rg-shop h2,
  .rg-shop h3 {
    margin: 0;
  }

  .rg-shop ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-shop__wrap {
    padding: 18px 16px 20px;
  }

  .rg-shop__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .rg-shop .rg-shop__eyebrow {
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-shop .rg-shop__title {
    font: 900 clamp(26px, 3.436svh, 33px) / 1.04 var(--rg-font-body);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .rg-shop__grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    scroll-margin-top: 76px;
  }

  .rg-shop__card {
    display: grid;
    grid-template-columns: 36% minmax(0, 1fr);
    height: clamp(186px, calc((100svh - 190px) / 3), 224px);
    overflow: hidden;
    border-radius: 18px;
    background: var(--rg-white);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 20px 44px -26px rgba(26, 26, 26, 0.22);
  }

  .rg-shop__media {
    position: relative;
    display: block;
    min-height: 100%;
    background: var(--rg-white);
  }

  .rg-shop .rg-shop__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-shop__badge {
    display: none;
  }

  .rg-shop__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    min-height: 0;
    padding: 9px 12px 12px 4px;
  }

  .rg-shop__names {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .rg-shop .rg-shop__pre {
    font: 600 8px/1 var(--rg-font-body);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--rg-accent);
  }

  .rg-shop .rg-shop__name {
    font: 900 clamp(14px, 1.9svh, 18px) / 1.05 var(--rg-font-body);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--rg-ink);
  }

  .rg-shop .rg-shop__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    font: 600 10px/1 var(--rg-font-body);
    color: #555555;
  }

  .rg-shop__stars {
    color: #ff8a1f;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 1.5px;
  }

  .rg-shop .rg-shop__desc {
    display: -webkit-box;
    overflow: hidden;
    font: 400 11px/1.35 var(--rg-font-body);
    color: #555555;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .rg-shop .rg-shop__why {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-height: 0;
    padding-top: 5px;
    overflow: hidden;
    border-top: 1px solid #e4e4e4;
  }

  .rg-shop__why li {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 8.5px/1.3 var(--rg-font-body);
    letter-spacing: 0.1em;
    color: var(--rg-ink);
  }

  .rg-shop__why svg {
    flex: none;
    width: 12px;
    height: 12px;
    color: var(--rg-accent);
  }

  .rg-shop__button {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 36px;
    margin-top: 2px;
    padding: 0 12px;
    border-radius: 10px;
    background: var(--rg-accent);
    box-shadow: 0 0 10px rgba(28, 203, 245, 0.5);
    color: var(--rg-ink);
    font: 800 12px/1 var(--rg-font-body);
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.2s;
  }

  .rg-shop__button:hover {
    color: var(--rg-ink);
    filter: brightness(1.05);
  }

  .rg-shop__button:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 3px;
  }

  /* ---------- Desktop (Raw Gravity Landing, section#shop; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-shop {
      --rg-shop-vh: calc(100vh / var(--rg-z, 1));
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
    }

    .rg-shop__wrap {
      width: 100%;
      max-width: calc(1280px + 96px);
      margin: 0 auto;
      padding: clamp(35px, calc(var(--rg-shop-vh) * 0.0489), 53px) 48px clamp(77px, calc(var(--rg-shop-vh) * 0.1067), 115px);
    }

    .rg-shop__head {
      gap: 24px;
    }

    .rg-shop .rg-shop__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-shop .rg-shop__title {
      font-size: clamp(37px, calc(var(--rg-shop-vh) * 0.0511), 55px);
    }

    .rg-shop__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
      margin-top: 28px;
      scroll-margin-top: 86px;
    }

    .rg-shop__card {
      display: flex;
      flex-direction: column;
      height: auto;
      border-radius: 24px;
      box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .rg-shop__card:hover {
      box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.85);
    }

    .rg-shop__media {
      aspect-ratio: 4 / 3;
      max-height: calc(var(--rg-shop-vh) - 400px);
      min-height: 360px;
    }

    .rg-shop .rg-shop__image {
      top: 44px;
      height: calc(100% - 44px);
    }

    .rg-shop__badge {
      position: absolute;
      top: 14px;
      left: 16px;
      z-index: 2;
      display: block;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(26, 26, 26, 0.85);
      color: var(--rg-white);
      font: 700 9px/1 var(--rg-font-body);
      letter-spacing: 0.14em;
      pointer-events: none;
    }

    .rg-shop__body {
      flex: 1;
      gap: 10px;
      padding: 22px 26px 26px;
    }

    .rg-shop__names {
      gap: 8px;
    }

    .rg-shop .rg-shop__pre {
      font-size: 12px;
      letter-spacing: 0.28em;
    }

    .rg-shop .rg-shop__name {
      font-size: clamp(24px, calc(var(--rg-shop-vh) * 0.0333), 36px);
    }

    .rg-shop .rg-shop__rating {
      gap: 8px;
      font-size: 13px;
    }

    .rg-shop__stars {
      font-size: 16px;
      letter-spacing: 2px;
    }

    .rg-shop .rg-shop__desc {
      display: block;
      flex: 1;
      font-size: 16px;
      line-height: 1.5;
    }

    .rg-shop .rg-shop__why {
      flex: none;
      gap: 8px;
      padding: 14px 0 2px;
      overflow: visible;
    }

    .rg-shop__why li {
      gap: 12px;
      font-size: 12px;
      letter-spacing: 0.16em;
    }

    .rg-shop__why svg {
      width: 16px;
      height: 16px;
    }

    .rg-shop__button {
      gap: 12px;
      min-height: 66px;
      margin-top: 8px;
      padding: 0 48px;
      border-radius: 12px;
      box-shadow: 0 0 18px rgba(28, 203, 245, 0.55), 0 6px 20px rgba(28, 203, 245, 0.35);
      font-size: 17px;
      letter-spacing: 0.1em;
    }

    .rg-shop__button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(28, 203, 245, 0.42);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-shop__card,
    .rg-shop__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Shop",
  "class": "rg-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "shop",
      "info": "Used by links such as /#shop. The card grid also has the ID products."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Blend"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Supplies the link and image. Text fields below override the product title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Used when no product is selected, or to point somewhere else."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "BEST SELLER"
        },
        {
          "type": "text",
          "id": "pre",
          "label": "Small title",
          "default": "Raw Coffee+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Signature Jar"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "info": "Shown next to 5 stars, e.g. 4.9. Empty = no rating row.",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Our signature blend in a reusable jar"
        },
        {
          "type": "text",
          "id": "why",
          "label": "Highlights",
          "info": "Separate with ·",
          "default": "PERFECT TO START · REUSABLE JAR · 30 SERVINGS"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "TRY NOW"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "RG · Shop",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
