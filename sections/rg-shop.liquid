{%- comment -%}
  RAW GRAVITY · Shop ("Find Your Blend")
  Product cards: pick a product (link + image come from it) and override any text.
  Works before the catalog is final: without a product, the card uses its own
  image and link (or All products).
  Reference: Raw Gravity Landing(.dc.html) + Mobile, section#shop.
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="rg rg-shop"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-container">
    <div class="rg-shop__head">
      {%- if s.eyebrow != blank -%}
        <p class="rg-shop__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="rg-shop__title">{{ s.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="rg-shop__grid" id="products" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign product = b.product
          assign card_image = b.image | default: product.featured_image
          assign card_link = b.link
          if card_link == blank and product != blank
            assign card_link = product.url
          endif
          if card_link == blank
            assign card_link = routes.all_products_collection_url
          endif
          assign card_title = b.title | default: product.title
          assign why_list = b.why | split: '·'
        -%}
        <li class="rg-shop__card" {{ block.shopify_attributes }}>
          <a class="rg-shop__media" href="{{ card_link }}" tabindex="-1" aria-hidden="true">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 900
                | image_tag:
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 400px, 38vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'rg-shop__image'
              }}
            {%- endif -%}
            {%- if b.badge != blank -%}
              <span class="rg-shop__badge">{{ b.badge | escape }}</span>
            {%- endif -%}
          </a>

          <div class="rg-shop__body">
            <div class="rg-shop__names">
              {%- if b.pre != blank -%}
                <p class="rg-shop__pre">{{ b.pre | escape }}</p>
              {%- endif -%}
              <h3 class="rg-shop__name">{{ card_title | escape }}</h3>
            </div>
            {%- if b.description != blank -%}
              <p class="rg-shop__desc">{{ b.description | escape }}</p>
            {%- endif -%}
            {%- if b.why != blank -%}
              <ul class="rg-shop__why" role="list">
                {%- for item in why_list -%}
                  {%- assign item_text = item | strip -%}
                  {%- if item_text != blank -%}
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
                      {{- item_text | escape -}}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <a class="rg-btn rg-shop__button" href="{{ card_link }}">
              {{- b.button_label | default: 'TRY NOW' | escape }}
              <span class="rg-visually-hidden">: {{ card_title | escape }}</span>
            </a>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-shop {
    padding-block: 44px;
    background: var(--rg-dark-bg);
    color: var(--rg-on-dark);
  }

  .rg-shop p,
  .rg-shop h2,
  .rg-shop h3 {
    margin: 0;
  }

  .rg-shop ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-shop__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .rg-shop__eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-shop__title {
    font-family: var(--rg-font-display);
    font-size: 29px;
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-on-dark);
  }

  .rg-shop__grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
    scroll-margin-top: 80px;
  }

  .rg-shop__card {
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr);
    overflow: hidden;
    border-radius: 18px;
    background: var(--rg-white);
    color: var(--rg-ink);
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, 0.6);
  }

  .rg-shop__media {
    position: relative;
    display: block;
    min-height: 100%;
    background: var(--rg-white);
  }

  .rg-shop__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-shop__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 5px 8px;
    border-radius: 999px;
    background: rgba(26, 26, 26, 0.85);
    color: var(--rg-on-dark);
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.14em;
    pointer-events: none;
  }

  .rg-shop__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 12px 12px 12px 6px;
  }

  .rg-shop__names {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .rg-shop__pre {
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--rg-accent);
  }

  .rg-shop__name {
    font-family: var(--rg-font-display);
    font-size: 18px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--rg-ink);
  }

  .rg-shop__desc {
    font-size: 12px;
    line-height: 1.4;
    color: var(--rg-text-2);
  }

  .rg-shop__why {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 8px;
    border-top: 1px solid var(--rg-line);
  }

  .rg-shop__why li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.12em;
    color: var(--rg-ink);
  }

  .rg-shop__why svg {
    flex: none;
    width: 12px;
    height: 12px;
    color: var(--rg-accent);
  }

  .rg-shop .rg-shop__button {
    width: 100%;
    min-height: 42px;
    margin-top: 4px;
    padding: 0 12px;
    border-radius: 10px;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-shop {
      padding-block: 56px;
    }

    .rg-shop__head {
      gap: 24px;
    }

    .rg-shop__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-shop__title {
      font-size: 46px;
    }

    .rg-shop__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
      gap: 24px;
      margin-top: 28px;
    }

    .rg-shop__card {
      display: flex;
      flex-direction: column;
      border-radius: 24px;
      box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
      transition: box-shadow 0.3s var(--rg-ease);
    }

    .rg-shop__card:hover {
      box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.85);
    }

    .rg-shop__media {
      aspect-ratio: 16 / 10;
      min-height: 180px;
      max-height: max(180px, calc(100vh - 560px));
    }

    .rg-shop__image {
      top: 14px;
      height: calc(100% - 14px);
    }

    .rg-shop__badge {
      top: 18px;
      left: 18px;
      padding: 10px 16px;
      font-size: 12px;
      letter-spacing: 0.16em;
    }

    .rg-shop__body {
      flex: 1;
      gap: 10px;
      padding: 22px 26px 26px;
    }

    .rg-shop__names {
      gap: 8px;
    }

    .rg-shop__pre {
      font-size: 12px;
      letter-spacing: 0.28em;
    }

    .rg-shop__name {
      font-size: 30px;
    }

    .rg-shop__desc {
      flex: 1;
      font-size: 16px;
      line-height: 1.5;
    }

    .rg-shop__why {
      gap: 8px;
      padding: 14px 0 2px;
    }

    .rg-shop__why li {
      gap: 12px;
      font-size: 12px;
      letter-spacing: 0.16em;
    }

    .rg-shop__why svg {
      width: 16px;
      height: 16px;
    }

    .rg-shop .rg-shop__button {
      min-height: 66px;
      margin-top: 8px;
      padding: 0 48px;
      border-radius: 12px;
      font-size: 17px;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Shop",
  "class": "rg-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "shop",
      "info": "Used by links such as /#shop. The card grid also has the ID products."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Blend"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Supplies the link and image. Text fields below override the product title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Used when no product is selected, or to point somewhere else."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "BEST SELLER"
        },
        {
          "type": "text",
          "id": "pre",
          "label": "Small title",
          "default": "Raw Coffee+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Signature Jar"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Our signature blend in a reusable jar"
        },
        {
          "type": "text",
          "id": "why",
          "label": "Highlights",
          "info": "Separate with ·",
          "default": "PERFECT TO START · REUSABLE JAR · 30 SERVINGS"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "TRY NOW"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "RG · Shop",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
