<div class="rg-announcement" style="overflow: hidden; padding: 0; white-space: nowrap; text-align: left;">
  <div class="rg-announcement__track" style="display: inline-flex; width: max-content; animation: rg-announcement-scroll 18s linear infinite; padding: 6px 0;">
    <span class="rg-announcement__set" style="display: inline-flex; flex-shrink: 0;">
      {%- for i in (1..8) -%}
        <span style="padding: 0 24px; flex-shrink: 0;">SUMMER SALE | <span style="background: linear-gradient(90deg, #1eaafbff 0%, var(--rg-accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">FREE US SHIPPING</span></span>
      {%- endfor -%}
    </span>
    <span class="rg-announcement__set" aria-hidden="true" style="display: inline-flex; flex-shrink: 0;">
      {%- for i in (1..8) -%}
        <span style="padding: 0 24px; flex-shrink: 0;">SUMMER SALE | <span style="background: linear-gradient(90deg, #1eaafbff 0%, var(--rg-accent) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">FREE US SHIPPING</span></span>
      {%- endfor -%}
    </span>
  </div>
</div>

<style>
  @keyframes rg-announcement-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .rg-announcement__track:hover { animation-play-state: paused; }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "SUMMER SALE | FREE US SHIPPING"
    }
  ]
}
{% endschema %}