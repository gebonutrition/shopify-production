<section class="rg-section rg-shop" style="background: #353535ff;">
  <div class="rg-container" style="max-width: 1500px;">

    <div class="rg-text-center rg-shop__head">
      <span class="rg-eyebrow rg-eyebrow--cyan">{{ section.settings.eyebrow }}</span>
      <h2 class="rg-shop__heading">{{ section.settings.heading }}</h2>
    </div>

    <style>
      .rg-shop__grid { gap: 24px; align-items: stretch; }
      .rg-shop__grid .rg-product-card:first-child,
      .rg-shop__grid .rg-product-card:last-child {
        transform: scale(0.94);
      }
      .rg-shop__grid .rg-product-card:first-child:hover,
      .rg-shop__grid .rg-product-card:last-child:hover {
        transform: scale(0.97);
      }
      .rg-product-card {
  background: #f1f1f1 !important;
  border-radius: 12px !important;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  height: 100%;
  transform: scale(1);
  transition: transform 0.6s cubic-bezier(0.4,0,0.2,1), box-shadow 0.4s cubic-bezier(0.4,0,0.2,1);
}
      .rg-product-card:hover {
        transform: scale(1.03);
        box-shadow: 0 14px 44px rgba(0,0,0,0.28);
      }
      .rg-product-card__img { aspect-ratio: 4/3.4 !important; }
      .rg-product-card__tag {
        background: rgba(255,255,255,0.12) !important;
        color: rgba(255,255,255,0.9) !important;
        backdrop-filter: blur(6px);
        font-size: 10px !important;
        letter-spacing: 0.15em !important;
        border-radius: 999px !important;
        padding: 5px 14px !important;
        font-weight: 600 !important;
      }
      .rg-product-card__body { padding: 22px 20px 20px !important; gap: 8px !important; display: flex; flex-direction: column; flex: 1; }
      .rg-product-card__title {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  font-weight: 800 !important;
  font-size: 20px !important;
  color: #18181B !important;
  letter-spacing: normal;
}
      .rg-product-card__subtitle { font-size: 12px !important; color: #71717A !important; margin-top: -4px; }
      .rg-product-card__rating-text { font-size: 11px !important; }
      .rg-product-card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
      .rg-tag-pill {
        font-size: 9px !important;
        font-weight: 700 !important;
        letter-spacing: 0.1em !important;
        background: transparent !important;
        color: #18181B !important;
        border: 1.5px solid rgba(0,0,0,0.25) !important;
        border-radius: 999px !important;
        padding: 5px 12px !important;
      }
      .rg-product-card__price-current {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-size: 20px !important;
        font-weight: 800 !important;
        color: #18181B !important;
      }
      .rg-product-card__price-was {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-weight: 800 !important;
        font-size: 14px !important;
      }
      .rg-product-card__footer { display: flex !important; flex-direction: column; gap: 10px; align-items: stretch !important; }
.rg-product-card__above-price { height: 120px; display: flex; flex-direction: column; gap: 8px; padding-left: 20px; }
      .rg-product-card .rg-btn {
  width: 100%;
  background: var(--rg-accent) !important;
  color: #101010 !important;
  font-size: 11px !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase;
  border-radius: 4px !important;
  padding: 12px 0 !important;
  text-align: center;
  transition: background 0.25s ease, box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.22,1,0.36,1) !important;
}
.rg-product-card .rg-btn:hover {
  background: var(--rg-accent) !important;
  transform: translateY(-4px);
  box-shadow: 0 0 12px 2px rgba(30,207,251,0.5);
}
    </style>
    <div class="rg-shop__grid" style="max-width: 1500px; margin: 0 auto;">
      {%- for block in section.blocks -%}
        <div class="rg-product-card" {{ block.shopify_attributes }}>

          <div class="rg-product-card__img">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                alt="{{ block.settings.title }}"
                width="700"
                height="560"
                loading="lazy"
              >
            {%- else -%}
              {%- assign fallback_img = 'product-mushrooms.jpg' -%}
              {%- if forloop.index == 2 -%}{%- assign fallback_img = 'product-lifestyle.jpg' -%}{%- endif -%}
              {%- if forloop.index == 3 -%}{%- assign fallback_img = 'raw-coffee-lifestyle.jpg' -%}{%- endif -%}
              <img
                src="{{ fallback_img | asset_url }}"
                alt="{{ block.settings.title }}"
                width="700"
                height="560"
                loading="lazy"
              >
            {%- endif -%}
            <span class="rg-product-card__tag">{{ block.settings.tag }}</span>
          </div>

          <div class="rg-product-card__body">
            <div class="rg-product-card__above-price">
              <h3 class="rg-product-card__title">{{ block.settings.title }}</h3>

              <div class="rg-product-card__rating">
                <span class="rg-stars" style="display: flex; gap: 3px; color: #fe7803;" aria-hidden="true">
  {%- for i in (1..5) -%}
    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l3.09 6.26 6.91 1.01-5 4.87 1.18 6.89L12 17.27l-6.18 3.25 1.18-6.89-5-4.87 6.91-1.01L12 1.5z"/></svg>
  {%- endfor -%}
</span>
                <span class="rg-product-card__rating-text">{{ block.settings.rating }} ({{ block.settings.review_count }})</span>
              </div>

              <p class="rg-product-card__subtitle">{{ block.settings.subtitle }}</p>

              <div class="rg-product-card__tags">
                {%- assign tag_pills = block.settings.tag_pills | split: '|' -%}
                {%- for pill in tag_pills -%}
                  <span class="rg-tag-pill">{{ pill | strip | upcase }}</span>
                {%- endfor -%}
              </div>
            </div>

            <div class="rg-product-card__footer">
              {%- assign card_url = block.settings.product_url -%}
              {%- if card_url == blank -%}
                {%- if collections.all.products.size > 0 -%}
                  {%- assign card_url = collections.all.products.first.url -%}
                {%- else -%}
                  {%- assign card_url = routes.all_products_collection_url -%}
                {%- endif -%}
              {%- endif -%}
              <a href="{{ card_url }}" class="rg-btn rg-btn--primary rg-btn--sm">Try Now</a>
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your Blend" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "tag", "label": "Badge Tag", "default": "Best Seller" },
        { "type": "text", "id": "title", "label": "Title", "default": "Brew Extreme" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Low-Caffeine Arabica & Nootropics" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
        { "type": "text", "id": "review_count", "label": "Review Count", "default": "2,847" },
        { "type": "text", "id": "tag_pills", "label": "Tag Pills (separated by |)", "default": "1,000mg Lion's Mane | 3,000mg Creatine | Adaptogenic Blend" },
        { "type": "text", "id": "price", "label": "Price", "default": "$49.99" },
        { "type": "text", "id": "price_was", "label": "Was Price (optional)", "default": "$59.99" },
        { "type": "url", "id": "product_url", "label": "Product URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product_card", "settings": { "tag": "Best Seller", "title": "Brew Extreme", "subtitle": "Low-Caffeine Arabica & Nootropics", "rating": "4.9", "review_count": "2,847", "tag_pills": "1,000mg Lion's Mane | 3,000mg Creatine | Adaptogenic Blend", "price": "$49.99", "price_was": "$59.99" } },
{ "type": "product_card", "settings": { "tag": "Fan Favorite", "title": "Raw Coffee+", "subtitle": "Low-Caffeine Arabica & Nootropics", "rating": "4.8", "review_count": "1,953", "tag_pills": "1,000mg Lion's Mane | Amino Acids | Pure & Functional", "price": "$44.99", "price_was": "" } },
{ "type": "product_card", "settings": { "tag": "Save 27%", "title": "The Starter Bundle", "subtitle": "Both blends + shaker bottle", "rating": "4.9", "review_count": "892", "tag_pills": "Brew Extreme | Raw Coffee+ | Free Shaker", "price": "$79.99", "price_was": "$109.97" } }
      ]
    }
  ]
}
{% endschema %}
