<section class="rg-section rg-faq">
  <div class="rg-container rg-container--narrow">

    <div class="rg-text-center rg-faq__head" style="margin-bottom: 48px;">
      <span class="rg-eyebrow rg-eyebrow--cyan" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: var(--rg-accent); display: block; margin-bottom: 12px;">{{ section.settings.eyebrow }}</span>
      <h2 class="rg-heading rg-faq__heading" style="font-size: 48px; font-weight: 800; color: #18181B; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-transform: none;">{{ section.settings.heading }}</h2>
    </div>

    <style>
      .rg-faq-list { display: flex; flex-direction: column; gap: 10px; max-width: 700px; margin: 0 auto; }
      .rg-faq-item {
        background: #f1f1f1; border: 1px solid var(--rg-border); border-radius: 10px;
        padding: 0 22px; box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      }
      .rg-faq-q {
        display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%;
        padding: 20px 0; background: none; border: none; cursor: pointer; text-align: left;
        font-size: 16px; font-weight: 600; line-height: 1.4; color: #2D2D2D;
      }
      .rg-faq-icon { flex-shrink: 0; width: 20px; height: 20px; color: var(--rg-muted); transition: transform 0.35s ease; }
      .rg-faq-item.open .rg-faq-icon { transform: rotate(180deg); color: var(--rg-accent); }
      .rg-faq-a { overflow: hidden; max-height: 0; transition: max-height 0.45s cubic-bezier(0.22,1,0.36,1); }
      .rg-faq-a-inner { padding-bottom: 20px; font-size: 14px; line-height: 1.75; color: var(--rg-muted); }
    </style>

    <div class="rg-faq-list">
      {%- for block in section.blocks -%}
        <div class="rg-faq-item" {{ block.shopify_attributes }}>
          <button class="rg-faq-q" type="button">
            <span>{{ block.settings.question }}</span>
            <svg class="rg-faq-icon" viewBox="0 0 24 24" fill="none"><polyline points="6,9 12,15 18,9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="rg-faq-a">
            <div class="rg-faq-a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="rg-text-center rg-faq__footer" style="margin-top: 48px;">
      <p class="rg-faq__footer-text" style="font-size: 14px; color: #71717A; margin-bottom: 16px;">{{ section.settings.footer_text }}</p>
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="rg-btn rg-btn--primary rg-btn--glow" style="font-size: 13px; padding: 12px 26px; text-transform: uppercase;">{{ section.settings.contact_text }}</a>
    </div>

  </div>
</section>

<script>
  (function () {
    var faqItems = document.querySelectorAll('.rg-faq .rg-faq-item');
    faqItems.forEach(function (item) {
      var header = item.querySelector('.rg-faq-q');
      var answer = item.querySelector('.rg-faq-a');
      header.addEventListener('click', function () {
        var isOpen = item.classList.contains('open');

        faqItems.forEach(function (other) {
          if (other !== item && other.classList.contains('open')) {
            other.classList.remove('open');
            other.querySelector('.rg-faq-a').style.maxHeight = '';
          }
        });

        if (isOpen) {
          item.classList.remove('open');
          answer.style.maxHeight = '';
        } else {
          item.classList.add('open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions & Answers" },
    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Still have questions?" },
    { "type": "text", "id": "contact_text", "label": "Contact button text", "default": "Contact Us" },
    { "type": "url", "id": "contact_url", "label": "Contact Page URL" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does mushroom coffee taste?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Like a rich, smooth cup of coffee. The mushroom extracts are flavorless at our doses.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How does mushroom coffee taste?", "answer": "<p>Like a rich, smooth cup of coffee. Brew Extreme is made with premium Arabica beans, and the mushroom extracts are odorless and flavorless at the doses we use — no earthy or bitter aftertaste.</p>" } },
        { "type": "faq_item", "settings": { "question": "How much caffeine is in each serving?", "answer": "<p>About 50mg per serving — roughly half a standard cup of coffee. Paired with L-Theanine, it delivers smooth, sustained energy without jitters or the afternoon crash.</p>" } },
        { "type": "faq_item", "settings": { "question": "What's the difference between Brew Extreme and Raw Coffee+?", "answer": "<p>Brew Extreme is our premium flagship with the full nootropic stack: Alpha-GPC, Creatine, L-Tyrosine, Ginkgo, Lion's Mane, and L-Theanine. Raw Coffee+ is our everyday blend with functional mushrooms for immune and energy support.</p>" } },
        { "type": "faq_item", "settings": { "question": "How do I prepare it?", "answer": "<p>Add one scoop (10g) to 8–12oz of hot or cold water and stir. For best results, use water between 175–195°F. It also works great in a French press, pour-over, or blended into a latte.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is it safe to drink every day?", "answer": "<p>Yes. Every ingredient is included at safe, clinically studied doses for daily consumption. If you're sensitive to caffeine, start with half a scoop for the first few days.</p>" } },
        { "type": "faq_item", "settings": { "question": "How does the subscription work?", "answer": "<p>Subscribers save 20% on every order and get free shipping automatically. Skip, pause, or cancel anytime — no hoops, no fees. We send a reminder email 3 days before each renewal.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you offer a money-back guarantee?", "answer": "<p>Yes. We offer a 30-day, no-questions-asked money-back guarantee. If you're not satisfied for any reason, contact us and we'll issue a full refund.</p>" } },
        { "type": "faq_item", "settings": { "question": "Where are your mushrooms sourced?", "answer": "<p>All mushroom extracts come from certified organic farms and are fruiting-body only — not mycelium on grain. Every batch is third-party tested for heavy metals, pesticides, and potency.</p>" } }
      ]
    }
  ]
}
{% endschema %}
