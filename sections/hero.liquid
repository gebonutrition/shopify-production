<section class="rg-hero" style="border-top: none; border-bottom: none; min-height: 84vh;">
  <div class="rg-hero__bg" style="position: absolute; inset: 0; overflow: hidden; background: var(--rg-bg); z-index: 0;">
    <div class="rg-bg-blobs" style="position: absolute; z-index: 0;">
      <div class="rg-bg-blob rg-bg-blob--1" style="width: 55%; height: 55%; top: -30%; left: -30%;"></div>
      <div class="rg-bg-blob rg-bg-blob--2" style="width: 52%; height: 52%; top: -30%; right: -30%;"></div>
      <div class="rg-bg-blob rg-bg-blob--3" style="width: 42%; height: 42%; top: 35vh; right: -22%;"></div>
    </div>
  </div>
  <div class="rg-hero__overlay" style="background: none;"></div>

  <div class="rg-container" style="max-width: none; margin: 0; padding-left: 196px;">
    <div class="rg-hero__content" style="align-items: flex-start; text-align: left;">

      <div class="rg-hero__eyebrow" style="margin-bottom: -14px;">
        <span class="rg-reviews-pill" style="background: none; border: none; backdrop-filter: none; padding: 0;">
          <span class="rg-stars" style="display: flex; gap: 4px; color: #fe7803;" aria-hidden="true">
  {%- for i in (1..5) -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l3.09 6.26 6.91 1.01-5 4.87 1.18 6.89L12 17.27l-6.18 3.25 1.18-6.89-5-4.87 6.91-1.01L12 1.5z"/></svg>
  {%- endfor -%}
</span>
          <span class="rg-reviews-pill__text" style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; font-size: 26px; color: #2D2D2D;">{{ section.settings.eyebrow }}</span>
      </div>

      <h1 class="rg-hero__title" style="font-size: clamp(2.6rem, 6vw, 4.2rem); font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 800; color: #2D2D2D;">
        {{ section.settings.title_line1 }}<br>
        <span class="rg-hero__title-accent">{{ section.settings.title_line2 }}</span><br>
        <span>{{ section.settings.title_line3 }}</span>
      </h1>

      <p class="rg-hero__subtitle rg-hero__subtitle--promo">{{ section.settings.subtitle }}</p>

      <div class="rg-hero__cta" style="display: flex; justify-content: center; width: 380px;">
  {%- assign hero_cta_url = section.settings.cta_link | default: '/collections/all' -%}
  <a href="{{ hero_cta_url }}" class="rg-btn rg-btn--primary rg-btn--lg rg-btn--glow" style="font-size: 19px; padding: 22px 44px; text-transform: uppercase;">
    {{ section.settings.cta_text }}
  </a>
</div>

      <style>
        .rg-hero__subtitle--promo {
          position: relative;
          font-size: 17px;
          font-weight: 700;
          font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
          color: #ffffff;
          background: #2D2D2D;
          border-radius: 10px;
          padding: 16px 22px 16px 24px;
          display: inline-block;
          line-height: 1.45;
          box-shadow: 0 10px 28px rgba(0,0,0,0.2);
          overflow: hidden;
        }
        .rg-hero__subtitle--promo::before {
          content: '';
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 5px;
          background: var(--rg-accent);
        }
        .rg-hero-tag {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px; font-weight: 800; letter-spacing: 0.02em;
  text-transform: uppercase; color: #242424ff;
  border: none;
  background: #d2d2ff94;
  border-radius: 8px; padding: 10px 18px;
  transition: background 0.22s, transform 0.22s;
  animation: none;
}
.rg-hero-tag:hover {
  background: #e2e2ffc0;
  transform: translateY(-2px);
}
        @keyframes rgTagGlow {
          0%, 100% { box-shadow: 0 0 0 0 rgba(30,207,251,0); }
          50% { box-shadow: 0 0 10px 2px rgba(30,207,251,0.25); }
        }
      </style>
      <div class="rg-hero__trust" style="justify-content: center; gap: 10px; width: 380px; margin-left: 10px; margin-top: -12px;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <span class="rg-hero-tag" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>

  {%- if section.settings.product_png != blank -%}
    <img
      src="{{ section.settings.product_png | image_url: width: 900 }}"
      alt=""
      width="900"
      height="900"
      loading="eager"
      style="position: absolute; top: 50%; right: 14%; transform: translateY(-50%); width: 760px; height: auto; max-width: 56%; object-fit: contain; z-index: 2; pointer-events: none;"
    >
  {%- endif -%}

  <span class="rg-hero__sparkle" aria-hidden="true">
    <svg width="36" height="36" viewBox="0 0 24 24" fill="rgba(255,255,255,0.85)"><path d="M12 0l2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4z"/></svg>
  </span>
</section>

<!-- Benefit marquee -->
<style>
  .rg-ticker-v2 { padding: 28px 0; background: #111111; }
.rg-ticker-v2 .rg-ticker-track { animation-duration: 70s; }
.rg-ticker-v2 .rg-ticker-track:hover { animation-play-state: paused; }
.rg-ticker-v2 .rg-ticker__item {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 15px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: #ffffff;
  font-family: 'Inter', sans-serif;
}
  .rg-ticker-icon-v2 {
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--rg-accent); flex-shrink: 0;
  }
  .rg-ticker-icon-v2 svg { display: block; width: 16px; height: 16px; }
</style>
<div class="rg-ticker rg-ticker-v2" style="border-top: none; border-bottom: none;">
  <div class="rg-ticker-track">
    {%- assign items = section.settings.ticker_items | split: ',' -%}
    {%- for cycle_idx in (1..2) -%}
      {%- for item in items -%}
        {%- assign clean_item = item | strip -%}
        <span class="rg-ticker__item">
          <span class="rg-ticker-icon-v2" aria-hidden="true">
            {%- case clean_item -%}
              {%- when 'Vegan Friendly' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              {%- when 'Low Caffeine' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              {%- when 'Laser Focus' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg>
              {%- when 'Smooth Energy' -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h6l-1 7 9-11h-6l1-7z"/></svg>
              {%- when 'No Crashes' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when 'Glowing Skin' -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4z"/></svg>
              {%- when 'Healthy Gut' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4-3-8-6.5-8-11a5 5 0 0 1 8-4 5 5 0 0 1 8 4c0 4.5-4 8-8 11z"/></svg>
              {%- when 'Boosted Immunity' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9,12 11,14 15,10"/></svg>
              {%- when 'Mental Clarity' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><line x1="6" y1="6" x2="12" y2="18"/><line x1="18" y1="6" x2="12" y2="18"/><line x1="6" y1="6" x2="18" y2="6"/></svg>
              {%- when 'Zero Jitters' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="4"/></svg>
            {%- endcase -%}
          </span>
          {{ clean_item | upcase }}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (unused — gradient now)"
    },
    {
      "type": "image_picker",
      "id": "product_png",
      "label": "Product PNG (right side)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Reviews pill text",
      "default": "4,800+ Five-Star Reviews"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Headline line 1 (white)",
      "default": "Brew Extreme:"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Headline line 2 (blue)",
      "default": "Your Daily"
    },
    {
      "type": "text",
      "id": "title_line3",
      "label": "Headline line 3 (white, underlined)",
      "default": "Upgrade"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium mushroom coffee with Lion's Mane, Cordyceps & Adaptogens. Sustained energy. Zero crash. Pure performance."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Try Mushroom Coffee & Save 43%"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "ticker_items",
      "label": "Marquee Items (comma separated)",
      "default": "Vegan Friendly, Low Caffeine, Laser Focus, Smooth Energy, No Crashes, Glowing Skin, Healthy Gut, Boosted Immunity, Mental Clarity, Zero Jitters"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Vegan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "trust_item", "settings": { "label": "Vegan" } },
        { "type": "trust_item", "settings": { "label": "Low-Caffeine" } },
        { "type": "trust_item", "settings": { "label": "Nootropics" } }
      ]
    }
  ]
}
{% endschema %}
