{%- comment -%}
  RAW GRAVITY · Differentiators ("What Makes It Different") + benefit band.
  Light part: photo (left half on desktop, top strip on mobile) and a dark accordion
  (exclusive <details>, no JS). Dark band below: 4 benefit cards with outline icons.
  Reference: Raw Gravity Landing(.dc.html) + Mobile, sections "Differentiators" and "Benefits" (2026-11 update).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign accordion_name = 'rg-diff-' | append: section.id
  assign has_cards = false
  for block in section.blocks
    if block.type == 'card'
      assign has_cards = true
      break
    endif
  endfor
-%}

<div
  class="rg rg-z rg-diff"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <section class="rg-diff__main">
    <div class="rg-diff__media" aria-hidden="true">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1400
          | image_tag:
            widths: '600, 900, 1100, 1400',
            sizes: '(min-width: 990px) 50vw, 110vw',
            loading: 'lazy',
            alt: '',
            class: 'rg-diff__image'
        }}
      {%- endif -%}
    </div>

    <div class="rg-diff__wrap">
      <div class="rg-diff__spacer" aria-hidden="true"></div>
      <div class="rg-diff__body">
        <div class="rg-diff__head">
          {%- if s.eyebrow != blank -%}
            <p class="rg-diff__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="rg-diff__title">
            {{- s.heading_start | escape }}
            {% if s.heading_accent != blank -%}
              <span class="rg-diff__accent">{{ s.heading_accent | escape }}</span>
            {%- endif -%}
          </h2>
        </div>

        {%- assign accordion_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'item', 'facts' -%}
              <details
                class="rg-diff__item"
                name="{{ accordion_name }}"
                {% if accordion_index == 0 and s.open_first %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="rg-diff__summary">
                  <span class="rg-diff__item-title">{{ block.settings.title | escape }}</span>
                  <span class="rg-diff__chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
                  </span>
                </summary>
                {%- if block.type == 'item' -%}
                  {%- if block.settings.text != blank -%}
                    <p class="rg-diff__item-text">{{ block.settings.text | escape | newline_to_br }}</p>
                  {%- endif -%}
                {%- else -%}
                  <div class="rg-diff__facts">
                    {%- if block.settings.serving != blank -%}
                      <p class="rg-diff__facts-head">{{ block.settings.serving | escape }}</p>
                    {%- endif -%}
                    <dl class="rg-diff__facts-list">
                      {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                      {%- for row in rows -%}
                        {%- assign parts = row | split: '|' -%}
                        {%- assign fact_name = parts[0] | strip -%}
                        {%- assign fact_dose = parts[1] | strip -%}
                        {%- if fact_name != blank -%}
                          <div class="rg-diff__fact">
                            <dt>{{ fact_name | escape }}</dt>
                            <dd>{{ fact_dose | escape }}</dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  </div>
                {%- endif -%}
              </details>
              {%- assign accordion_index = accordion_index | plus: 1 -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- if has_cards -%}
    <section class="rg-diff__band">
      <ul class="rg-diff__cards" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <li class="rg-diff__card" {{ block.shopify_attributes }}>
              <span class="rg-diff__card-icon" aria-hidden="true">
                {%- if block.settings.line_icon != 'none' -%}
                  {%- render 'rg-line-icon', name: block.settings.line_icon, size: 66, stroke: 3 -%}
                {%- elsif block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag: width: 66, height: 66, loading: 'lazy', alt: ''
                  }}
                {%- endif -%}
              </span>
              <h3 class="rg-diff__card-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="rg-diff__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  /* ---------- Mobile (Raw Gravity Landing Mobile) ---------- */
  .rg-diff__main {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    padding: 0 20px 32px;
    background: var(--rg-bg);
  }

  .rg-diff__media {
    position: relative;
    height: 400px;
    margin: 0 -20px;
    overflow: hidden;
    background: var(--rg-white);
  }

  .rg-diff .rg-diff__image {
    position: absolute;
    bottom: -10px;
    left: -30px;
    display: block;
    width: auto;
    max-width: none;
    height: 104%;
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to right, #000 78%, transparent 100%);
    mask-image: linear-gradient(to right, #000 78%, transparent 100%);
  }

  .rg-diff__spacer {
    display: none;
  }

  .rg-diff__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Mobile: the heading sits on the photo strip, top right (relative to .rg-diff__main) */
  .rg-diff__head {
    position: absolute;
    top: 32px;
    right: 20px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    width: 56%;
    text-align: right;
  }

  .rg-diff .rg-diff__eyebrow {
    margin: 0;
    font: 700 9px/1 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-diff .rg-diff__title {
    margin: 0;
    font: 900 clamp(24px, 3.199svh, 31px) / 1.04 var(--rg-font-body);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--rg-ink);
  }

  .rg-diff__accent {
    color: var(--rg-accent);
  }

  .rg-diff__item {
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.28);
    border-radius: 16px;
    background: radial-gradient(ellipse at 0% 0%, #26464f 0%, #323232 60%, #2e2e2e 100%);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
  }

  .rg-diff__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 12px 12px 16px;
    cursor: pointer;
    list-style: none;
  }

  .rg-diff__summary::-webkit-details-marker {
    display: none;
  }

  .rg-diff__summary:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: -2px;
  }

  .rg-diff__item-title {
    font: 700 13px/1.3 var(--rg-font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rg-on-dark);
  }

  .rg-diff__chevron {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(28, 203, 245, 0.35);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 12px rgba(28, 203, 245, 0.25);
    color: var(--rg-accent);
    transition: transform 0.3s var(--rg-ease);
  }

  .rg-diff__chevron svg {
    width: 16px;
    height: 16px;
  }

  .rg-diff__item[open] .rg-diff__chevron {
    transform: rotate(90deg);
  }

  .rg-diff .rg-diff__item-text {
    margin: 0;
    padding: 0 18px 16px;
    font: 400 clamp(13px, 1.777svh, 16px) / 1.55 var(--rg-font-body);
    color: #bdbdbd;
    text-wrap: pretty;
  }

  .rg-diff__facts {
    margin: 0 14px 16px;
    padding: 16px 16px 6px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
  }

  .rg-diff .rg-diff__facts-head {
    margin: 0;
    padding-bottom: 12px;
    font: 700 10px/1.4 var(--rg-font-body);
    letter-spacing: 0.32em;
    color: var(--rg-accent);
  }

  .rg-diff__facts-list {
    margin: 0;
  }

  .rg-diff__fact {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid #464646;
    font: 400 13px/1.4 var(--rg-font-body);
    color: #bdbdbd;
  }

  .rg-diff__fact dt,
  .rg-diff__fact dd {
    margin: 0;
  }

  .rg-diff__fact dd {
    font-weight: 700;
    white-space: nowrap;
    color: var(--rg-on-dark);
  }

  .rg-diff__band {
    padding: 24px 16px;
    background: radial-gradient(ellipse at 15% 0%, #26464f 0%, #323232 50%, #2e2e2e 100%);
    color: var(--rg-on-dark);
  }

  .rg-diff__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-diff__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 14px 10px 16px;
    border: 1px solid rgba(28, 203, 245, 0.28);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    text-align: center;
  }

  .rg-diff__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 2px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(28, 203, 245, 0.22) 0%, rgba(28, 203, 245, 0.08) 55%, rgba(28, 203, 245, 0) 72%);
    box-shadow: 0 0 17px rgba(28, 203, 245, 0.28);
    color: #00b7e8;
  }

  .rg-diff__card-icon svg,
  .rg-diff__card-icon img {
    display: block;
    width: 37px;
    height: 37px;
    object-fit: contain;
    filter: drop-shadow(0 0 4px rgba(0, 183, 232, 0.55));
  }

  .rg-diff .rg-diff__card-title {
    margin: 0;
    font: 700 11px/1.25 var(--rg-font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rg-on-dark);
  }

  .rg-diff .rg-diff__card-text {
    margin: 0;
    font: 400 12px/1.4 var(--rg-font-body);
    color: #bdbdbd;
  }

  /* ---------- Desktop (Raw Gravity Landing; zoomed through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-diff {
      --rg-diff-vh: calc(100vh / var(--rg-z, 1));
    }

    .rg-diff__main {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0;
      min-height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
      padding: clamp(58px, calc(var(--rg-diff-vh) * 0.08), 86px) 48px;
    }

    .rg-diff__media {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 0;
      width: 50%;
      height: auto;
      margin: 0;
      background: none;
      pointer-events: none;
    }

    .rg-diff .rg-diff__image {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 55%;
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 93%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 0%, #000 93%, transparent 100%);
    }

    .rg-diff__wrap {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
      align-items: stretch;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
    }

    .rg-diff__spacer {
      display: block;
      height: 739px;
      min-height: 380px;
    }

    .rg-diff__body {
      justify-content: space-between;
      gap: 16px;
      padding-left: 24px;
    }

    .rg-diff__head {
      position: static;
      align-items: flex-start;
      gap: 20px;
      width: auto;
      margin-bottom: 12px;
      text-align: left;
    }

    .rg-diff .rg-diff__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
    }

    .rg-diff .rg-diff__title {
      font-size: clamp(37px, calc(var(--rg-diff-vh) * 0.0511), 55px);
    }

    .rg-diff__item {
      border-radius: 20px;
    }

    .rg-diff__summary {
      gap: 16px;
      padding: 32px;
    }

    .rg-diff__item-title {
      font: 800 19px/1.15 var(--rg-font-body);
      letter-spacing: 0;
    }

    .rg-diff__chevron {
      width: 38px;
      height: 38px;
      box-shadow: 0 0 14px rgba(28, 203, 245, 0.25);
    }

    .rg-diff__chevron svg {
      width: 15px;
      height: 15px;
    }

    .rg-diff .rg-diff__item-text {
      padding: 0 28px 24px;
      font-size: 17px;
      line-height: 1.6;
    }

    .rg-diff__facts {
      margin: 0 28px 24px;
      padding: 14px 18px;
    }

    .rg-diff .rg-diff__facts-head {
      padding-bottom: 10px;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.38em;
    }

    .rg-diff__fact {
      gap: 24px;
      padding: 7px 0;
      font-size: 14px;
      line-height: 1.35;
    }

    .rg-diff__band {
      padding: 28px 48px;
    }

    .rg-diff__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      max-width: 1280px;
      margin: 0 auto;
    }

    .rg-diff__card {
      gap: 6px;
      padding: 18px 18px 22px;
      border-radius: 24px;
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
        border-color 0.6s;
    }

    .rg-diff__card:hover {
      transform: translateY(-8px);
      border-color: var(--rg-accent);
      box-shadow: 0 0 34px rgba(28, 203, 245, 0.35);
    }

    .rg-diff__card-icon {
      width: 84px;
      height: 84px;
      box-shadow: 0 0 29px rgba(28, 203, 245, 0.28);
    }

    .rg-diff__card-icon svg,
    .rg-diff__card-icon img {
      width: 66px;
      height: 66px;
      filter: drop-shadow(0 0 6px rgba(0, 183, 232, 0.55));
    }

    .rg-diff .rg-diff__card-title {
      padding: 0 8px;
      font: 800 17px/1.15 var(--rg-font-body);
      letter-spacing: 0;
    }

    .rg-diff .rg-diff__card-text {
      padding: 0 12px;
      font-size: 14px;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg-diff__chevron,
    .rg-diff__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Differentiators",
  "class": "rg-diff-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "benefits",
      "info": "Used by links such as /#benefits."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Shown on a light background with multiply blending; use a photo on white."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FUNCTIONAL BENEFITS"
    },
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading — start",
      "default": "What Makes It"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading — accent (blue)",
      "default": "Different"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first accordion item",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "STEADY ENERGY"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "facts",
      "name": "Accordion: label facts",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "READ THE LABEL"
        },
        {
          "type": "text",
          "id": "serving",
          "label": "Serving line",
          "default": "SERVING SIZE: 1 SCOOP (7G) · 30 SERVINGS"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Rows",
          "info": "One ingredient per line: Name | Dose"
        }
      ]
    },
    {
      "type": "card",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "line_icon",
          "label": "Icon",
          "options": [
            { "value": "focus", "label": "Focus" },
            { "value": "stress", "label": "Stress support" },
            { "value": "resilience", "label": "Resilience" },
            { "value": "immune", "label": "Immune support" },
            { "value": "none", "label": "Custom image below" }
          ],
          "default": "focus"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SHARP MENTAL FOCUS"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clear head and better focus on anything you do."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RG · Differentiators",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "STEADY ENERGY"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "GUT HEALTH"
          }
        },
        {
          "type": "facts"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
