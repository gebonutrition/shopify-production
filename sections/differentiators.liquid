<section class="rg-section rg-diff" style="background: #FAFAF8; position: relative; z-index: 1;">
  <div class="rg-container" style="max-width: 1600px;">

    <div style="border: 1px solid var(--rg-border); border-radius: 24px; padding: 64px 72px; background: #fff; position: relative;">

      <div style="position: absolute; top: -34px; left: 50%; transform: translate(-50%, -50%); display: flex; justify-content: center; z-index: 2;">
        <span style="display: inline-block; background: none; color: var(--rg-accent); font-size: 15px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 20px; border-radius: 999px;">{{ section.settings.eyebrow }}</span>
      </div>

      <h2 class="rg-heading rg-diff__heading" style="position: absolute; top: 44px; left: 50%; transform: translateX(-50%); width: max-content; margin-bottom: 32px; font-size: clamp(2.6rem, 4.2vw, 3.6rem); font-weight: 800; color: #18181B; white-space: nowrap; text-align: center; z-index: 2;" id="rg-diff-heading-below-tooltip">
  {{ section.settings.heading }} <span style="color: var(--rg-accent);">{{ section.settings.heading_accent }}</span>
</h2>

      <div class="rg-diff__grid" style="display: grid; grid-template-columns: 480px 1fr; gap: 40px; align-items: start; margin-bottom: 0;">
        <!-- Left: product image -->
        <div class="rg-diff__media" style="margin-top: 105px; margin-left: -10px;">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              alt="{{ section.settings.image.alt | default: 'Raw Gravity mushroom coffee' }}"
              width="900"
              height="1100"
              loading="lazy"
              style="border-radius: 20px; width: 100%; aspect-ratio: 1 / 1; object-fit: cover;"
            >
          {%- else -%}
            <img
              src="{{ 'raw-coffee-lifestyle.jpg' | asset_url }}"
              alt="Raw Gravity mushroom coffee lifestyle"
              width="900"
              height="1100"
              loading="lazy"
              style="border-radius: 20px; width: 100%; aspect-ratio: 1 / 1; object-fit: cover;"
            >
          {%- endif -%}
        </div>

        <!-- Right: tiles -->
        <div class="rg-diff__tiles" style="display: flex; flex-direction: column; gap: 14px; margin-top: 140px; max-width: 1040px;">

          <div class="rg-diff__tile" style="width: 100%; background: #393939; border-radius: 16px; overflow: hidden;">
            <div class="rg-diff__tile-header" style="display: flex; align-items: center; justify-content: space-between; height: 90px; padding: 0 28px; cursor: pointer;">
              <span style="font-size: 18px; line-height: 90px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: #fff;">Taste &amp; Flavor</span>
              <span class="rg-diff__tile-toggle" style="width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.08); color: var(--rg-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);"><svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1,1 7,7 1,13"/></svg></span>
            </div>
            <div class="rg-diff__tile-panel" style="max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.22,1,0.36,1);">
              <div style="padding: 0 28px 28px 28px; color: rgba(255,255,255,0.75); font-size: 15px; line-height: 1.6;">
                <div style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--rg-accent); margin-bottom: 8px;">Taste &amp; Flavor</div>
                <p style="margin: 0 0 10px;">Balanced, full-bodied coffee you know and love. Notes of smooth chocolate.</p>
                <p style="margin: 0;">Every batch is verified by an independent lab before it ships — no shortcuts, no guesswork, just proof.</p>
              </div>
            </div>
          </div>

          <div class="rg-diff__tile" style="width: 100%; background: #393939; border-radius: 16px; overflow: hidden;">
            <div class="rg-diff__tile-header" style="display: flex; align-items: center; justify-content: space-between; height: 90px; padding: 0 28px; cursor: pointer;">
              <span style="font-size: 18px; line-height: 90px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: #fff;">High Dosage</span>
              <span class="rg-diff__tile-toggle" style="width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.08); color: var(--rg-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);"><svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1,1 7,7 1,13"/></svg></span>
            </div>
            <div class="rg-diff__tile-panel" style="max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.22,1,0.36,1);">
              <div style="padding: 0 28px 28px 28px; color: rgba(255,255,255,0.75); font-size: 15px; line-height: 1.6;">
                <div style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--rg-accent); margin-bottom: 8px;">High Dosage</div>
                <p style="margin: 0 0 10px;">Clinical strength formula with 10,000mg Lion's Mane – real doses that work.</p>
                <p style="margin: 0;">Every batch is verified by an independent lab before it ships — no shortcuts, no guesswork, just proof.</p>
              </div>
            </div>
          </div>

          <div class="rg-diff__tile" style="width: 100%; background: #393939; border-radius: 16px; overflow: hidden;">
            <div class="rg-diff__tile-header" style="display: flex; align-items: center; justify-content: space-between; height: 90px; padding: 0 28px; cursor: pointer;">
              <span style="font-size: 18px; line-height: 90px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: #fff;">Purity Tested</span>
              <span class="rg-diff__tile-toggle" style="width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.08); color: var(--rg-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);"><svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1,1 7,7 1,13"/></svg></span>
            </div>
            <div class="rg-diff__tile-panel" style="max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.22,1,0.36,1);">
              <div style="padding: 0 28px 28px 28px; color: rgba(255,255,255,0.75); font-size: 15px; line-height: 1.6;">
                <div style="font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--rg-accent); margin-bottom: 8px;">Purity Tested</div>
                <p style="margin: 0 0 10px;">Every batch third-party tested for heavy metals and pesticides.</p>
                <p style="margin: 0;">Every batch is verified by an independent lab before it ships — no shortcuts, no guesswork, just proof.</p>
              </div>
            </div>
          </div>

          <div class="rg-diff__tile" style="width: 100%; background: #393939; border-radius: 16px; overflow: hidden;">
            <div class="rg-diff__tile-header" style="display: flex; align-items: center; justify-content: space-between; height: 90px; padding: 0 28px; cursor: pointer;">
              <span style="font-size: 18px; line-height: 90px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: #fff;">Read The Label</span>
              <span class="rg-diff__tile-toggle" style="width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.08); color: var(--rg-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);"><svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1,1 7,7 1,13"/></svg></span>
            </div>
            <div class="rg-diff__tile-panel rg-diff__tile-panel--sf" style="max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.22,1,0.36,1);">
              <div style="margin: 0 20px 20px 20px; background: #fff; border: 2px solid #000; border-radius: 8px; overflow: hidden;">
                <div style="font-size: 15px; font-weight: 900; padding: 7px 12px 3px;">Supplement Facts</div>
                <div style="font-size: 8px; padding: 4px 12px; border-bottom: 2px solid #000;">Serving Size: 1 Scoop (10g)</div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; padding: 3px 12px; border-bottom: 1px solid #000; font-size: 8px; font-weight: 800;">
                  <span>Ingredient</span>
                  <span>Amount Per Serving</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 3px 12px; border-bottom: 1px solid #000; font-size: 9px;"><strong>Lion's Mane 10:1</strong><span>1,000 mg</span></div>
                <div style="display: flex; justify-content: space-between; padding: 3px 12px; border-bottom: 1px solid #000; font-size: 9px;"><strong>Creatine Monohydrate</strong><span>3,000 mg</span></div>
                <div style="display: flex; justify-content: space-between; padding: 3px 12px; border-bottom: 1px solid #000; font-size: 9px;"><strong>Amino Acids</strong><span>400 mg</span></div>
                <div style="display: flex; justify-content: space-between; padding: 3px 12px; border-bottom: 1px solid #000; font-size: 9px;"><strong>Adaptogens</strong><span>300 mg</span></div>
                <div style="display: flex; justify-content: space-between; padding: 3px 12px; font-size: 9px;"><strong>Low-Caffeine Arabica</strong><span>~50 mg</span></div>
                <div style="font-size: 7px; padding: 5px 12px 7px; line-height: 1.3; color: #333;">* Daily Value not established. No proprietary blends — every ingredient and dose clearly listed.</div>
              </div>
            </div>
          </div>

        </div>

        <script>
          document.addEventListener('DOMContentLoaded', function () {
            var allTiles = document.querySelectorAll('.rg-diff__tile');

            function closeTile(tile) {
              var toggle = tile.querySelector('.rg-diff__tile-toggle');
              var panel = tile.querySelector('.rg-diff__tile-panel');
              panel.style.maxHeight = '0px';
              toggle.style.transform = 'rotate(0deg)';
              tile.classList.remove('rg-diff__tile--open');
            }

            document.querySelectorAll('.rg-diff__tile-header').forEach(function (header) {
              header.addEventListener('click', function () {
                var tile = header.closest('.rg-diff__tile');
                var toggle = header.querySelector('.rg-diff__tile-toggle');
                var panel = tile.querySelector('.rg-diff__tile-panel');
                var isOpen = tile.classList.contains('rg-diff__tile--open');

                allTiles.forEach(function (t) {
                  if (t !== tile) closeTile(t);
                });

                if (isOpen) {
                  closeTile(tile);
                } else {
                  tile.classList.add('rg-diff__tile--open');
                  panel.style.maxHeight = panel.scrollHeight + 'px';
                  toggle.style.transform = 'rotate(90deg)';
                }
              });
            });
          });
        </script>

      </div>
    </div>
    <!-- Bottom benefit icons row -->
    <style>
      .rg-diff__benefit-card {
  display: flex; flex-direction: column; align-items: center; text-align: center;
  padding: 32px 16px; background: #fff; border: 1px solid #E4E4E7; border-radius: 10px;
  flex: 1 1 0; min-width: 150px;
  transition: transform 0.25s ease;
}
.rg-diff__benefit-card:hover {
  transform: translateY(-4px);
}
      .rg-diff__benefit-icon-v2 {
        width: 46px; height: 46px; border-radius: 50%;
        background: #F4F4F5; border: 1px solid #E4E4E7;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 18px; color: var(--rg-accent); flex-shrink: 0;
        transition: transform 0.2s ease;
      }
      .rg-diff__benefit-card:hover .rg-diff__benefit-icon-v2 { transform: scale(1.18); }
      .rg-diff__benefit-title-v2 {
        font-size: 14px; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.03em; color: #18181B; margin-bottom: 5px;
      }
      .rg-diff__benefit-desc-v2 { font-size: 11px; line-height: 1.65; color: #71717A; font-weight: 400; }
    </style>
    <div class="rg-diff__benefits-wrap" style="background: #F4F4F5; border-radius: 20px; margin-top: 32px; padding: 40px 32px;">
      <div class="rg-diff__benefits" style="display: flex; justify-content: space-between; align-items: stretch; gap: 16px; flex-wrap: wrap; border-top: none; padding-top: 0;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit_icon' -%}
            {%- assign benefit_desc = '' -%}
            {%- case block.settings.label -%}
              {%- when 'Laser Focus' -%}
                {%- assign benefit_desc = "Lift the brain fog, unlock a new level of mental clarity." -%}
              {%- when 'Smooth Energy' -%}
                {%- assign benefit_desc = "Stay energized while reducing stress on your nervous system." -%}
              {%- when 'Glowing Skin' -%}
                {%- assign benefit_desc = "Helps your skin cells retain moisture and improve tone." -%}
              {%- when 'Healthy Gut' -%}
                {%- assign benefit_desc = "Adaptogens work to improve your gut health function." -%}
              {%- else -%}
                {%- assign benefit_desc = "Supports your body's natural balance every day." -%}
            {%- endcase -%}
            <div class="rg-diff__benefit-card" {{ block.shopify_attributes }}>
              <span class="rg-diff__benefit-icon-v2">
                {%- case block.settings.icon -%}
                  {%- when 'skin' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- when 'gut' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  {%- when 'focus' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
                  {%- when 'energy' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
                  {%- else -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {%- endcase -%}
              </span>
              <div class="rg-diff__benefit-title-v2">{{ block.settings.label }}</div>
              <div class="rg-diff__benefit-desc-v2">{{ benefit_desc }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Differentiators",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "Functional Benefits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Makes It" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent word (blue)", "default": "Different" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Numbered Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Taste & Flavor" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Balanced, full-bodied coffee you know and love. Notes of smooth chocolate." }
      ]
    },
    {
      "type": "feature_card",
      "name": "Side Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "no-fillers", "label": "No Fillers" },
            { "value": "high-dosage", "label": "High Dosage" },
            { "value": "purity", "label": "Purity Tested" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "No Fillers" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "No mycelial biomass, starch, myceliated oats or cheaply made." }
      ]
    },
    {
      "type": "benefit_icon",
      "name": "Bottom Benefit Icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "skin", "label": "Star / Skin" },
            { "value": "gut", "label": "Gut" },
            { "value": "focus", "label": "Focus Target" },
            { "value": "energy", "label": "Energy Bolt" }
          ],
          "default": "skin"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Glowing Skin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Differentiators",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Taste & Flavor", "description": "Balanced, full-bodied coffee you know and love. Notes of smooth chocolate." } },
        { "type": "pillar", "settings": { "title": "High Dosage", "description": "Clinical strength formula with 10,000mg Lion's Mane – real doses that work." } },
        { "type": "pillar", "settings": { "title": "Purity Tested", "description": "Every batch third-party tested for heavy metals and pesticides." } },
        { "type": "pillar", "settings": { "title": "Read The Label", "description": "No proprietary blends. Every ingredient and dose clearly listed." } },
        { "type": "benefit_icon", "settings": { "icon": "skin", "label": "Glowing Skin" } },
        { "type": "benefit_icon", "settings": { "icon": "gut", "label": "Healthy Gut" } },
        { "type": "benefit_icon", "settings": { "icon": "focus", "label": "Laser Focus" } },
        { "type": "benefit_icon", "settings": { "icon": "energy", "label": "Smooth Energy" } }
      ]
    }
  ]
}
{% endschema %}