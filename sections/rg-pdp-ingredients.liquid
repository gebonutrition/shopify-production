{%- comment -%}
  RAW GRAVITY · Product page "Nootropics For Your Mind".
  Desktop: list | glass photo | list. Mobile: glass + intro, then a 2-column list.
  Every ingredient block has a detail panel in a native <dialog> (prev/next through all blocks);
  "Show in list" off keeps a block in the dialog only (e.g. L-Tyrosine, listed together with L-Theanine).
  Dialog behaviour: <rg-ingredients> from sections/rg-ingredients.liquid.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "08 Ingredients" + modal.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign listed_count = 0
  for block in section.blocks
    if block.settings.show_in_list
      assign listed_count = listed_count | plus: 1
    endif
  endfor
  assign left_count = s.left_count | at_most: listed_count
-%}

{%- capture glass -%}
  {%- if s.image != blank -%}
    {{
      s.image
      | image_url: width: 900
      | image_tag:
        widths: '300, 450, 600, 900',
        sizes: '(min-width: 990px) 300px, 40vw',
        loading: 'lazy',
        alt: s.image.alt
    }}
  {%- endif -%}
{%- endcapture -%}

<section
  class="rg rg-ingp"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-pdp-wrap">
    <div class="rg-ingp__head">
      <div class="rg-ingp__glass rg-ingp__glass--mobile">{{ glass }}</div>
      <div class="rg-ingp__intro">
        {%- if s.eyebrow != blank -%}
          <p class="rg-ingp__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="rg-pdp-h2 rg-ingp__title">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}
          <p class="rg-ingp__text">{{ s.text }}</p>
        {%- endif -%}
        {%- if s.fact != blank -%}
          <p class="rg-ingp__fact">{{ s.fact }}</p>
        {%- endif -%}
        {%- if s.hint != blank -%}
          <p class="rg-ingp__hint"><span aria-hidden="true">+</span>{{ s.hint | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <rg-ingredients class="rg-ingp__root">
      <div class="rg-ingp__grid">
        {%- liquid
          assign listed_index = 0
        -%}
        <ul class="rg-ingp__col rg-ingp__col--left" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.show_in_list -%}
              {%- assign listed_index = listed_index | plus: 1 -%}
              {%- if listed_index <= left_count -%}
                <li class="rg-ingp__row">
                  <button type="button" class="rg-ingp__item" data-rg-open="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                    <span class="rg-ingp__item-copy">
                      <span class="rg-ingp__name">{{ block.settings.list_name | default: block.settings.title | escape }}</span>
                      <span class="rg-ingp__dose">{{ block.settings.list_dose | default: block.settings.dose | escape }}</span>
                      {%- if block.settings.list_text != blank -%}
                        <span class="rg-ingp__desc">{{ block.settings.list_text | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="rg-ingp__plus" aria-hidden="true">+</span>
                  </button>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="rg-ingp__glass rg-ingp__glass--desktop">{{ glass }}</div>

        {%- assign listed_index = 0 -%}
        <ul class="rg-ingp__col rg-ingp__col--right" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.show_in_list -%}
              {%- assign listed_index = listed_index | plus: 1 -%}
              {%- if listed_index > left_count -%}
                <li class="rg-ingp__row">
                  <button type="button" class="rg-ingp__item" data-rg-open="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                    <span class="rg-ingp__item-copy">
                      <span class="rg-ingp__name">{{ block.settings.list_name | default: block.settings.title | escape }}</span>
                      <span class="rg-ingp__dose">{{ block.settings.list_dose | default: block.settings.dose | escape }}</span>
                      {%- if block.settings.list_text != blank -%}
                        <span class="rg-ingp__desc">{{ block.settings.list_text | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="rg-ingp__plus" aria-hidden="true">+</span>
                  </button>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <dialog class="rg-ingp__dialog" aria-label="{{ s.heading | escape }}">
        <span class="rg-ingp__handle" aria-hidden="true"></span>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="rg-ingp__panel" data-rg-panel="{{ forloop.index0 }}" hidden>
            <div class="rg-ingp__panel-media">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 800
                  | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 330px, 100vw', loading: 'lazy', alt: b.title
                }}
              {%- endif -%}
            </div>
            <div class="rg-ingp__panel-body">
              {%- if b.tag != blank -%}
                <span class="rg-ingp__panel-tag">{{ b.tag | escape }}</span>
              {%- endif -%}
              <h3 class="rg-ingp__panel-title">{{ b.title | escape }}</h3>
              {%- if b.dose != blank -%}
                <span class="rg-ingp__panel-dose">{{ b.dose | escape }}</span>
              {%- endif -%}
              {%- if b.text != blank -%}
                <p class="rg-ingp__panel-text">{{ b.text | escape }}</p>
              {%- endif -%}
              {%- if b.points != blank -%}
                {%- assign points = b.points | newline_to_br | split: '<br />' -%}
                <ul class="rg-ingp__points" role="list">
                  {%- for point in points -%}
                    {%- assign point_text = point | strip -%}
                    {%- if point_text != blank -%}
                      <li><span aria-hidden="true">✓</span>{{ point_text | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="rg-ingp__panel-nav">
                <button type="button" class="rg-ingp__nav-btn" data-rg-prev>‹ Prev</button>
                <span class="rg-ingp__counter">{{ forloop.index }} / {{ total }}</span>
                <button type="button" class="rg-ingp__nav-btn" data-rg-next>Next ›</button>
              </div>
            </div>
          </article>
        {%- endfor -%}
        <button type="button" class="rg-ingp__close" data-rg-close aria-label="Close">×</button>
      </dialog>
    </rg-ingredients>

    {%- if s.button_label != blank -%}
      <div class="rg-ingp__cta">
        <a class="rg-ingp__button" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-ingp {
    background: var(--rg-bg);
  }

  .rg-ingp .rg-pdp-wrap {
    padding-block: 40px;
  }

  .rg-ingp__head {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .rg-ingp__glass {
    position: relative;
  }

  .rg-ingp__glass img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-ingp__glass--mobile {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  .rg-ingp__glass--desktop {
    display: none;
  }

  .rg-ingp__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .rg-ingp__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--rg-accent);
  }

  .rg-ingp .rg-ingp__title {
    font-size: 26px;
    line-height: 1;
    text-transform: uppercase;
  }

  .rg-ingp__text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--rg-graphite);
    text-wrap: pretty;
  }

  .rg-ingp__fact {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--rg-text-3);
  }

  .rg-ingp__fact strong {
    color: var(--rg-graphite);
  }

  .rg-ingp__hint {
    display: none;
  }

  .rg-ingp__grid {
    margin-top: 22px;
  }

  .rg-ingp__col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ingp__item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 12px 0 14px;
    border: 0;
    border-top: 1px solid #e3e3e0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .rg-ingp__item:hover {
    opacity: 0.85;
  }

  .rg-ingp__item:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: 2px;
  }

  .rg-ingp__item-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .rg-ingp__name {
    font-family: var(--rg-font-display);
    font-size: 12.5px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--rg-ink);
  }

  .rg-ingp__dose {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--rg-accent);
  }

  .rg-ingp__desc {
    display: none;
  }

  .rg-ingp__plus {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #efefed;
    color: var(--rg-accent);
    font-size: 18px;
    font-weight: 300;
    line-height: 1;
  }

  .rg-ingp__cta {
    margin-top: 18px;
  }

  .rg-ingp__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    border-radius: var(--rg-radius-btn);
    background: var(--rg-accent);
    color: var(--rg-ink);
    font: 800 16px/1 var(--rg-font-body);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .rg-ingp__button:hover {
    filter: brightness(1.05);
    color: var(--rg-ink);
  }

  .rg-ingp__button:focus-visible {
    outline: 2px solid var(--rg-ink);
    outline-offset: 3px;
  }

  /* Dialog: bottom sheet on mobile */
  .rg-ingp__dialog {
    position: fixed;
    inset: auto 0 0;
    width: min(430px, 100%);
    max-width: none;
    max-height: 88vh;
    margin: 0 auto;
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 24px 24px 0 0;
    background: var(--rg-white);
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.3);
    color: var(--rg-graphite);
  }

  .rg-ingp__dialog::backdrop {
    background: rgba(20, 20, 20, 0.55);
    backdrop-filter: blur(4px);
  }

  .rg-ingp__handle {
    display: block;
    width: 40px;
    height: 4px;
    margin: 10px auto 0;
    border-radius: 2px;
    background: #d9d9d9;
  }

  .rg-ingp__panel[hidden] {
    display: none;
  }

  .rg-ingp__panel-media {
    position: relative;
    height: 200px;
    margin: 12px 16px 0;
    overflow: hidden;
    border-radius: 16px;
    background: #eceef2;
  }

  .rg-ingp__panel-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-ingp__panel-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 20px 24px;
  }

  .rg-ingp__panel-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--rg-accent-dark);
  }

  .rg-ingp__panel-title {
    margin: 0;
    font-family: var(--rg-font-body);
    font-size: 24px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--rg-graphite);
  }

  .rg-ingp__panel-dose {
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--rg-offer);
    font-size: 13px;
    font-weight: 800;
  }

  .rg-ingp__panel-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--rg-text-2);
    text-wrap: pretty;
  }

  .rg-ingp__points {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ingp__points li {
    display: flex;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
  }

  .rg-ingp__points span {
    color: var(--rg-accent-dark);
    font-weight: 800;
  }

  .rg-ingp__panel-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--rg-line-2);
  }

  .rg-ingp__nav-btn {
    height: 44px;
    padding: 0 16px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: var(--rg-white);
    color: var(--rg-graphite);
    font: 700 14px/1 var(--rg-font-body);
    cursor: pointer;
  }

  .rg-ingp__nav-btn:hover {
    border-color: var(--rg-accent);
  }

  .rg-ingp__counter {
    font-size: 13px;
    font-weight: 600;
    color: #8a8a8a;
  }

  .rg-ingp__close {
    position: absolute;
    top: 30px;
    right: 28px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--rg-graphite);
    color: var(--rg-white);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .rg-ingp .rg-pdp-wrap {
      padding-block: clamp(28px, 4.5vh, 44px);
    }

    .rg-ingp__head {
      display: block;
      text-align: center;
    }

    .rg-ingp__glass--mobile,
    .rg-ingp__eyebrow {
      display: none;
    }

    .rg-ingp__intro {
      display: block;
    }

    .rg-ingp .rg-ingp__title {
      margin-bottom: 12px;
      font-size: clamp(32px, 3.2vw, 46px);
      line-height: 1.05;
      text-transform: none;
    }

    .rg-ingp__text {
      max-width: 720px;
      margin: 0 auto;
      font-size: 18px;
      line-height: 1.6;
      color: #3a3a3a;
    }

    .rg-ingp__fact {
      margin-top: 12px;
      font-size: 16px;
      line-height: 1.5;
    }

    .rg-ingp__fact strong {
      color: #3a3a3a;
    }

    .rg-ingp__hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 12px 0 0;
      font-size: 15px;
      color: var(--rg-text-3);
    }

    .rg-ingp__hint span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #efefed;
      color: var(--rg-accent);
      font-size: 17px;
      font-weight: 300;
    }

    .rg-ingp__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.8fr) minmax(0, 1.15fr);
      gap: 36px;
      align-items: stretch;
      margin-top: 24px;
    }

    .rg-ingp__col {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: minmax(0, 1fr);
      border-bottom: 1px solid #e3e3e0;
    }

    .rg-ingp__item {
      align-items: center;
      gap: 20px;
      padding: 8px 0;
    }

    .rg-ingp__col--right .rg-ingp__item {
      flex-direction: row-reverse;
      text-align: right;
    }

    .rg-ingp__col--right .rg-ingp__item-copy {
      align-items: flex-end;
    }

    .rg-ingp__item-copy {
      gap: 3px;
    }

    .rg-ingp__name {
      font-size: 15px;
      line-height: 1.15;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .rg-ingp__dose {
      font-size: 12px;
      letter-spacing: 0.2em;
    }

    .rg-ingp__desc {
      display: block;
      font-size: 14px;
      line-height: 1.45;
      color: var(--rg-text-2);
    }

    .rg-ingp__plus {
      width: 34px;
      height: 34px;
      font-size: 21px;
      transition: background 0.2s, color 0.2s;
    }

    .rg-ingp__glass--desktop {
      display: block;
      min-height: 320px;
    }

    .rg-ingp__cta {
      display: flex;
      justify-content: center;
      margin-top: 40px;
    }

    .rg-ingp__button {
      width: auto;
      height: 68px;
      padding: 0 60px;
      font-size: 19px;
      font-weight: 700;
      letter-spacing: 0;
    }

    .rg-ingp__dialog {
      inset: 0;
      width: min(780px, calc(100% - 80px));
      max-height: calc(100vh - 80px);
      margin: auto;
      border-radius: 28px;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    }

    .rg-ingp__handle {
      display: none;
    }

    .rg-ingp__panel:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .rg-ingp__panel-media {
      height: auto;
      min-height: 440px;
      margin: 0;
      border-radius: 0;
    }

    .rg-ingp__panel-body {
      gap: 16px;
      padding: 40px 36px 28px;
    }

    .rg-ingp__panel-tag {
      font-size: 13px;
      letter-spacing: 0.24em;
    }

    .rg-ingp__panel-title {
      padding-right: 40px;
      font-size: 30px;
      line-height: 1.1;
    }

    .rg-ingp__panel-dose {
      padding: 7px 14px;
      font-size: 15px;
    }

    .rg-ingp__panel-text {
      font-size: 16px;
      line-height: 1.65;
    }

    .rg-ingp__points {
      gap: 10px;
    }

    .rg-ingp__points li {
      font-size: 15px;
    }

    .rg-ingp__panel-nav {
      margin-top: auto;
      padding-top: 16px;
    }

    .rg-ingp__nav-btn {
      padding: 0 18px;
    }

    .rg-ingp__counter {
      font-size: 14px;
    }

    .rg-ingp__close {
      top: 16px;
      right: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Ingredients (product)",
  "class": "rg-ingp-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "ingredients"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mobile)",
      "default": "NOOTROPICS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nootropics For Your Mind"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "fact",
      "label": "Fun fact"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint (desktop)",
      "default": "Tap any ingredient to see the science behind it"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Glass photo"
    },
    {
      "type": "range",
      "id": "left_count",
      "label": "Ingredients in the left column (desktop)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY IT NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_in_list",
          "label": "Show in list",
          "default": true
        },
        {
          "type": "text",
          "id": "list_name",
          "label": "List name",
          "info": "Empty = detail title."
        },
        {
          "type": "text",
          "id": "list_dose",
          "label": "List dose",
          "info": "Empty = detail dose."
        },
        {
          "type": "text",
          "id": "list_text",
          "label": "List text (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Detail photo"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Detail tag",
          "default": "AMINO ACID"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Detail title",
          "default": "Ingredient"
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Detail dose",
          "default": "100 mg per serving"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Detail text"
        },
        {
          "type": "textarea",
          "id": "points",
