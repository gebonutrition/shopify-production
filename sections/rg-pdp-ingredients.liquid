{%- comment -%}
  RAW GRAVITY · Product page "What's inside / Nootropics For Your Mind".
  Desktop: list | glass photo | list (rendered through .rg-z). Mobile: glass + heading, then a 2-column list.
  Every ingredient block has a detail panel in a native <dialog> (prev/next through all blocks, in block order).
  The lists show the blocks named in "Left column" / "Right column" (block numbers, e.g. 2,3,1,4).
  Buy-box ingredient tiles open the same dialog (data-rg-ing-host, see sections/rg-pdp-main.liquid).
  Dialog behaviour: <rg-ingredients> from assets/rg-ingredients.js.
  Layout "Home page" (rg-ingp--home): main landing typography; on mobile the heading is centred
  with the glass below it, and the dialog is a bottom sheet.
  Reference: Raw Coffee Product Page v2(.dc.html) + Mobile v2, section "08 Ingredients" + modal;
  Raw Gravity Landing(.dc.html) + Mobile, section "Nootropics" (layout "Home page").
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign left_items = s.left_items | remove: ' ' | split: ','
  assign right_items = s.right_items | remove: ' ' | split: ','
-%}

{%- capture glass -%}
  {%- if s.image != blank -%}
    {{
      s.image
      | image_url: width: 1200
      | image_tag:
        widths: '300, 450, 600, 900, 1200',
        sizes: '(min-width: 990px) 33vw, 35vw',
        loading: 'lazy',
        alt: s.image.alt
    }}
  {%- endif -%}
{%- endcapture -%}

<script src="{{ 'rg-ingredients.js' | asset_url }}" type="module"></script>
<section
  class="rg rg-z rg-ingp rg-ingp--{{ s.layout | default: 'product' }}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="rg-ingp__inner">
    <div class="rg-ingp__head">
      <div class="rg-ingp__glass rg-ingp__glass--mobile">{{ glass }}</div>
      <div class="rg-ingp__intro">
        {%- if s.eyebrow != blank -%}
          <p class="rg-ingp__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="rg-pdp-h2 rg-ingp__title">{{ s.heading | escape }}</h2>
      </div>
    </div>

    <rg-ingredients class="rg-ingp__root" data-rg-ing-host>
      <div class="rg-ingp__grid">
        {%- for column in (1..2) -%}
          {%- liquid
            if column == 1
              assign column_items = left_items
              assign column_class = 'left'
            else
              assign column_items = right_items
              assign column_class = 'right'
            endif
          -%}
          <ul class="rg-ingp__col rg-ingp__col--{{ column_class }}" role="list">
            {%- for item in column_items -%}
              {%- assign item_index = item | plus: 0 | minus: 1 -%}
              {%- if item_index >= 0 and item_index < total -%}
                {%- assign block = section.blocks[item_index] -%}
                <li class="rg-ingp__row">
                  <button type="button" class="rg-ingp__item" data-rg-open="{{ item_index }}" {{ block.shopify_attributes }}>
                    <span class="rg-ingp__item-copy">
                      <span class="rg-ingp__name">{{ block.settings.list_name | default: block.settings.title | escape | newline_to_br }}</span>
                      <span class="rg-ingp__dose">{{ block.settings.list_dose | default: block.settings.dose | escape }}</span>
                      {%- if block.settings.list_text != blank -%}
                        <span class="rg-ingp__desc">{{ block.settings.list_text | escape | newline_to_br | replace: '<br />', '<br class="rg-br-d">' }}</span>
                      {%- endif -%}
                    </span>
                    <span class="rg-ingp__plus" aria-hidden="true">+</span>
                  </button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if column == 1 -%}
            <div class="rg-ingp__glass rg-ingp__glass--desktop">{{ glass }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <dialog class="rg-ingp__dialog" aria-label="{{ s.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="rg-ingp__panel" data-rg-panel="{{ forloop.index0 }}" hidden>
            <div class="rg-ingp__panel-media">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 800
                  | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 330px, 380px', loading: 'lazy', alt: b.title
                }}
              {%- endif -%}
            </div>
            <div class="rg-ingp__panel-body">
              <div class="rg-ingp__panel-scroll">
                {%- if b.tag != blank -%}
                  <span class="rg-ingp__panel-tag">{{ b.tag | escape }}</span>
                {%- endif -%}
                <h3 class="rg-ingp__panel-title">{{ b.title | escape }}</h3>
                {%- if b.dose != blank -%}
                  <span class="rg-ingp__panel-dose">{{ b.dose | escape }}</span>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <p class="rg-ingp__panel-text">{{ b.text | escape }}</p>
                {%- endif -%}
                {%- if b.points != blank -%}
                  {%- assign points = b.points | newline_to_br | split: '<br />' -%}
                  <ul class="rg-ingp__points" role="list">
                    {%- for point in points -%}
                      {%- assign point_text = point | strip -%}
                      {%- if point_text != blank -%}
                        <li><span aria-hidden="true">✓</span>{{ point_text | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
              <div class="rg-ingp__panel-nav">
                <button type="button" class="rg-ingp__nav-btn" data-rg-prev>‹ Prev</button>
                <span class="rg-ingp__counter">{{ forloop.index }} / {{ total }}</span>
                <button type="button" class="rg-ingp__nav-btn rg-ingp__nav-btn--next" data-rg-next>Next ›</button>
              </div>
            </div>
          </article>
        {%- endfor -%}
        <button type="button" class="rg-ingp__close" data-rg-close aria-label="Close">×</button>
      </dialog>
    </rg-ingredients>

    {%- if s.button_label != blank -%}
      <div class="rg-pdp-cta-row rg-ingp__cta">
        <a class="rg-pdp-cta" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ---------- Mobile ---------- */
  .rg-ingp {
    background: var(--rg-bg);
  }

  .rg-ingp__inner {
    padding: 40px 16px;
  }

  .rg-ingp__head {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .rg-ingp__glass {
    position: relative;
  }

  .rg-ingp__glass img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .rg-ingp__glass--mobile {
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .rg-ingp__glass--desktop {
    display: none;
  }

  .rg-ingp__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .rg-ingp__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--rg-accent);
  }

  .rg-ingp__root {
    display: block;
  }

  .rg-ingp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    margin-top: 14px;
  }

  .rg-ingp__col {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ingp__row {
    min-width: 0;
  }

  .rg-ingp__item {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 12px 30px 12px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .rg-ingp__item:hover {
    opacity: 0.85;
  }

  .rg-ingp__item:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: 2px;
  }

  .rg-ingp__item-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .rg-ingp__name {
    font-family: var(--rg-font-body);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--rg-ink);
  }

  .rg-ingp__dose {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--rg-accent);
  }

  .rg-ingp__desc {
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--rg-text-2);
  }

  .rg-ingp__plus {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #efefed;
    color: var(--rg-accent);
    font-size: 16px;
    font-weight: 300;
    line-height: 1;
  }

  .rg-ingp .rg-ingp__cta {
    margin-top: 18px;
  }

  /* Dialog (dark) */
  .rg-ingp__dialog {
    width: min(380px, calc(100% - 32px));
    max-width: none;
    height: min(600px, calc(100vh - 32px));
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(28, 203, 245, 0.35);
    border-radius: 14px;
    background: radial-gradient(ellipse at 100% 0%, #26464f 0%, #323232 50%, #2e2e2e 100%);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 30px rgba(28, 203, 245, 0.15);
    color: var(--rg-on-dark);
  }

  .rg-ingp__dialog::backdrop {
    background: rgba(10, 14, 16, 0.6);
    backdrop-filter: blur(6px);
  }

  .rg-ingp__panel:not([hidden]) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .rg-ingp__panel[hidden] {
    display: none;
  }

  .rg-ingp__panel-media {
    position: relative;
    flex: none;
    height: 36%;
    background: #3a3a3a;
  }

  .rg-ingp__panel-media::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 50px;
    background: linear-gradient(180deg, rgba(46, 46, 46, 0), #2f3536);
    pointer-events: none;
  }

  .rg-ingp__panel-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rg-ingp__panel-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .rg-ingp__panel-scroll {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
    padding: 10px 18px 14px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .rg-ingp__panel-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--rg-accent);
  }

  .rg-ingp__panel-title {
    margin: 0;
    font-family: var(--rg-font-body);
    font-size: 20px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--rg-on-dark);
  }

  .rg-ingp__panel-dose {
    align-self: flex-start;
    max-width: 100%;
    padding: 5px 10px;
    border: 1px solid rgba(28, 203, 245, 0.45);
    border-radius: 8px;
    background: rgba(28, 203, 245, 0.15);
    color: var(--rg-accent);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.35;
  }

  .rg-ingp__panel-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #d0d4d6;
    text-wrap: pretty;
  }

  .rg-ingp__points {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rg-ingp__points li {
    display: flex;
    gap: 9px;
    font-size: 13px;
    font-weight: 500;
    color: var(--rg-on-dark);
  }

  .rg-ingp__points span {
    color: var(--rg-accent);
    font-weight: 800;
  }

  .rg-ingp__panel-nav {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 18px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .rg-ingp__nav-btn {
    flex: none;
    height: 38px;
    padding: 0 14px;
    border: 1px solid rgba(28, 203, 245, 0.4);
    border-radius: 8px;
    background: transparent;
    color: var(--rg-on-dark);
    font: 700 13px/1 var(--rg-font-body);
    white-space: nowrap;
    cursor: pointer;
  }

  .rg-ingp__nav-btn--next {
    height: 42px;
    padding: 0 26px;
    border: 0;
    border-radius: 10px;
    background: var(--rg-accent);
    box-shadow: 0 0 14px rgba(28, 203, 245, 0.5);
    color: var(--rg-ink);
    font-weight: 800;
  }

  .rg-ingp__nav-btn:focus-visible,
  .rg-ingp__close:focus-visible {
    outline: 2px solid var(--rg-accent);
    outline-offset: 2px;
  }

  .rg-ingp__counter {
    font-size: 12px;
    font-weight: 600;
    color: #9aa3a6;
  }

  .rg-ingp__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(20, 20, 20, 0.55);
    backdrop-filter: blur(6px);
    color: var(--rg-on-dark);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  /* ---------- Desktop (rendered through .rg-z) ---------- */
  @media screen and (min-width: 990px) {
    .rg-ingp {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100vh / var(--rg-z, 1) - 140px);
    }

    .rg-ingp__inner {
      display: flex;
      flex: 1;
      flex-direction: column;
      justify-content: center;
      width: 100%;
      max-width: 1760px;
      margin: 0 auto;
      padding: clamp(40px, 6vh, 64px) 40px clamp(32px, 4vh, 48px);
    }

    .rg-ingp__head {
      display: block;
      text-align: center;
    }

    .rg-ingp__glass--mobile {
      display: none;
    }

    .rg-ingp__intro {
      display: block;
    }

    .rg-ingp__eyebrow {
      margin: 0 0 16px;
      font-size: 15px;
      color: var(--rg-accent-dark);
    }

    .rg-ingp .rg-ingp__title {
      margin: 0 0 100px;
    }

    /* The grid fills the section height (design: section min-height = viewport - 140px) */
    .rg-ingp__root {
      display: flex;
      flex: 1;
      flex-direction: column;
      min-height: 0;
    }

    .rg-ingp__grid {
      position: relative;
      flex: 1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
      align-items: stretch;
      justify-items: center;
      max-height: 820px;
      margin: 0;
    }

    .rg-ingp__col {
      display: grid;
      grid-template-rows: repeat(4, auto);
      align-content: space-between;
    }

    .rg-ingp__item {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 20px;
      padding: 12px 0;
    }

    .rg-ingp__col--right {
      text-align: right;
    }

    .rg-ingp__col--right .rg-ingp__item {
      flex-direction: row-reverse;
      text-align: right;
    }

    .rg-ingp__col--right .rg-ingp__item-copy {
      align-items: flex-end;
    }

    .rg-ingp__item-copy {
      flex: 1 1 auto;
      gap: 4px;
      max-width: 480px;
    }

    .rg-ingp__name {
      font-size: 23px;
      line-height: 1.15;
      text-wrap: balance;
    }

    .rg-ingp__dose {
      font-size: 19px;
      letter-spacing: 0.02em;
    }

    .rg-ingp__desc {
      font-size: 17px;
      line-height: 1.45;
    }

    .rg-ingp__plus {
      position: relative;
      top: auto;
      right: auto;
      z-index: 2;
      flex: none;
      width: 48px;
      height: 48px;
      font-size: 28px;
      transition: background 0.2s, color 0.2s;
    }

    .rg-ingp__item:hover .rg-ingp__plus {
      background: var(--rg-accent);
      box-shadow: 0 0 14px rgba(28, 203, 245, 0.55);
      color: var(--rg-white);
    }

    .rg-ingp__glass--desktop {
      display: block;
      justify-self: stretch;
      width: 100%;
      min-height: 500px;
    }

    .rg-ingp .rg-ingp__glass--desktop img {
      top: -14%;
      left: -16%;
      width: 132%;
      max-width: none;
      height: 114%;
      object-position: center bottom;
      pointer-events: none;
    }

    .rg-ingp .rg-ingp__cta {
      position: relative;
      z-index: 3;
      flex: none;
      margin-top: clamp(28px, 4vh, 44px);
    }

    .rg-ingp__dialog {
      width: min(780px, calc(100% - 80px));
      height: min(560px, calc(100vh / var(--rg-z, 1) - 80px));
      border-radius: 28px;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    }

    .rg-ingp__dialog::backdrop {
      background: rgba(20, 20, 20, 0.55);
      backdrop-filter: blur(4px);
    }

    .rg-ingp__panel:not([hidden]) {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .rg-ingp__panel-media {
      height: 100%;
    }

    .rg-ingp__panel-media::after {
      display: none;
    }

    .rg-ingp__panel-body {
      gap: 14px;
      height: 100%;
      padding: 40px 36px 24px;
    }

    .rg-ingp__panel-scroll {
      gap: 14px;
      padding: 0 6px 0 0;
      scrollbar-color: #4a5a5f transparent;
      scrollbar-width: thin;
    }

    .rg-ingp__panel-tag {
      font-size: 13px;
    }

    .rg-ingp__panel-title {
      padding-right: 40px;
      font-size: 30px;
      line-height: 1.1;
    }

    .rg-ingp__panel-dose {
      padding: 7px 14px;
      font-size: 17px;
    }

    .rg-ingp__panel-text,
    .rg-ingp__points li {
      font-size: 17px;
      line-height: 1.6;
    }

    .rg-ingp__points {
      gap: 10px;
    }

    .rg-ingp__points li {
      gap: 10px;
      line-height: normal;
    }

    .rg-ingp__panel-nav {
      padding: 16px 0 0;
      border-top-color: rgba(255, 255, 255, 0.12);
    }

    .rg-ingp__nav-btn,
    .rg-ingp__nav-btn--next {
      height: 44px;
      padding: 0 18px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 10px;
      background: transparent;
      box-shadow: none;
      color: var(--rg-on-dark);
      font-size: 17px;
      font-weight: 700;
    }

    .rg-ingp__nav-btn:hover {
      border-color: var(--rg-accent);
    }

    .rg-ingp__counter {
      font-size: 17px;
      color: var(--rg-on-dark-2);
    }

    .rg-ingp__close {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
      border-color: rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: none;
      font-size: 22px;
    }
  }

  /* ---------- Layout "Home page" (Raw Gravity Landing + Mobile, "Nootropics") ---------- */
  @media screen and (max-width: 989px) {
    .rg-ingp--home .rg-ingp__inner {
      padding: 40px 16px 36px;
    }

    .rg-ingp--home .rg-ingp__head {
      display: flex;
      flex-direction: column;
      text-align: center;
    }

    .rg-ingp--home .rg-ingp__glass--mobile {
      order: 2;
      height: 260px;
      margin: 8px 0 4px;
      aspect-ratio: auto;
    }

    .rg-ingp--home .rg-ingp__intro {
      display: block;
    }

    .rg-ingp--home .rg-ingp__eyebrow {
      margin: 0 0 10px;
      font-size: 9px;
    }

    .rg-ingp--home .rg-ingp__title {
      font-size: clamp(26px, 3.436svh, 33px);
      line-height: 1.04;
    }

    .rg-ingp--home .rg-ingp__grid {
      gap: 14px 18px;
      margin-top: 0;
    }

    .rg-ingp--home .rg-ingp__item {
      padding: 8px 0;
    }

    .rg-ingp--home .rg-ingp__item-copy {
      gap: 5px;
    }

    .rg-ingp--home .rg-ingp__name {
      padding-right: 28px;
      line-height: 1.15;
      text-wrap: balance;
    }

    .rg-ingp--home .rg-ingp__dose {
      font-size: 12px;
    }

    .rg-ingp--home .rg-ingp__desc {
      font-size: 11px;
      line-height: 1.4;
      text-wrap: pretty;
    }

    .rg-ingp--home .rg-ingp__plus {
      top: 6px;
      right: 0;
      width: 26px;
      height: 26px;
      font-size: clamp(16px, 2.133svh, 21px);
    }

    .rg-ingp--home .rg-pdp-cta {
      width: fit-content;
      min-width: 50%;
      height: auto;
      min-height: 50px;
      border-radius: 12px;
      font-size: clamp(13px, 1.777svh, 17px);
    }

    /* Dialog: bottom sheet */
    .rg-ingp--home .rg-ingp__dialog {
      width: 100%;
      max-width: 430px;
      height: 88dvh;
      margin: auto auto 0;
      border-bottom: 0;
      border-radius: 24px 24px 0 0;
      box-shadow: none;
    }

    .rg-ingp--home .rg-ingp__dialog::backdrop {
      background: rgba(20, 20, 20, 0.55);
      backdrop-filter: blur(4px);
    }

    .rg-ingp--home .rg-ingp__panel-media {
      height: 34%;
    }

    .rg-ingp--home .rg-ingp__panel-media::after {
      display: none;
    }

    .rg-ingp--home .rg-ingp__panel-scroll {
      padding: 20px 20px 0;
      gap: 10px;
    }

    .rg-ingp--home .rg-ingp__panel-tag {
      font-size: 11px;
    }

    .rg-ingp--home .rg-ingp__panel-title {
      font-size: clamp(21px, 2.844svh, 27px);
      line-height: 1.1;
    }

    .rg-ingp--home .rg-ingp__panel-dose {
      padding: 6px 12px;
      font-size: clamp(12px, 1.659svh, 16px);
    }

    .rg-ingp--home .rg-ingp__panel-text,
    .rg-ingp--home .rg-ingp__points li {
      font-size: clamp(13px, 1.777svh, 17px);
      line-height: 1.55;
    }

    .rg-ingp--home .rg-ingp__points {
      gap: 8px;
    }

    .rg-ingp--home .rg-ingp__points li {
      gap: 10px;
    }

    .rg-ingp--home .rg-ingp__panel-nav {
      margin: 12px 20px 0;
      padding: 12px 0 16px;
      border-top-color: rgba(255, 255, 255, 0.12);
    }

    .rg-ingp--home .rg-ingp__nav-btn,
    .rg-ingp--home .rg-ingp__nav-btn--next {
      height: 44px;
      padding: 0 16px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 10px;
      background: transparent;
      box-shadow: none;
      color: var(--rg-on-dark);
      font-size: clamp(13px, 1.777svh, 17px);
      font-weight: 700;
    }

    .rg-ingp--home .rg-ingp__counter {
      font-size: clamp(13px, 1.777svh, 17px);
      color: var(--rg-on-dark-2);
    }

    .rg-ingp--home .rg-ingp__close {
      top: 12px;
      right: 12px;
      width: 44px;
      height: 44px;
      border-color: rgba(255, 255, 255, 0.3);
      background: rgba(26, 26, 26, 0.55);
      font-size: clamp(19px, 2.607svh, 25px);
    }
  }

  @media screen and (min-width: 990px) {
    .rg-ingp--home {
      min-height: calc((100vh - var(--header-height, 60px)) / var(--rg-z, 1));
    }

    .rg-ingp--home .rg-ingp__eyebrow {
      font-size: 13px;
      letter-spacing: 0.38em;
      color: var(--rg-accent);
    }

    .rg-ingp--home .rg-ingp__title {
      font-size: clamp(37px, calc(100vh / var(--rg-z, 1) * 0.0511), 55px);
      line-height: 1.04;
    }

    .rg-ingp--home .rg-pdp-cta {
      font-size: 17px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RG · Ingredients v3",
  "class": "rg-ingp-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "product", "label": "Product page" },
        { "value": "home", "label": "Home page" }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "ingredients"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT’S INSIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nootropics For Your Mind"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Glass photo"
    },
    {
      "type": "text",
      "id": "left_items",
      "label": "Left column",
      "default": "1,2,3,4",
      "info": "Ingredient block numbers in display order, comma-separated. Mobile shows left, then right."
    },
    {
      "type": "text",
      "id": "right_items",
      "label": "Right column",
      "default": "5,6,7,8"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "TRY IT NOW →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Empty = back to the buy box (#buy)."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "textarea",
          "id": "list_name",
          "label": "List name",
          "info": "Empty = detail title. A line break is kept."
        },
        {
          "type": "text",
          "id": "list_dose",
          "label": "List dose",
          "info": "Empty = detail dose."
        },
        {
          "type": "textarea",
          "id": "list_text",
          "label": "List text",
          "info": "A line break shows on desktop only."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Detail photo"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Detail tag",
          "default": "AMINO ACID"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Detail title",
          "default": "Ingredient"
        },
        {
          "type": "text",
          "id": "dose",
          "label": "Detail dose",
          "default": "100 mg per serving"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Detail text"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "Detail checklist",
          "info": "One per line."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "RG · Ingredients v3",
      "blocks": [{ "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }]
    }
  ]
}
{% endschema %}
