    "faq": {
      "type": "faq",
      "blocks": {
        "faq-1": {
          "type": "faq_item",
          "settings": {
            "question": "How does mushroom coffee taste?",
            "answer": "<p>Like a rich, smooth cup of coffee. Brew Extreme is made with premium Arabica beans, and the mushroom extracts are odorless and flavorless at the doses we use — no earthy or bitter aftertaste.</p>"
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "question": "How much caffeine is in each serving?",
            "answer": "<p>About 50mg per serving — roughly half a standard cup of coffee. Paired with L-Theanine, it delivers smooth, sustained energy without jitters or the afternoon crash.</p>"
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between Brew Extreme and Raw Coffee+?",
            "answer": "<p>Brew Extreme is our premium flagship with the full nootropic stack: Alpha-GPC, Creatine, L-Tyrosine, Ginkgo, Lion's Mane, and L-Theanine. Raw Coffee+ is our everyday blend with functional mushrooms for immune and energy support.</p>"
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I prepare it?",
            "answer": "<p>Add one scoop (10g) to 8–12oz of hot or cold water and stir. For best results, use water between 175–195°F. It also works great in a French press, pour-over, or blended into a latte.</p>"
          }
        },
        "faq-5": {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe to drink every day?",
            "answer": "<p>Yes. Every ingredient is included at safe, clinically studied doses for daily consumption. If you're sensitive to caffeine, start with half a scoop for the first few days.</p>"
          }
        },
        "faq-6": {
          "type": "faq_item",
          "settings": {
            "question": "How does the subscription work?",
            "answer": "<p>Subscribers save 20% on every order and get free shipping automatically. Skip, pause, or cancel anytime — no hoops, no fees. We send a reminder email 3 days before each renewal.</p>"
          }
        },
        "faq-7": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes. We offer a 30-day, no-questions-asked money-back guarantee. If you're not satisfied for any reason, contact us and we'll issue a full refund.</p>"
          }
        },
        "faq-8": {
          "type": "faq_item",
          "settings": {
            "question": "Where are your mushrooms sourced?",
            "answer": "<p>All mushroom extracts come from certified organic farms and are fruiting-body only — not mycelium on grain. Every batch is third-party tested for heavy metals, pesticides, and potency.</p>"
          }
        }
      },
