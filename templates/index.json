    "rg_faq": {
      "type": "rg-faq",
      "blocks": {
        "rg_faq_1": {
          "type": "question",
          "settings": {
            "question": "What does mushroom coffee taste like?",
            "answer": "<p>Bold Arabica flavor with a deep, full-bodied mushroom note from our 10:1 Lion’s Mane extract, the highest amount among functional coffees on the market. No artificial flavors or maskers, just the real taste of a quality mushroom coffee that works.</p>"
          }
        },
        "rg_faq_2": {
          "type": "question",
          "settings": {
            "question": "How much caffeine is in each serving?",
            "answer": "<p>About 23mg, roughly a quarter of a regular cup of coffee (~90mg). Paired with L-Theanine, it gives you smooth, steady energy without the jitters or the afternoon crash.</p>"
          }
        },
        "rg_faq_3": {
          "type": "question",
          "settings": {
            "question": "How do I prepare it?",
            "answer": "<p>There are many ways to enjoy it, but our customers love the classic: add one scoop (7g) to 8–12 oz of hot water (around 185–195°F) and stir for 15 seconds. Prefer it iced? Mix with a splash of hot water, then add ice and your favorite oat or almond milk. It also makes a great latte. Try it with your favorite syrup, and banana is a fan favorite!</p>"
          }
        },
        "rg_faq_4": {
          "type": "question",
          "settings": {
            "question": "Is it safe to drink every day?",
            "answer": "<p>Yes, it's made for daily use. With only ~23mg of caffeine per serving, it's much gentler than regular coffee. If you're pregnant, nursing, taking medication or have a medical condition, check with your doctor first.</p>"
          }
        },
        "rg_faq_5": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes. If you're not happy for any reason, contact us within 60 days and we'll give you a full refund, no questions asked.</p>"
          }
        },
        "rg_faq_6": {
          "type": "question",
          "settings": {
            "question": "Where are your mushrooms sourced?",
            "answer": "<p>Our Lion's Mane is 100% fruiting body, not mycelium grown on grain. All mushroom extracts come from certified organic farms, and every batch is third-party tested for heavy metals, pesticides and potency.</p>"
          }
        },
        "rg_faq_7": {
          "type": "question",
          "settings": {
            "question": "Does the powder dissolve completely without leaving a gritty texture?",
            "answer": "<p>Yes, absolutely. We use advanced micro-soluble processing for an ultra-fine powder. Unlike others that leave gritty residue or clumps, our formula stirs smoothly into both hot and cold liquids.</p>"
          }
        },
        "rg_faq_8": {
          "type": "question",
          "settings": {
            "question": "Will this cause stomach discomfort, acid reflux, or caffeine jitters?",
            "answer": "<p>No. Our brew uses low-acid Arabica combined with L-Theanine and soothing adaptogens. This buffers acidity and slows caffeine absorption, delivering clean, calm focus without the stomach upset, anxiety, or caffeine crash common with regular coffee.</p>"
          }
        },
        "rg_faq_9": {
          "type": "question",
          "settings": {
            "question": "Are you using real mushroom fruiting bodies or cheap mycelium on grain?",
            "answer": "<p>We use 100% organic Lion’s Mane fruiting bodies (10:1 extract). Many cheaper brands cut costs by using \"mycelium grown on grain,\" which is essentially starch filler. We deliver pure, active potency with zero fillers, grain, or unnecessary additives.</p>"
          }
        },
        "rg_faq_10": {
          "type": "question",
          "settings": {
            "question": "Why is Raw Coffee+ the smartest choice for my daily routine?",
            "answer": "<p>You get a complete functional stack, not just caffeine. One bag replaces daily coffee, energy boosters, and supplements. It delivers clean, crash-free focus and maximum support at a fraction of the cost of individual ingredients.</p>"
          }
        }
      },
