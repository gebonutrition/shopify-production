    "rg_ingredients": {
      "type": "rg-ingredients",
      "blocks": {
        "rg_ing_1": {
          "type": "ingredient",
          "settings": {
            "name": "CREATINE MONOHYDRATE",
            "dose": "3,000 mg",
            "sub": "More power for your body and your brain.",
            "text": "Creatine is your body's natural energy reserve. It's stored in your muscles and brain and helps them recharge fast. It's one of the most studied supplements in the world, and Raw Gravity is one of the only coffees that puts a full 3,000mg in your cup. No extra shakers, no extra pills.",
            "image": "shopify://shop_images/rg-ing-1.jpg"
          }
        },
        "rg_ing_2": {
          "type": "ingredient",
          "settings": {
            "name": "100% ARABICA COFFEE DECAFFEINATED (<2% CAFFEINE)",
            "dose": "2,300 mg",
            "sub": "Real coffee taste. Smooth energy. No jitters.",
            "text": "Arabica is the world's favorite coffee bean: smooth, rich and less bitter. We use 100% Arabica with less than 2% caffeine, only ~23mg per cup, about a quarter of a regular coffee. You keep the taste and the morning ritual you love, without the racing heart, the shaky hands or the afternoon crash.",
            "image": "shopify://shop_images/rg-ing-2.jpg"
          }
        },
        "rg_ing_3": {
          "type": "ingredient",
          "settings": {
            "name": "LION'S MANE MUSHROOM EXTRACT 10:1 (50% POLYSACCHARIDES)",
            "dose": "1,000 mg",
            "sub": "Stay sharp, focused and clear-headed.",
            "text": "Lion's Mane is a unique white mushroom, valued in Asia for centuries as \"food for the mind.\" Many brands hide a tiny amount in a blend. We give you a full 1,000mg of a 10:1 extract from 100% fruiting body, standardized to 50% polysaccharides: 10 kg of real mushrooms concentrated into every 1 kg we use.",
            "image": "shopify://shop_images/rg-ing-3.jpg"
          }
        },
        "rg_ing_4": {
          "type": "ingredient",
          "settings": {
            "name": "TAURINE",
            "dose": "200 mg",
            "sub": "Energy that lasts all day.",
            "text": "Taurine is an amino acid your body already makes, found naturally in your heart, brain and muscles. We added it to help keep your energy steady and your stamina up, so your cup works longer than regular coffee. Clean energy support, without the sugar or crazy doses of energy drinks.",
            "image": "shopify://shop_images/rg-ing-4.jpg"
          }
        },
        "rg_ing_5": {
          "type": "ingredient",
          "settings": {
            "name": "L-THEANINE",
            "dose": "100 mg",
            "sub": "Calm focus, zero jitters.",
            "text": "L-Theanine comes from tea leaves. It's the secret behind that \"awake but relaxed\" feeling you get from green tea. Paired with our low caffeine, it smooths out your energy, so you stay alert and calm at the same time. It's a favorite combo of biohackers worldwide.",
            "image": "shopify://shop_images/rg-ing-5.jpg"
          }
        },
        "rg_ing_6": {
          "type": "ingredient",
          "settings": {
            "name": "L-TYROSINE",
            "dose": "100 mg",
            "sub": "Motivation to get things done.",
            "text": "L-Tyrosine is an amino acid your body uses to make dopamine, your brain's \"let's do this\" signal. You'll find it in foods like eggs, cheese and fish. In your cup, it helps you stay driven and on task, whether that's a work project, a workout or a to-do list.",
            "image": "shopify://shop_images/rg-ing-6.jpg"
          }
        },
        "rg_ing_7": {
          "type": "ingredient",
          "settings": {
            "name": "HOLY BASIL EXTRACT",
            "dose": "100 mg",
            "sub": "Stay calm when life gets busy.",
            "text": "Holy Basil, or Tulsi, is called the \"Queen of Herbs\" in India and has been used in Ayurveda for over 3,000 years. It's a true adaptogen: a plant that helps your body handle everyday stress. One more reason your coffee leaves you balanced, not wired.",
            "image": "shopify://shop_images/rg-ing-7.jpg"
          }
        },
        "rg_ing_8": {
          "type": "ingredient",
          "settings": {
            "name": "BACOPA MONNIERI (20% BACOSIDES)",
            "dose": "100 mg",
            "sub": "Remember more, forget less.",
            "text": "Bacopa is a small water plant used in Ayurveda for centuries to support memory and learning. Its active compounds are called bacosides, and our extract is standardized to 20%, so you know exactly what you're getting. It helps you hold on to names, details and ideas a little better every day.",
            "image": "shopify://shop_images/rg-ing-8.jpg"
          }
        },
        "rg_ing_9": {
          "type": "ingredient",
          "settings": {
            "name": "GINKGO BILOBA LEAF EXTRACT 10:1",
            "dose": "100 mg",
            "sub": "Feel mentally sharp and alert.",
            "text": "Ginkgo is one of the oldest tree species on Earth, often called a \"living fossil.\" Its leaves have been used for centuries to support healthy blood flow to the brain. We use a concentrated 10:1 leaf extract to help you stay sharp, quick and clear.",
            "image": "shopify://shop_images/rg-ing-9.jpg"
          }
        }
      },
