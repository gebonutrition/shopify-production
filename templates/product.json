    "rg_reviews": {
      "type": "rg-pdp-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "group": "ENERGY",
            "photo": "shopify://shop_images/rg-pdp-rev-kate.jpg",
            "title": "Just amazing",
            "text": "I was looking for something with less caffeine because regular coffee gave me energy spikes and made my hands shake, it was just too strong for me. This coffee was perfect instead. It's also really instant, it dissolves completely, with no clumps, unlike other 'instant' coffees I've tried. Now I can drink it a few times a day and feel fine, no shakes, no crash. Would definitely order it again.",
            "name": "Kate St",
            "badge": "✓ Verified Buyer"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "group": "ENERGY",
            "photo": "shopify://shop_images/rg-pdp-rev-pchu.jpg",
            "title": "Excellent coffee replacement",
            "text": "I'm extremely happy with this one. The blend of herbs and mushrooms is excellent for giving you a sharp mind without the caffeine jitters. …In the morning, I mix some of this with cold water and chocolate syrup for added flavor. Shake it up, drink it on the way to work, and I'm nice and alert by the time I get there. Definitely recommend.",
            "name": "P. Chu",
            "badge": "Amazon Vine Review"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "group": "FOCUS",
            "photo": "shopify://shop_images/rg-pdp-rev-stanislav.jpg",
            "title": "Great Coffee with Added Creatine",
            "text": "I already take creatine every day for focus and workouts, so having it in my coffee too is very convenient, like two products in one. I also like that this coffee is really made in the USA. Before, I bought products that were actually made somewhere else. It's convenient and I trust it.",
            "name": "Stanislav Kolomiiets",
            "badge": "✓ Verified Buyer"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "group": "FOCUS",
            "photo": "shopify://shop_images/rg-pdp-rev-mswhite.jpg",
            "title": "Pretty good coffee",
